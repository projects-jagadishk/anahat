---
/**
 * index.astro — The Main Deck (Screen 1)
 * 1200×800 — Matches Figma Screen-1-Main-Deck specifications.
 * Fixed columns: Left 300px | Center 600px | Right 300px
 * Static rendering of presets via Astro for instant SSR, no FOUC, and perfect style scoping.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TitleBar from "../components/ui/TitleBar.astro";
import SpriteMetronome from "../components/ui/SpriteMetronome.astro";
import presetsData from "../data/presets.json";

const ERA_DISPLAY_TITLES: Record<string, string> = {
  "Ancient & Vedic": "--- [ VEDIC ] ---",
  "Sacred Solfeggio": "--- [ SOLFEGGIO ] ---",
  "Pythagorean Tuning": "--- [ PYTHAGOREAN ] ---",
  "Modern Clinical": "--- [ CLINICAL ] ---",
  "Classical Physics": "--- [ CLASSICAL PHYSICS ] ---",
};

const ERA_SORT_ORDER = [
  "Ancient & Vedic",
  "Sacred Solfeggio",
  "Pythagorean Tuning",
  "Modern Clinical",
  "Classical Physics",
];

// Group presets by era in strict order
const groupedPresets = ERA_SORT_ORDER.map((era) => ({
  era,
  title: ERA_DISPLAY_TITLES[era] || `--- [ ${era.toUpperCase()} ] ---`,
  items: presetsData.filter((p) => p.era === era),
})).filter((g) => g.items.length > 0);

// Default preset is PRE-001 (Anahata Heart)
const initialPreset = presetsData.find((p) => p.code === "PRE-001") || presetsData[0];
---

<BaseLayout title="ANAHAT // NEUROACOUSTIC DECK">
  <TitleBar />

  <main class="deck" id="main-deck">
    <!-- ═══ LEFT COLUMN: Preset Navigator (300×760) ═══ -->
    <aside class="deck__presets">
      <!-- Dark header bar -->
      <div class="deck__presets-header">
        <span class="deck__presets-title">ANAHAT V1.0 // PRESETS</span>
        <span class="deck__presets-badge">30 TONES</span>
      </div>

      <!-- Preset list: statically rendered so all styles bind directly -->
      <div class="deck__presets-list" id="preset-list">
        {groupedPresets.map((group) => (
          <div class="preset-group">
            <div class="preset-category">{group.title}</div>
            {group.items.map((preset) => {
              const isDefault = preset.code === "PRE-001" || preset.id === initialPreset.id;
              return (
                <button
                  class={`preset-item ${isDefault ? "preset-item--active" : ""}`}
                  data-preset-id={preset.id}
                  data-preset-json={JSON.stringify(preset)}
                  type="button"
                >
                  <div class="preset-item__meta">
                    <span class="preset-item__code">[{preset.code || preset.id.toUpperCase()}]</span>
                    <span class="preset-item__name">{preset.displayName || preset.name}</span>
                    <span class="preset-item__cursor terminal-blink">█</span>
                  </div>
                  <span class="preset-item__hz">{Number(preset.target_hz).toFixed(1)} Hz</span>
                </button>
              );
            })}
          </div>
        ))}
      </div>

      <!-- Chunky REC button at bottom (Screen 1 / Screen 5 trigger) -->
      <div class="deck__presets-footer">
        <button class="btn-brutalist btn-rec" id="btn-rec" type="button">
          [ REC SESSION ]
        </button>
      </div>
    </aside>

    <!-- ═══ CENTER COLUMN (600×760) ═══ -->
    <section class="deck__center">
      <!-- WebGL Canvas (Flexible remaining height, min 240px, never pushes controls) -->
      <div class="deck__canvas-wrap" id="canvas-card">
        <!-- Recording timecode badge (Screen 5 active state) -->
        <div class="deck__rec-badge" id="rec-badge">
          <span class="deck__rec-dot terminal-blink">●</span>
          <span id="rec-timecode">REC 00:00:00:00</span>
        </div>

        <!-- Overlaid Session HUD on the Visualizer (Zero Layout Shifts in Controls) -->
        <div class="deck__canvas-hud" id="canvas-hud">
          <div class="hud-countdown" id="hud-countdown">10:00</div>
          <div class="hud-phase-badge" id="hud-phase-badge">
            <span class="hud-dot terminal-blink">●</span>
            <span id="hud-phase-label">PHASE: INHALE [ 4S ]</span>
          </div>
        </div>

        <!-- Unmissable Sine Burst Notification Banner -->
        <div class="deck__burst-banner" id="burst-banner">
          <span class="burst-banner__icon terminal-blink">⚡</span>
          <span class="burst-banner__text">INTERVAL CHIME // 528 HZ SINE BURST</span>
        </div>

        <!-- 1-Bit Sprite Container Molecule (Docked on Canvas, toggleable) -->
        <div class="deck__sprite-dock" id="sprite-dock">
          <SpriteMetronome id="metronome-cat" />
        </div>

        <!-- Dark toolbar inside canvas -->
        <div class="deck__canvas-bar">
          <div class="deck__canvas-toggles">
            <button class="deck__toggle deck__toggle--active" id="toggle-particles" type="button">
              [X] CHLADNI
            </button>
            <span class="deck__toggle-sep">|</span>
            <button class="deck__toggle" id="toggle-fluid" type="button">
              [ ] FLUID
            </button>
            <span class="deck__toggle-sep">|</span>
            <button class="deck__toggle" id="toggle-oscillo" type="button">
              [ ] OSCILLO
            </button>
            <span class="deck__toggle-sep">|</span>
            <button class="deck__toggle deck__toggle--active" id="toggle-companion" type="button">
              [X] COMPANION
            </button>
          </div>
          <button class="btn-theater" id="btn-theater" type="button">
            [ THEATER ⤢ ]
          </button>
        </div>

        <!-- Canvas render area with coordinate grid background -->
        <div class="deck__canvas" id="webgl-canvas">
          <div class="deck__canvas-grid"></div>
        </div>
      </div>

      <!-- Bottom Control Deck (Fixed height, ALWAYS 100% visible, ZERO layout shifts) -->
      <div class="deck__controls">
        <!-- Hz Display — Extreme Scale Contrast (Rock-solid static display) -->
        <div class="deck__hz-block">
          <span class="deck__hz-value" id="hz-readout">{Number(initialPreset.target_hz).toFixed(1)}</span>
          <div class="deck__hz-meta">
            <span class="deck__hz-label">HZ // MASTER RESONANCE</span>
            <span class="deck__hz-waveform" id="waveform-label">
              WAVEFORM: {(initialPreset.waveform || "sine").toUpperCase()} SINE
            </span>
          </div>
        </div>

        <!-- Harmonic Sliders row -->
        <div class="deck__slider-row">
          <div class="deck__slider-box">
            <label class="deck__slider-label" for="slider-n">
              HARMONIC N: <span id="val-n">{initialPreset.harmonic_n}</span>
            </label>
            <div class="deck__slider-track-wrap">
              <input
                type="range"
                min="1"
                max="10"
                value={initialPreset.harmonic_n}
                class="slider-brutalist"
                id="slider-n"
              />
            </div>
          </div>
          <div class="deck__slider-box">
            <label class="deck__slider-label" for="slider-m">
              HARMONIC M: <span id="val-m">{initialPreset.harmonic_m}</span>
            </label>
            <div class="deck__slider-track-wrap">
              <input
                type="range"
                min="1"
                max="10"
                value={initialPreset.harmonic_m}
                class="slider-brutalist"
                id="slider-m"
              />
            </div>
          </div>
        </div>

        <!-- V1.5 Meditation Controls: Cadence Dropdown & Timebox Selector -->
        <div class="deck__meditation-row">
          <!-- Cadence Dropdown (Atom) -->
          <div class="deck__cadence-box">
            <label class="deck__med-label" for="select-cadence">BREATH_SYNC</label>
            <div class="select-brutalist-wrap">
              <select class="select-brutalist" id="select-cadence">
                <option value="box">BREATH_SYNC // [ BOX ]</option>
                <option value="478">BREATH_SYNC // [ 4-7-8 ]</option>
                <option value="coherent">BREATH_SYNC // [ COHERENT ]</option>
                <option value="off">BREATH_SYNC // [ OFF ]</option>
              </select>
            </div>
          </div>

          <!-- Timebox Selector (Atom) -->
          <div class="deck__timebox-box">
            <span class="deck__med-label">TIMEBOX</span>
            <div class="deck__timebox-toggles" id="timebox-toggles">
              <button class="timebox-btn timebox-btn--active" data-mins="10" type="button">[ 10M ]</button>
              <button class="timebox-btn" data-mins="20" type="button">[ 20M ]</button>
              <button class="timebox-btn" data-mins="60" type="button">[ 60M ]</button>
              <button class="timebox-btn" data-mins="infinity" type="button">[ ∞ ]</button>
            </div>
          </div>

          <!-- Session Takeover Trigger Button -->
          <button class="btn-session" id="btn-session" type="button">
            [ START SESSION ⏵ ]
          </button>
        </div>

        <!-- Noise Blend Interactive Control Deck -->
        <div class="deck__noise-deck">
          <div class="deck__noise-header">
            <span class="deck__noise-label" id="noise-label">
              NOISE BLEND: {(initialPreset.noise_masking_type || "brown").toUpperCase()} // ████████░░░░ {Math.round((initialPreset.noise_blend_ratio || 0.25) * 100)}%
            </span>
            <div class="deck__noise-types" id="noise-types">
              <button class="noise-type-btn noise-type-btn--active" data-noise="brown" type="button">BROWN</button>
              <button class="noise-type-btn" data-noise="pink" type="button">PINK</button>
              <button class="noise-type-btn" data-noise="white" type="button">WHITE</button>
              <button class="noise-type-btn" data-noise="none" type="button">MUTE</button>
            </div>
          </div>
          <div class="deck__slider-track-wrap">
            <input
              type="range"
              min="0"
              max="100"
              value={Math.round((initialPreset.noise_blend_ratio || 0.25) * 100)}
              class="slider-brutalist slider-brutalist--noise"
              id="slider-noise"
              title="Noise Blend Ratio"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ RIGHT COLUMN: Provenance Spec Card (300×760) ═══ -->
    <aside class="deck__provenance">
      <div class="deck__prov-card">
        <!-- Dark header -->
        <div class="deck__prov-header">
          <span class="deck__prov-title">PROVENANCE // <span id="spec-header-id">{initialPreset.code || "PRE-001"}</span></span>
        </div>

        <!-- Spec rows — alternating bg matching Figma spec card -->
        <div class="deck__prov-specs" id="spec-rows">
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">PRESET_ID</span>
            <span class="deck__spec-val" id="spec-id">{initialPreset.code || "PRE-001"}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--odd">
            <span class="deck__spec-key">NAME</span>
            <span class="deck__spec-val" id="spec-name">{initialPreset.displayName || initialPreset.name}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">CULTURE</span>
            <span class="deck__spec-val" id="spec-era">{initialPreset.era}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--odd">
            <span class="deck__spec-key">TARGET_HZ</span>
            <span class="deck__spec-val deck__spec-val--hz" id="spec-target">{Number(initialPreset.target_hz).toFixed(2)} Hz</span>
          </div>
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">CHLADNI</span>
            <span class="deck__spec-val" id="spec-chladni">n={initialPreset.harmonic_n}, m={initialPreset.harmonic_m}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--odd">
            <span class="deck__spec-key">EVIDENCE</span>
            <span class="deck__spec-val" id="spec-evidence">{initialPreset.evidence_level}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">RATING</span>
            <span class="deck__spec-val" id="spec-rating">[ ★★★★★ ]</span>
          </div>
        </div>

        <!-- Research Abstract block -->
        <div class="deck__prov-abstract" id="spec-abstract">
          <span class="deck__abstract-heading">RESEARCH ABSTRACT:</span>
          <p class="deck__abstract-body" id="spec-abstract-body">
            {initialPreset.therapeutic_use_case}
            <br/><br/>
            {initialPreset.neurological_target}
          </p>
          <p class="deck__abstract-citation" id="spec-citation">
            CITATION: {initialPreset.citation}
          </p>
        </div>

        <!-- Biometric Sync V2 button -->
        <button class="btn-biometric" id="btn-biometric" type="button">
          [ BIOMETRIC SYNC // V2 ]
        </button>
      </div>
    </aside>
  </main>

  <!-- ═══════════════════════════════════════════════════════════
       SCREEN 2: THEATER MODE OVERLAY (1920x1080 CHROMELESS)
       ═══════════════════════════════════════════════════════════ -->
  <div class="theater-overlay" id="theater-overlay">
    <button class="btn-theater-exit" id="btn-theater-exit" title="Exit Theater Mode">
      ✕
    </button>
    <!-- Theater Visualizer Mode Switcher -->
    <div class="theater-toolbar">
      <button class="theater-mode-btn theater-mode-btn--active" data-mode="particles" id="theater-mode-particles">[ CHLADNI ]</button>
      <button class="theater-mode-btn" data-mode="fluid" id="theater-mode-fluid">[ FLUID ]</button>
      <button class="theater-mode-btn" data-mode="oscillo" id="theater-mode-oscillo">[ OSCILLO ]</button>
    </div>
    <div class="theater-canvas-container" id="theater-canvas"></div>
    <div class="theater-hud">
      <span class="theater-hud__label">ANAHAT // THEATER PROJECTION</span>
      <span class="theater-hud__code" id="theater-code">{initialPreset.code || "PRE-001"}</span>
      <span class="theater-hud__hz" id="theater-hz">{Number(initialPreset.target_hz).toFixed(1)} HZ</span>
      <span class="theater-hud__phase" id="theater-phase">CADENCE: IDLE</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       SCREEN 4: AUDIO ROUTING MATRIX MODAL (800x600 OVERLAY)
       ═══════════════════════════════════════════════════════════ -->
  <div class="modal-backdrop" id="modal-routing">
    <div class="modal-box modal-box--routing">
      <div class="modal-header">
        <span>AUDIO ROUTING MATRIX // HARDWARE I/O</span>
        <button class="modal-close-btn" id="btn-close-routing">✕</button>
      </div>
      <div class="modal-body modal-grid-2">
        <div class="modal-col">
          <span class="modal-subheading">PHYSICAL AUDIO OUTPUT:</span>
          <div class="brutalist-select-box">
            <div class="brutalist-select-item brutalist-select-item--active">[X] DEFAULT SYSTEM OUTPUT (DAC)</div>
            <div class="brutalist-select-item">[ ] HEADPHONES (EXTERNAL OUT)</div>
            <div class="brutalist-select-item">[ ] MULTI-CHANNEL SPATIAL RIG</div>
          </div>

          <span class="modal-subheading" style="margin-top: 20px;">SYNTHESIS BUFFER:</span>
          <div class="modal-spec-text">
            SAMPLE RATE: 48,000 HZ<br/>
            DSP LATENCY: 2.3 MS<br/>
            CHANNELS: 2 (BINAURAL ISOLATION)
          </div>
        </div>

        <div class="modal-col">
          <span class="modal-subheading">BACKGROUND BEHAVIOR:</span>
          <div class="brutalist-check-list">
            <label class="brutalist-checkbox">
              <input type="checkbox" checked /> [X] KEEP AUDIO RUNNING IN SYSTEM TRAY
            </label>
            <label class="brutalist-checkbox">
              <input type="checkbox" checked /> [X] PAUSE WEBGL WHEN MINIMIZED
            </label>
            <label class="brutalist-checkbox">
              <input type="checkbox" /> [ ] LAUNCH AT SYSTEM STARTUP
            </label>
          </div>

          <span class="modal-subheading" style="margin-top: 20px;">HARDWARE ACCELERATION:</span>
          <div class="modal-spec-text">
            WEBGL 2.0: ACTIVE (METAL / VULKAN)<br/>
            COMPUTE SHADER: GPGPU ENABLED
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-brutalist btn-brutalist--sm" id="btn-apply-routing">
          [ APPLY ROUTING CONFIG ]
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       SCREEN 6: BIOMETRIC SYNC MODAL (500x400 BLE OVERLAY)
       ═══════════════════════════════════════════════════════════ -->
  <div class="modal-backdrop" id="modal-biometric">
    <div class="modal-box modal-box--bio">
      <div class="modal-header">
        <span>BIOMETRIC SYNC // BLE V2.0</span>
        <button class="modal-close-btn" id="btn-close-bio">✕</button>
      </div>
      <div class="modal-body modal-bio-body">
        <div class="bio-status-badge terminal-blink">
          SCANNING FOR BLE WEARABLES...
        </div>
        <div class="bio-oscilloscope">
          <svg viewBox="0 0 460 120" class="bio-wave-svg">
            <path d="M 0 60 Q 57.5 10 115 60 T 230 60 T 345 60 T 460 60" fill="none" stroke="#FF3333" stroke-width="3" />
          </svg>
        </div>
        <div class="bio-info-box">
          AWAITING HRV / EEG SENSOR TELEMETRY<br/>
          SUPPORTS: OURARING, APPLE WATCH, MUSE EEG<br/>
          STATUS: STANDBY (ROADMAP PHASE 4)
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-brutalist btn-brutalist--sm" id="btn-done-bio">
          [ CLOSE SCANNER ]
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       SYSTEM INFO & CLINICAL DISCLAIMERS MODAL
       ═══════════════════════════════════════════════════════════ -->
  <div class="modal-backdrop" id="modal-info">
    <div class="modal-box modal-box--info">
      <div class="modal-header">
        <span>SYSTEM SPECIFICATION // ARCHITECTURE, CAPABILITIES & CLINICAL PROTOCOL</span>
        <button class="modal-close-btn" id="btn-close-info" title="Close Modal">✕</button>
      </div>
      <div class="modal-body modal-body--info">
        <!-- Section 1: Purpose & Philosophy -->
        <section class="info-section">
          <div class="info-section__title">01 // ARCHITECTURAL PURPOSE & DESIGN RATIONALE</div>
          <p class="info-p">
            <strong>ANAHAT</strong> (अनाहत — <em>"unstruck sound"</em>) is an offline-first neuroacoustic workstation and cymatic resonance visualizer engineered for brainwave entrainment, meditative absorption, sustained cognitive focus, and psychoacoustic exploration.
          </p>
          <p class="info-p">
            Operating strictly on a 48,000 Hz 32-bit float digital signal processing pipeline, Anahat synthesizes uncompromised continuous carrier waves, binaural phase differentials, harmonic overtone spectra, and calibrated stochastic noise without dynamic range compression or mp3/aac lossy artifacts.
          </p>
        </section>

        <!-- Section 2: Core Subsystems Grid -->
        <section class="info-section">
          <div class="info-section__title">02 // CORE SUBSYSTEMS & CAPABILITIES</div>
          <div class="info-grid">
            <div class="info-card">
              <div class="info-card__title">[ DUAL-CHANNEL DSP ENGINE ]</div>
              <div class="info-card__desc">
                Native Rust stereo oscillators with independent L/R phase tracking targeting Delta (0.5–4 Hz), Theta (4–8 Hz), Alpha (8–13 Hz), Beta (13–30 Hz), and Gamma (30–100 Hz) cognitive states.
              </div>
            </div>

            <div class="info-card">
              <div class="info-card__title">[ CHLADNI NODAL DYNAMICS ]</div>
              <div class="info-card__desc">
                12,000 WebGL particles governed by Ernst Chladni's wave equation with viscous fluid damping (0.94) and organic harmonic curl, eliminating erratic motion while simulating resonant plate physics.
              </div>
            </div>

            <div class="info-card">
              <div class="info-card__title">[ FARADAY FLUID HYDRODYNAMICS ]</div>
              <div class="info-card__desc">
                Continuous 3D parametric standing wave wireframe simulation across a 96×96 surface grid responding in real-time to instantaneous audio amplitude and harmonic modes.
              </div>
            </div>

            <div class="info-card">
              <div class="info-card__title">[ WINAMP 3D OSCILLOSCOPE ]</div>
              <div class="info-card__desc">
                4-trace multi-ribbon time-domain PCM waveform visualizer with harmonic offsets, sub-bass envelope ribbons, and a 3D rotating Lissajous orbit loop in pastel spectrum gradients.
              </div>
            </div>

            <div class="info-card">
              <div class="info-card__title">[ BREATH SYNC & INTERVAL CHIMES ]</div>
              <div class="info-card__desc">
                Temporal breath cadences (Box 4:4:4:4, 4-7-8, Coherent, Flow State) driving particle expansion/contraction in lockstep with dual-harmonic 528 Hz pure sine bell bursts.
              </div>
            </div>

            <div class="info-card">
              <div class="info-card__title">[ 1-BIT METRONOMIC COMPANION ]</div>
              <div class="info-card__desc">
                Lightweight 60 FPS pixel-art metronome (<code>TABBY_01</code>) providing intuitive cadence rhythm with zero layout shifts and complete visibility control.
              </div>
            </div>

            <div class="info-card">
              <div class="info-card__title">[ SCREEN 2 THEATER PROJECTION ]</div>
              <div class="info-card__desc">
                Chromeless 1920×1080 pure black visual projection mode with live HUD telemetry for external displays, projectors, and ambient installations.
              </div>
            </div>

            <div class="info-card">
              <div class="info-card__title">[ LOSSLESS WAV SESSION EXPORT ]</div>
              <div class="info-card__desc">
                Direct-to-disk uncompressed 16-bit 48 kHz stereo WAV recording via native OS file dialogs without reliance on cloud rendering or external codecs.
              </div>
            </div>
          </div>
        </section>

        <!-- Section 3: Clinical & Safety Disclaimers -->
        <section class="info-section">
          <div class="info-section__title">03 // CLINICAL PROTOCOL & SAFETY DISCLAIMERS</div>
          <div class="info-disclaimer-box">
            <div class="info-disclaimer-box__header">
              <span class="terminal-blink">▲</span> WARNING: MANDATORY SAFETY & REGULATORY ADVISORY
            </div>

            <div class="info-disclaimer-item">
              <strong>1. NOT A MEDICAL DEVICE / NOT MEDICAL TREATMENT:</strong>
              Anahat is an acoustic experimentation platform and relaxation utility. It is <strong>NOT</strong> a medical device, is <strong>NOT</strong> approved or cleared by the US Food and Drug Administration (FDA), European Medicines Agency (EMA), or CE medical directives, and is <strong>NOT</strong> intended to diagnose, treat, mitigate, cure, or prevent any neurological, psychological, psychiatric, or physiological condition (including but not limited to clinical insomnia, clinical depression, epilepsy, ADHD, PTSD, or anxiety disorders). Never substitute neuroacoustic sessions for licensed psychiatric, medical, or pharmacological treatment.
            </div>

            <div class="info-disclaimer-item">
              <strong>2. PHOTOSENSITIVE EPILEPSY & SEIZURE ADVISORY:</strong>
              The real-time visualizers (Chladni particle collapses, Faraday wave interference, and sine wave shockwave bursts) produce rhythmic visual patterns and high-contrast oscillations. If you or anyone in your immediate family has an epileptic condition, photosensitivity, or has ever experienced seizures, tremors, optical migraine auras, or loss of consciousness when exposed to flashing or rhythmic light patterns, <strong>DO NOT USE THE VISUALIZERS</strong>. Immediately close the visualizer or run Anahat strictly in audio-only mode.
            </div>

            <div class="info-disclaimer-item">
              <strong>3. AUDITORY HEALTH & DECIBEL SAFETY PROTOCOL:</strong>
              Binaural beat entrainment functions solely via stereo separation and does <strong>NOT</strong> require high volume to be neuro-biologically effective. <strong>Always initialize playback at a low volume before placing headphones over your ears.</strong> Listening at sustained sound pressure levels above 85 dB(A) can cause permanent noise-induced hearing loss (NIHL) and chronic tinnitus.
            </div>

            <div class="info-disclaimer-item">
              <strong>4. MOTOR VEHICLE & HEAVY MACHINERY RESTRICTION:</strong>
