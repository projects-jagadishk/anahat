        modalRoute?.classList.remove("modal-backdrop--active");
      });
    });

    // Biometric Sync
    const btnBio = document.getElementById("btn-biometric");
    const modalBio = document.getElementById("modal-biometric");
    const btnCloseBio = document.getElementById("btn-close-bio");
    const btnDoneBio = document.getElementById("btn-done-bio");

    btnBio?.addEventListener("click", () => {
      modalBio?.classList.add("modal-backdrop--active");
    });

    [btnCloseBio, btnDoneBio].forEach((el) => {
      el?.addEventListener("click", () => {
        modalBio?.classList.remove("modal-backdrop--active");
      });
    });

