#!/bin/sh
# Prevent direct commits to protected branches (main and develop)

current_branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

if [ "$current_branch" = "main" ] || [ "$current_branch" = "develop" ]; then
  echo "\033[1;31m❌ [GIT HOOK ERROR] Direct commits to '$current_branch' are strictly prohibited.\033[0m"
  echo "Remote rulesets protect 'main' and 'develop'. Please switch to a branch:"
  echo "  - Feature branch: git checkout -b feature/<name>  (PR targeting develop)"
  echo "  - Hotfix branch:  git checkout -b hotfix/<name>   (PR targeting main)"
  exit 1
fi

exit 0
