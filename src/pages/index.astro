    font-size: 10px;
    font-weight: 500;
    line-height: 1.4;
    padding: 6px 10px;
    max-width: 280px;
    white-space: normal !important;
    word-break: break-word;
    letter-spacing: 0.02em;
    transition: opacity 0.15s ease;
  }

  .brutalist-tooltip--visible {
    opacity: 1;
    visibility: visible;
  }

  /* ── Drag & Drop Profile Import Overlay ── */
  .drag-drop-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(8, 9, 12, 0.94);
