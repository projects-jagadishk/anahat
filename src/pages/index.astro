  }

  .canvas-bar__row-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .canvas-bar__spacer {
    flex: 1;
  }

  /* ── Brutalist Tooltip (3-second hover delay) ── */
  .brutalist-tooltip {
    position: fixed;
    z-index: 999999;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    background: #0D0E12;
    color: #E2E4E8;
    border: 1px solid #3F4452;
    border-left: 3px solid var(--color-accent-industrial);
