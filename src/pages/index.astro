  // ═══════════════════════════════════════════════════════════
  // V1.5 MEDITATION: TIMEBOX, CADENCE & SCREEN 7 TAKEOVER
  // ═══════════════════════════════════════════════════════════

  function formatCountdown(sec: number): string {
    if (sec === Infinity) return "∞ // FLOW";
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
  }

  function wireMeditationSession() {
    const mainDeck = document.getElementById("main-deck");
    const btnSession = document.getElementById("btn-session");
    const selectCadence = document.getElementById("select-cadence") as HTMLSelectElement;
    const timeboxButtons = document.querySelectorAll<HTMLButtonElement>(".timebox-btn");
    const hudCountdown = document.getElementById("hud-countdown");
    const hudPhaseLabel = document.getElementById("hud-phase-label");
    const canvasCard = document.getElementById("canvas-card");

    // Init GSAP Sprite Metronome (Canvas-driven, guaranteed 60FPS animation)
    spriteMetronome.init("sprite-cadence-label", "tabby-canvas");

    function triggerSineWaveBurst() {
      // Trigger mathematical expanding sine wave ripple across particles, fluid, and oscilloscope
      visualizer?.triggerSineBurst();
      theaterVisualizer?.triggerSineBurst();

      // Unmissable top banner [ ⚡ INTERVAL CHIME // 528 HZ SINE BURST ]
      const banner = document.getElementById("burst-banner");
      if (banner) {
        banner.classList.add("deck__burst-banner--active");
        setTimeout(() => {
          banner.classList.remove("deck__burst-banner--active");
        }, 1400);
      }

      // Subtle brutalist border pulse (replaces flat solid red background flash)
      canvasCard?.classList.add("deck__canvas-wrap--pulse");
      setTimeout(() => {
        canvasCard?.classList.remove("deck__canvas-wrap--pulse");
      }, 350);
    }

    // Connect Breath Phase callback to Visualizer & Interval Chimes
    spriteMetronome.setPhaseCallback((phase, durationSec) => {
      visualizer?.setBreathPhase(phase, durationSec);
      theaterVisualizer?.setBreathPhase(phase, durationSec);

      if (hudPhaseLabel) {
        hudPhaseLabel.textContent = `PHASE: ${phase.toUpperCase()} [ ${durationSec}S ]`;
      }
      const theaterPhase = document.getElementById("theater-phase");
      if (theaterPhase) {
        theaterPhase.textContent = `CADENCE: ${phase.toUpperCase()} [ ${durationSec}S ]`;
      }

      // Interval Chime & Sine Wave Burst on breath phase shift
      if (isSessionActive) {
        audioEngine.playIntervalChime(phase === "inhale" ? 528 : 432);
        triggerSineWaveBurst();
      }
    });

    // Audio Engine chime listener
    audioEngine.onChime(() => {
      triggerSineWaveBurst();
    });

    // Cadence Select dropdown
    selectCadence?.addEventListener("change", () => {
      activeCadence = selectCadence.value as CadenceType;
      spriteMetronome.applyCadence(activeCadence);
    });

    // Timebox Toggles
    timeboxButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        timeboxButtons.forEach((b) => b.classList.remove("timebox-btn--active"));
        btn.classList.add("timebox-btn--active");

        const mins = btn.dataset.mins;
        if (mins === "infinity") {
          sessionMinutes = Infinity;
          sessionSecondsRemaining = Infinity;
        } else {
          sessionMinutes = parseInt(mins || "10", 10);
          sessionSecondsRemaining = sessionMinutes * 60;
        }

        if (hudCountdown) {
          hudCountdown.textContent = formatCountdown(sessionSecondsRemaining);
        }
      });
    });

    function endSession() {
      isSessionActive = false;
      mainDeck?.classList.remove("deck--screen7");
      if (btnSession) {
        btnSession.textContent = "[ START SESSION ⏵ ]";
        btnSession.classList.remove("btn-session--active");
      }
      if (sessionInterval) {
        clearInterval(sessionInterval);
        sessionInterval = null;
      }
      visualizer?.setBreathPhase("idle");
      theaterVisualizer?.setBreathPhase("idle");
      const theaterPhase = document.getElementById("theater-phase");
      if (theaterPhase) {
        theaterPhase.textContent = "CADENCE: IDLE";
      }

      setTimeout(() => {
        (visualizer as any)?.handleResize?.();
      }, 50);
    }

    // Session Start / End Button (Screen 7 Takeover)
    btnSession?.addEventListener("click", () => {
      isSessionActive = !isSessionActive;

      if (isSessionActive) {
        // Activate Screen 7
        mainDeck?.classList.add("deck--screen7");
        btnSession.textContent = "[ END SESSION ⏹ ]";
        btnSession.classList.add("btn-session--active");

        // Set initial countdown
        if (sessionMinutes === Infinity) {
          sessionSecondsRemaining = Infinity;
        } else {
          sessionSecondsRemaining = sessionMinutes * 60;
        }
        if (hudCountdown) {
          hudCountdown.textContent = formatCountdown(sessionSecondsRemaining);
        }

        // Trigger rich sine chime & wave burst on start
        audioEngine.playIntervalChime(528);
        triggerSineWaveBurst();

        // Start countdown timer
        sessionInterval = setInterval(() => {
          if (sessionSecondsRemaining !== Infinity) {
            sessionSecondsRemaining--;
            if (hudCountdown) {
              hudCountdown.textContent = formatCountdown(sessionSecondsRemaining);
            }

            if (sessionSecondsRemaining <= 0) {
              clearInterval(sessionInterval);
              sessionInterval = null;
              audioEngine.playIntervalChime(528);
              triggerSineWaveBurst();
              endSession();
            }
          }
        }, 1000);

        // Force visualizer to adapt to expanded canvas
        setTimeout(() => {
          (visualizer as any)?.handleResize?.();
        }, 50);
      } else {
        endSession();
      }
    });
  }

  // ═══════════════════════════════════════════════════════════
  // ACOUSTIC INGEST (MIC INGEST / INTERNAL DSP SWITCHER)
  // ═══════════════════════════════════════════════════════════

  function wireInputSource() {
    const btnInputSource = document.getElementById("btn-input-source");
    const titlebarSourceLabel = document.getElementById("titlebar-source-label");
    const btnCanvasSource = document.getElementById("btn-canvas-source");
    const canvasSourceLabel = document.getElementById("canvas-source-label");
    const canvasSourceDot = document.getElementById("canvas-source-dot");
    const deckMicMeter = document.getElementById("deck-mic-meter");
    const micMeterBar = document.getElementById("mic-meter-bar");
    const btnGainStep = document.getElementById("btn-gain-step");
    const theaterSource = document.getElementById("theater-source");

    const routingSrcDsp = document.getElementById("routing-src-dsp");
    const routingSrcMic = document.getElementById("routing-src-mic");

    const gainSteps = [0.5, 1.0, 1.4, 2.0, 3.0];
    let currentGainIdx = 2; // Default 1.4X

    const syncSourceUI = (mode: AudioSourceMode) => {
      const isMic = mode === "mic_ingest";

      // Titlebar Button
      if (titlebarSourceLabel) {
        titlebarSourceLabel.textContent = isMic ? "SRC: [ MIC ]" : "SRC: [ DSP ]";
      }
      btnInputSource?.classList.toggle("titlebar__route-btn--active", isMic);

      // Canvas Toolbar Pill
      if (canvasSourceLabel) {
        canvasSourceLabel.textContent = isMic ? "SRC: MIC" : "SRC: DSP";
      }
      btnCanvasSource?.classList.toggle("deck__toggle--active", isMic);
      if (canvasSourceDot) {
        canvasSourceDot.classList.toggle("source-dot--mic", isMic);
        canvasSourceDot.classList.toggle("terminal-blink", isMic);
      }

      // Mic meter visibility
      if (deckMicMeter) {
        deckMicMeter.style.display = isMic ? "flex" : "none";
      }

      // Theater HUD indicator
      if (theaterSource) {
        theaterSource.textContent = isMic ? "SRC: MIC INGEST [LIVE]" : "SRC: INTERNAL DSP";
        theaterSource.style.color = isMic ? "var(--color-accent-industrial)" : "#AAA";
      }

      // Routing Modal
      if (routingSrcDsp && routingSrcMic) {
        if (isMic) {
          routingSrcDsp.textContent = "[ ] INTERNAL ALGORITHMIC DSP";
          routingSrcDsp.classList.remove("brutalist-select-item--active");
          routingSrcMic.textContent = "[X] LIVE MICROPHONE / SYSTEM INGEST";
          routingSrcMic.classList.add("brutalist-select-item--active");
        } else {
          routingSrcDsp.textContent = "[X] INTERNAL ALGORITHMIC DSP";
          routingSrcDsp.classList.add("brutalist-select-item--active");
          routingSrcMic.textContent = "[ ] LIVE MICROPHONE / SYSTEM INGEST";
          routingSrcMic.classList.remove("brutalist-select-item--active");
        }
      }
    };

    // Toggle trigger
    const handleToggle = async () => {
      const newMode = await audioEngine.toggleInputSource();
      syncSourceUI(newMode);
    };

    btnInputSource?.addEventListener("click", handleToggle);
    btnCanvasSource?.addEventListener("click", handleToggle);

    routingSrcDsp?.addEventListener("click", () => {
      if (audioEngine.getSourceMode() !== "internal_dsp") {
        audioEngine.disableMicIngest();
        syncSourceUI("internal_dsp");
      }
    });

    routingSrcMic?.addEventListener("click", async () => {
      if (audioEngine.getSourceMode() !== "mic_ingest") {
        const ok = await audioEngine.enableMicIngest();
        syncSourceUI(ok ? "mic_ingest" : "internal_dsp");
      }
    });

    // Sensitivity gain stepper
    btnGainStep?.addEventListener("click", () => {
      currentGainIdx = (currentGainIdx + 1) % gainSteps.length;
      const g = gainSteps[currentGainIdx];
      audioEngine.setMicSensitivity(g);
      if (btnGainStep) btnGainStep.textContent = `${g.toFixed(1)}X`;
    });

    // Audio Engine state listener
    audioEngine.onSourceModeChange(syncSourceUI);

    // Initial state sync
    syncSourceUI(audioEngine.getSourceMode());

    // 60FPS Input Level Meter RAF Loop
    const updateMeter = () => {
      if (audioEngine.getSourceMode() === "mic_ingest" && micMeterBar) {
        const rms = audioEngine.getRMSLevel();
        const segments = 10;
        const filled = Math.min(segments, Math.max(0, Math.round(rms * 16)));
        micMeterBar.textContent = `[${"█".repeat(filled)}${"░".repeat(segments - filled)}]`;
      }
      requestAnimationFrame(updateMeter);
    };
    requestAnimationFrame(updateMeter);
  }

  // ═══════════════════════════════════════════════════════════
  // HARDWARE OUTPUT ROUTING (DAC / Device Switcher)
  // ═══════════════════════════════════════════════════════════

  function wireAudioRouting() {
    const routingContainer = document.getElementById("routing-output-devices");
    const routingStatus = document.getElementById("routing-output-status");
    const titlebarRouteLabel = document.getElementById("titlebar-route-label");
    const btnRoute = document.getElementById("btn-route-audio");

    let isRefreshing = false;

    const refreshOutputDevices = async () => {
      if (!routingContainer || isRefreshing) return;
      isRefreshing = true;

      try {
        const devices = await audioEngine.listOutputDevices();
        const currentActive = audioEngine.getActiveOutputDevice();

        routingContainer.innerHTML = "";
        devices.forEach((dev) => {
          const item = document.createElement("div");
          const isActive = dev.name === currentActive || (currentActive === "Default System Output" && dev.is_default);
          item.className = `brutalist-select-item ${isActive ? "brutalist-select-item--active" : ""}`;
          item.textContent = `[${isActive ? "X" : " "}] ${dev.name.toUpperCase()}`;
          item.dataset.deviceName = dev.name;

          item.addEventListener("click", async () => {
            if (routingStatus) {
              routingStatus.textContent = `SWITCHING TO: ${dev.name.toUpperCase()}...`;
            }
            // Update selection immediately in UI
            routingContainer.querySelectorAll(".brutalist-select-item").forEach((el) => {
              el.classList.remove("brutalist-select-item--active");
              const text = el.textContent || "";
              el.textContent = text.replace("[X]", "[ ]");
            });
            item.classList.add("brutalist-select-item--active");
            item.textContent = `[X] ${dev.name.toUpperCase()}`;

            await audioEngine.setOutputDevice(dev.name);
            await refreshOutputDevices();
          });

          routingContainer.appendChild(item);
        });

        if (routingStatus) {
          routingStatus.textContent = `ACTIVE SINK: ${currentActive.toUpperCase()}`;
        }

        if (titlebarRouteLabel) {
          const shortName = currentActive.length > 15 ? currentActive.substring(0, 13) + ".." : currentActive;
          titlebarRouteLabel.textContent = `OUT: [ ${shortName.toUpperCase()} ]`;
        }
      } catch (err) {
        console.warn("[wireAudioRouting] Failed to refresh audio output devices:", err);
      } finally {
        isRefreshing = false;
      }
    };

    btnRoute?.addEventListener("click", () => {
      refreshOutputDevices();
    });

    audioEngine.onOutputDeviceChange((devName) => {
      if (routingStatus) {
        routingStatus.textContent = `ACTIVE SINK: ${devName.toUpperCase()}`;
      }
      if (titlebarRouteLabel) {
        const shortName = devName.length > 15 ? devName.substring(0, 13) + ".." : devName;
        titlebarRouteLabel.textContent = `OUT: [ ${shortName.toUpperCase()} ]`;
      }
    });

    // Populate initial device list
    refreshOutputDevices();
  }

  // ═══════════════════════════════════════════════════════════
  // USER PRESETS & .ANAHAT PROFILE SYSTEM (Option 3)
  // ═══════════════════════════════════════════════════════════

  const STORAGE_KEY = "anahat_user_presets";
  let userPresets: any[] = [];

  function loadUserPresets(): any[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) return JSON.parse(raw);
    } catch (e) {
      console.warn("[UserPresets] Failed to load presets:", e);
    }
    return [];
  }

  function saveUserPresets(presets: any[]): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(presets));
    } catch (e) {
      console.error("[UserPresets] Failed to save presets:", e);
    }
  }

  function exportPresetAsAnahat(preset: any): void {
    if (!preset) return;
    const payload = {
      anahat_signature: "ANAHAT_NEUROACOUSTIC_PROFILE_V1",
      exported_at: new Date().toISOString(),
      preset: preset,
    };
    const jsonStr = JSON.stringify(payload, null, 2);
    const blob = new Blob([jsonStr], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    const codeSlug = (preset.code || "PRESET").toLowerCase().replace(/[^a-z0-9]/g, "_");
    const nameSlug = (preset.displayName || preset.name || "custom").toLowerCase().replace(/[^a-z0-9]/g, "_");
    a.href = url;
    a.download = `${codeSlug}_${nameSlug}.anahat`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function renderUserPresets(): void {
    const groupEl = document.getElementById("user-presets-group");
    const container = document.getElementById("user-presets-container");
    if (!groupEl || !container) return;

    if (userPresets.length === 0) {
      groupEl.style.display = "none";
      container.innerHTML = "";
      return;
    }

    groupEl.style.display = "flex";
    container.innerHTML = "";

    userPresets.forEach((preset, index) => {
      const btn = document.createElement("button");
      const isCurrentActive = currentPreset && (currentPreset.id === preset.id || currentPreset.code === preset.code);
      btn.className = `preset-item ${isCurrentActive ? "preset-item--active" : ""}`;
      btn.type = "button";
      btn.dataset.presetId = preset.id;
      btn.dataset.presetJson = JSON.stringify(preset);

      btn.innerHTML = `
        <div class="preset-item__meta">
          <span class="preset-item__code">[${preset.code || `USR-${index + 1}`}]</span>
          <span class="preset-item__name">${preset.displayName || preset.name}</span>
          <span class="preset-item__cursor terminal-blink">█</span>
        </div>
        <span class="preset-item__hz">${Number(preset.target_hz).toFixed(1)} Hz</span>
        <div class="user-preset-actions" onclick="event.stopPropagation();">
          <button class="user-preset-btn" title="Export .anahat profile" type="button" data-idx="${index}">EXP</button>
          <button class="user-preset-btn" title="Delete preset" type="button" data-del-idx="${index}">✕</button>
        </div>
      `;

      btn.addEventListener("click", () => {
        selectPreset(preset, btn);
      });

      const expBtn = btn.querySelector("[data-idx]");
      expBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        exportPresetAsAnahat(preset);
      });

      const delBtn = btn.querySelector("[data-del-idx]");
      delBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (confirm(`Delete custom preset "${preset.displayName || preset.name}"?`)) {
          userPresets.splice(index, 1);
          saveUserPresets(userPresets);
          renderUserPresets();
        }
      });

      container.appendChild(btn);
    });
  }

  function openNewPresetModal(prefill?: any): void {
    const modal = document.getElementById("modal-new-preset");
    if (!modal) return;

    const inpCode = document.getElementById("inp-preset-code") as HTMLInputElement;
    const inpName = document.getElementById("inp-preset-name") as HTMLInputElement;
    const inpTarget = document.getElementById("inp-preset-target") as HTMLInputElement;
    const inpCarrier = document.getElementById("inp-preset-carrier") as HTMLInputElement;
    const inpOffset = document.getElementById("inp-preset-offset") as HTMLInputElement;
    const inpWf = document.getElementById("inp-preset-waveform") as HTMLSelectElement;
    const inpN = document.getElementById("inp-preset-n") as HTMLInputElement;
    const inpM = document.getElementById("inp-preset-m") as HTMLInputElement;
    const inpNoise = document.getElementById("inp-preset-noise") as HTMLSelectElement;
    const inpNoiseRatio = document.getElementById("inp-preset-noise-ratio") as HTMLInputElement;
    const inpAbstract = document.getElementById("inp-preset-abstract") as HTMLTextAreaElement;

    const nextCode = `USR-${String(userPresets.length + 1).padStart(3, "0")}`;
    if (inpCode) inpCode.value = prefill?.code || nextCode;
    if (inpName) inpName.value = prefill?.displayName || prefill?.name || "";
    if (inpTarget) inpTarget.value = String(prefill?.target_hz ?? 10.0);
    if (inpCarrier) inpCarrier.value = String(prefill?.carrier_hz ?? 216.0);
    if (inpOffset) inpOffset.value = String(prefill?.offset_hz ?? 10.0);
    if (inpWf) inpWf.value = prefill?.waveform || "binaural";
    if (inpN) inpN.value = String(prefill?.harmonic_n ?? 3);
    if (inpM) inpM.value = String(prefill?.harmonic_m ?? 4);
    if (inpNoise) inpNoise.value = prefill?.noise_masking_type || "brown";
    if (inpNoiseRatio) inpNoiseRatio.value = String(Math.round((prefill?.noise_blend_ratio ?? 0.25) * 100));
    if (inpAbstract) inpAbstract.value = prefill?.therapeutic_use_case || "";

    modal.classList.add("modal-backdrop--active");
  }

  function closeNewPresetModal(): void {
    document.getElementById("modal-new-preset")?.classList.remove("modal-backdrop--active");
  }

  function buildPresetFromInputs(): any {
    const inpCode = (document.getElementById("inp-preset-code") as HTMLInputElement)?.value.trim() || `USR-${userPresets.length + 1}`;
    const inpName = (document.getElementById("inp-preset-name") as HTMLInputElement)?.value.trim() || "Untitled Custom Protocol";
    const targetHz = parseFloat((document.getElementById("inp-preset-target") as HTMLInputElement)?.value || "10.0");
    const carrierHz = parseFloat((document.getElementById("inp-preset-carrier") as HTMLInputElement)?.value || "216.0");
    const offsetHz = parseFloat((document.getElementById("inp-preset-offset") as HTMLInputElement)?.value || "10.0");
    const waveform = (document.getElementById("inp-preset-waveform") as HTMLSelectElement)?.value || "binaural";
    const n = parseInt((document.getElementById("inp-preset-n") as HTMLInputElement)?.value || "3", 10);
    const m = parseInt((document.getElementById("inp-preset-m") as HTMLInputElement)?.value || "4", 10);
    const noise = (document.getElementById("inp-preset-noise") as HTMLSelectElement)?.value || "brown";
    const noiseRatio = parseInt((document.getElementById("inp-preset-noise-ratio") as HTMLInputElement)?.value || "25", 10) / 100.0;
    const abstract = (document.getElementById("inp-preset-abstract") as HTMLTextAreaElement)?.value.trim() || "User authored neuroacoustic protocol.";

    return {
      id: `usr-${Date.now()}`,
      code: inpCode,
      name: inpName,
      displayName: inpName,
      era: "User Custom",
      target_hz: targetHz,
      carrier_hz: carrierHz,
      offset_hz: offsetHz,
      harmonic_n: n,
      harmonic_m: m,
      waveform: waveform,
      noise_masking_type: noise,
      noise_blend_ratio: noiseRatio,
      neurological_target: `Acoustic frequency modulation: ${targetHz.toFixed(1)} Hz beat`,
      therapeutic_use_case: abstract,
      evidence_level: "Custom Clinical Protocol",
      evidence_rating: 5,
      citation: "User Authored Protocol // Anahat V1.0",
      doi: `LOCAL/${inpCode}`,
    };
  }

  function wirePresetCreator(): void {
    userPresets = loadUserPresets();
    renderUserPresets();

    const btnNew = document.getElementById("btn-new-preset");
    const btnImport = document.getElementById("btn-import-preset");
    const inputImport = document.getElementById("input-import-preset") as HTMLInputElement;
    const btnSave = document.getElementById("btn-save-preset");
    const btnExportModal = document.getElementById("btn-export-from-modal");
    const btnExportProv = document.getElementById("btn-export-profile");

    btnNew?.addEventListener("click", () => openNewPresetModal());

    btnImport?.addEventListener("click", () => inputImport?.click());

    inputImport?.addEventListener("change", async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      try {
        const text = await file.text();
        const data = JSON.parse(text);
        const preset = data.preset || data;
        if (!preset.target_hz || !preset.name) {
          alert("Invalid .anahat profile file: missing target_hz or name.");
          return;
        }

        // Assign unique code if collision
        if (!preset.code || userPresets.some((p) => p.code === preset.code)) {
          preset.code = `USR-${String(userPresets.length + 1).padStart(3, "0")}`;
        }
        preset.era = "User Custom";

        userPresets.push(preset);
        saveUserPresets(userPresets);
        renderUserPresets();

        // Select imported preset
        const container = document.getElementById("user-presets-container");
        const newlyAdded = container?.lastElementChild as HTMLElement;
        if (newlyAdded) {
          selectPreset(preset, newlyAdded);
        }
      } catch (err) {
        console.error("Failed to parse .anahat file:", err);
        alert("Could not load file. Make sure it is a valid .anahat JSON file.");
      } finally {
        inputImport.value = "";
      }
    });

    btnSave?.addEventListener("click", () => {
      const newPreset = buildPresetFromInputs();
      userPresets.push(newPreset);
      saveUserPresets(userPresets);
      renderUserPresets();
      closeNewPresetModal();

      const container = document.getElementById("user-presets-container");
      const newlyAdded = container?.lastElementChild as HTMLElement;
      if (newlyAdded) {
        selectPreset(newPreset, newlyAdded);
      }
    });

    btnExportModal?.addEventListener("click", () => {
      const preset = buildPresetFromInputs();
      exportPresetAsAnahat(preset);
    });

    btnExportProv?.addEventListener("click", () => {
      if (currentPreset) {
        exportPresetAsAnahat(currentPreset);
      }
    });
  }

  // ═══════════════════════════════════════════════════════════
  // VISUALIZER STYLE TUNING: PALETTES & DENSITY (Option 4)
  // ═══════════════════════════════════════════════════════════

  function cyclePaletteUI(): void {
    if (!visualizer) return;
    const nextPalette = visualizer.cyclePalette();
    theaterVisualizer?.setPalette(nextPalette);

    const canvasPaletteLabel = document.getElementById("canvas-palette-label");
    const theaterBtnPalette = document.getElementById("theater-btn-palette");

    const nameMap: Record<VisualPalette, string> = {
      pastel: "PASTEL",
      monochrome: "MONO",
      amber_crt: "AMBER CRT",
      green_crt: "GREEN CRT",
      cyber_blue: "CYBER BLUE",
    };

    const disp = nameMap[nextPalette] || nextPalette.toUpperCase();
    if (canvasPaletteLabel) canvasPaletteLabel.textContent = `PAL: [ ${disp} ]`;
    if (theaterBtnPalette) theaterBtnPalette.textContent = `PAL: ${disp}`;
  }

  function cycleDetailUI(): void {
    if (!visualizer) return;
    const nextDetail = visualizer.cycleDetail();
    theaterVisualizer?.setDetail(nextDetail);

    const canvasDensityLabel = document.getElementById("canvas-density-label");
    const theaterBtnDetail = document.getElementById("theater-btn-detail");

    const disp = nextDetail.toUpperCase();
    if (canvasDensityLabel) canvasDensityLabel.textContent = `DET: [ ${disp} ]`;
    if (theaterBtnDetail) theaterBtnDetail.textContent = `DET: ${disp}`;
  }

  function wireVisualizerStyleTuning(): void {
    const btnPalette = document.getElementById("btn-palette-toggle");
    const btnDetail = document.getElementById("btn-density-toggle");
    const theaterBtnPalette = document.getElementById("theater-btn-palette");
    const theaterBtnDetail = document.getElementById("theater-btn-detail");

    btnPalette?.addEventListener("click", cyclePaletteUI);
    btnDetail?.addEventListener("click", cycleDetailUI);
    theaterBtnPalette?.addEventListener("click", cyclePaletteUI);
    theaterBtnDetail?.addEventListener("click", cycleDetailUI);
  }

  // ═══════════════════════════════════════════════════════════
  // BOOT
  // ═══════════════════════════════════════════════════════════

  initVisualizer();
  wirePresetClicks();
  wireToggles();
  wireSliders();
  wireRecording();
  wireTheaterMode();
  wireModals();
  wireTrayEvents();
  wireMeditationSession();
  wireInputSource();
  wireAudioRouting();
  wirePresetCreator();
  wireVisualizerStyleTuning();
</script>
