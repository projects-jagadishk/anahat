---
/**
 * index.astro — The Main Deck (Screen 1)
 * 1200×800 — Matches Figma Screen-1-Main-Deck specifications.
 * Fixed columns: Left 300px | Center 600px | Right 300px
 * Static rendering of presets via Astro for instant SSR, no FOUC, and perfect style scoping.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TitleBar from "../components/ui/TitleBar.astro";
import presetsData from "../data/presets.json";

const ERA_DISPLAY_TITLES: Record<string, string> = {
  "Ancient & Vedic": "--- [ VEDIC ] ---",
  "Sacred Solfeggio": "--- [ SOLFEGGIO ] ---",
  "Pythagorean Tuning": "--- [ PYTHAGOREAN ] ---",
  "Modern Clinical": "--- [ CLINICAL ] ---",
  "Classical Physics": "--- [ CLASSICAL PHYSICS ] ---",
};

const ERA_SORT_ORDER = [
  "Ancient & Vedic",
  "Sacred Solfeggio",
  "Pythagorean Tuning",
  "Modern Clinical",
  "Classical Physics",
];

// Group presets by era in strict order
const groupedPresets = ERA_SORT_ORDER.map((era) => ({
  era,
  title: ERA_DISPLAY_TITLES[era] || `--- [ ${era.toUpperCase()} ] ---`,
  items: presetsData.filter((p) => p.era === era),
})).filter((g) => g.items.length > 0);

// Default preset is PRE-001 (Anahata Heart)
const initialPreset = presetsData.find((p) => p.code === "PRE-001") || presetsData[0];
---

<BaseLayout title="ANAHAT // NEUROACOUSTIC DECK">
  <!-- ═══════════════════════════════════════════════════════════
       BOOT LOADING SPLASH SCREEN (Silent DSP Ingestion)
       ═══════════════════════════════════════════════════════════ -->
  <div class="splash-screen" id="splash-screen" role="dialog" aria-modal="true" aria-label="Anahat System Boot">
    <div class="splash-card">
      <div class="splash-logo-container">
        <img src="/logo.svg" alt="ANAHAT Emblem" class="splash-logo" />
        <div class="splash-glow"></div>
      </div>

      <div class="splash-header">
        <h1 class="splash-title">ANAHAT</h1>
        <div class="splash-subtitle">// CYMATICS LAB</div>
      </div>

      <p class="splash-desc">
        Real-Time Acoustic Resonance, Cymatic Waveforms & Mathematical Harmonics Synthesizer
      </p>

      <div class="splash-progress-box">
        <div class="splash-progress-bar" id="splash-progress-bar"></div>
      </div>

      <div class="splash-meta-row">
        <span class="splash-status-text" id="splash-status-text">INITIALIZING DSP KERNEL...</span>
        <span class="splash-percent-text" id="splash-percent-text">12%</span>
      </div>

      <div class="splash-credits">
        made with 🫨 ☕ ❤️ 🤖 by Jagadish, Kasi.
      </div>

      <button class="splash-skip-btn" id="btn-skip-splash" type="button" title="Skip Intro and launch workstation immediately">
        [ SKIP INTRO ⏭ ]
      </button>
    </div>
  </div>

  <TitleBar />

  <main class="deck" id="main-deck">
    <!-- ═══ LEFT COLUMN: Preset Navigator (300×760) ═══ -->
    <aside class="deck__presets">
      <!-- Dark header bar -->
      <div class="deck__presets-header">
        <span class="deck__presets-title">ANAHAT V1.0 // PRESETS</span>
        <span class="deck__presets-badge">30 TONES</span>
      </div>

      <!-- Preset list: statically rendered so all styles bind directly -->
      <div class="deck__presets-list" id="preset-list">
        <!-- User Custom Specifications Section (Dynamically hydrated from localStorage) -->
        <div class="preset-group" id="user-presets-group" style="display: none;">
          <div class="preset-category">--- [ USER SPECIFICATIONS ] ---</div>
          <div id="user-presets-container"></div>
        </div>

        {groupedPresets.map((group) => (
          <div class="preset-group">
            <div class="preset-category">{group.title}</div>
            {group.items.map((preset) => {
              const isDefault = preset.code === "PRE-001" || preset.id === initialPreset.id;
              return (
                <button
                  class={`preset-item ${isDefault ? "preset-item--active" : ""}`}
                  data-preset-id={preset.id}
                  data-preset-json={JSON.stringify(preset)}
                  data-tooltip={`Load ${preset.displayName || preset.name} (${preset.code || preset.id}) at ${Number(preset.target_hz).toFixed(1)} Hz into synthesis engine`}
                  type="button"
                >
                  <div class="preset-item__meta">
                    <span class="preset-item__code">[{preset.code || preset.id.toUpperCase()}]</span>
                    <span class="preset-item__name">{preset.displayName || preset.name}</span>
                    <span class="preset-item__cursor terminal-blink">█</span>
                  </div>
                  <span class="preset-item__hz">{Number(preset.target_hz).toFixed(1)} Hz</span>
                </button>
              );
            })}
          </div>
        ))}
      </div>

      <!-- Action buttons & Chunky REC button at bottom -->
      <div class="deck__presets-footer">
        <div class="deck__preset-mgmt-row">
          <button class="btn-preset-mgmt" id="btn-new-preset" type="button" data-tooltip="Open Specification Builder to create a custom neuroacoustic preset (Hotkey: P)">
            [ + NEW PRESET ]
          </button>
          <button class="btn-preset-mgmt" id="btn-import-preset" type="button" data-tooltip="Import a saved .anahat preset or neuroacoustic specification JSON profile">
            [ IMPORT ]
          </button>
          <input type="file" id="input-import-preset" accept=".anahat,.json" style="display: none;" />
        </div>
        <button class="btn-brutalist btn-rec" id="btn-rec" type="button" data-tooltip="Toggle audio recording and export lossless 48kHz WAV session audio to disk (Hotkey: R)">
          [ REC SESSION ]
        </button>
      </div>
    </aside>

    <!-- ═══ CENTER COLUMN (600×760) ═══ -->
    <section class="deck__center">
      <!-- WebGL Canvas (Flexible remaining height, min 240px, never pushes controls) -->
      <div class="deck__canvas-wrap" id="canvas-card">
        <!-- Recording timecode badge (Screen 5 active state) -->
        <div class="deck__rec-badge" id="rec-badge">
          <span class="deck__rec-dot terminal-blink">●</span>
          <span id="rec-timecode">REC 00:00:00:00</span>
        </div>

        <!-- Overlaid Session HUD on the Visualizer (Zero Layout Shifts in Controls) -->
        <div class="deck__canvas-hud" id="canvas-hud">
          <div class="hud-countdown" id="hud-countdown">10:00</div>
          <div class="hud-phase-badge" id="hud-phase-badge">
            <span class="hud-dot terminal-blink">●</span>
            <span id="hud-phase-label">PHASE: OFF</span>
          </div>
        </div>

        <!-- Unmissable Sine Burst Notification Banner -->
        <div class="deck__burst-banner" id="burst-banner">
          <span class="burst-banner__icon terminal-blink">⚡</span>
          <span class="burst-banner__text">INTERVAL CHIME // 528 HZ SINE BURST</span>
        </div>

        <!-- Breath Sync Cadence Guidance Toast (Main Deck) -->
        <div class="deck__cadence-toast" id="cadence-toast">
          <span class="cadence-toast__badge cadence-toast__badge--inhale" id="cadence-toast-phase">INHALE</span>
          <span class="cadence-toast__text" id="cadence-toast-text">BREATHE IN // 4S</span>
        </div>

        <!-- Studio Cyberdeck 2-Row Toolbar directly above visualizer canvas -->
        <div class="deck__canvas-bar">
          <!-- Row 1: Primary Engine Navigation & Ingest Source & Fullscreen Theater -->
          <div class="canvas-bar__row canvas-bar__row--primary">
            <!-- 1. Precision Engine Navigator (Strictly locked 184px width, ZERO layout shift) -->
            <div class="engine-navigator" id="engine-navigator" data-tooltip="Visualizer Engine Matrix (Hotkeys: [ / ] or 1-9 to cycle, M to open picker)">
              <button class="engine-nav-arrow" id="btn-engine-prev" type="button" data-tooltip="Switch to previous visualizer engine (Hotkey: [)">◀</button>
              <button class="engine-selector-btn" id="btn-engine-menu" type="button" data-tooltip="Open visualizer engine picker matrix (Hotkey: M)">
                <span class="engine-selector__num" id="engine-display-num">01</span>
                <span class="engine-selector__name" id="engine-display-name">CHLADNI NODES</span>
                <span class="engine-selector__icon">▾</span>
              </button>
              <button class="engine-nav-arrow" id="btn-engine-next" type="button" data-tooltip="Switch to next visualizer engine (Hotkey: ])">▶</button>
            </div>

            <!-- Random Auto-Cycle Control -->
            <button class="deck__widget-btn" id="btn-engine-random" type="button" data-tooltip="Toggle random visualizer cycling interval: OFF, 15S, 30S, 60S (Hotkey: S)">
              <span id="random-btn-label">⚄ RND: OFF</span>
            </button>

            <span class="deck__toolbar-sep">|</span>

            <!-- 2. Intuitive Audio Ingest Mode: Carrier Tones vs Live Microphone -->
            <div class="deck__source-wrap" data-tooltip="Audio Source: Generate neuroacoustic carrier tones or capture live room microphone audio (Hotkey: I)">
              <span class="deck__toolbar-tag">AUDIO:</span>
              <div class="deck__source-segmented" id="deck-source-segmented">
                <button class="source-seg-btn source-seg-btn--active" id="btn-src-dsp" type="button" data-tooltip="Synthesize internal neuroacoustic carrier tones">∿ TONES</button>
                <button class="source-seg-btn" id="btn-src-mic" type="button" data-tooltip="Capture external live microphone / room acoustics">🎙 MIC</button>
              </div>
            </div>

            <div class="canvas-bar__spacer"></div>

            <!-- 3. Theater Fullscreen Projection (Always prominently visible in top-right) -->
            <button class="btn-theater" id="btn-theater" type="button" data-tooltip="Launch distraction-free Fullscreen Theater projection (Hotkey: T or Esc to exit)">
              [ ⛶ FULLSCREEN THEATER ]
            </button>
          </div>

          <!-- Row 2: Visualizer Tuning (Scale, Palette, Detail) & Canvas View Mode -->
          <div class="canvas-bar__row canvas-bar__row--secondary">
            <div class="canvas-bar__row-group">
              <!-- Scale Stepper Control (0.5X - 3.0X) -->
              <div class="deck__scale-widget" data-tooltip="Adjust visualizer amplitude scale and particle deflection sensitivity">
                <span class="deck__toolbar-tag">SCALE:</span>
                <button class="scale-step-btn" id="btn-scale-down" type="button" data-tooltip="Decrease visualizer amplitude scale">−</button>
                <span class="scale-readout" id="scale-readout">1.4X</span>
                <button class="scale-step-btn" id="btn-scale-up" type="button" data-tooltip="Increase visualizer amplitude scale">+</button>
              </div>

              <span class="deck__toolbar-sep">|</span>

              <!-- Direct Visualizer Palette Cycle Button -->
              <button class="deck__widget-btn" id="btn-palette-cycle" type="button" data-tooltip="Cycle through harmonic color palettes (Hotkey: C)">
                <span class="style-widget__swatch" id="style-swatch-dot">●</span>
                <span id="palette-btn-label">PAL: STARK</span>
              </button>

              <!-- Direct Visualizer Detail / Density Cycle Button -->
              <button class="deck__widget-btn" id="btn-detail-cycle" type="button" data-tooltip="Cycle particle and mesh geometry density: Low (25%), Mid (50%), High (85%), Ultra (100%) (Hotkey: D)">
                <span id="detail-btn-label">DET: HIGH</span>
              </button>

              <!-- Reset 3D Camera Perspective Button -->
              <button class="deck__widget-btn" id="btn-reset-perspective" type="button" data-tooltip="Reset 3D camera perspective, rotation and zoom to default front view (Hotkey: R or Double-Click canvas)">
                <span>⟲ RESET VIEW</span>
              </button>
            </div>

            <div class="canvas-bar__spacer"></div>

            <!-- Intuitive View / Canvas Expand Toggle -->
            <button class="deck__widget-btn" id="btn-toggle-canvas-expand" type="button" data-tooltip="Toggle expanded canvas mode to hide or restore bottom synthesis controls (Hotkey: Z)">
              <span class="deck__toolbar-tag">VIEW:</span>
              <span id="expand-btn-label">[ ⤢ EXPAND CANVAS ]</span>
            </button>
          </div>
        </div>

        <!-- Canvas render area with coordinate grid background -->
        <div class="deck__canvas" id="webgl-canvas">
          <div class="deck__canvas-grid"></div>
        </div>
      </div>

      <!-- Bottom Control Deck (Adaptive height: full synthesis controls in DSP mode, compact telemetry in Mic/Maximized mode) -->
      <div class="deck__controls" id="bottom-controls-deck">
        <!-- 1. Full Neuroacoustic Synthesis Controls -->
        <div class="deck__synthesis-controls" id="deck-synthesis-wrap">
          <!-- Hz Display — Extreme Scale Contrast (Rock-solid static display) -->
          <div class="deck__hz-block">
            <span class="deck__hz-value" id="hz-readout">{Number(initialPreset.target_hz).toFixed(1)}</span>
            <div class="deck__hz-meta">
              <span class="deck__hz-label">HZ // MASTER RESONANCE</span>
              <span class="deck__hz-waveform" id="waveform-label">
                WAVEFORM: {(initialPreset.waveform || "sine").toUpperCase()} SINE
              </span>
            </div>
          </div>

          <!-- Harmonic Sliders row -->
          <div class="deck__slider-row">
            <div class="deck__slider-box">
              <label class="deck__slider-label" for="slider-n">
                HARMONIC N: <span id="val-n">{initialPreset.harmonic_n}</span>
              </label>
              <div class="deck__slider-track-wrap">
                <input
                  type="range"
                  min="1"
                  max="10"
                  value={initialPreset.harmonic_n}
                  class="slider-brutalist"
                  id="slider-n"
                  data-tooltip="Adjust harmonic modal parameter N (Radial symmetry modes 1 to 10)"
                />
              </div>
            </div>
            <div class="deck__slider-box">
              <label class="deck__slider-label" for="slider-m">
                HARMONIC M: <span id="val-m">{initialPreset.harmonic_m}</span>
              </label>
              <div class="deck__slider-track-wrap">
                <input
                  type="range"
                  min="1"
                  max="10"
                  value={initialPreset.harmonic_m}
                  class="slider-brutalist"
                  id="slider-m"
                  data-tooltip="Adjust harmonic modal parameter M (Concentric nodal circle modes 1 to 10)"
                />
              </div>
            </div>
          </div>

          <!-- Noise Blend Interactive Control Deck -->
          <div class="deck__noise-deck">
            <div class="deck__noise-header">
              <span class="deck__noise-label" id="noise-label">
                NOISE BLEND: {(initialPreset.noise_masking_type || "brown").toUpperCase()} // ████████░░░░ {Math.round((initialPreset.noise_blend_ratio || 0.25) * 100)}%
              </span>
              <div class="deck__noise-types" id="noise-types">
                <button class="noise-type-btn noise-type-btn--active" data-noise="brown" type="button" data-tooltip="Select Brown Noise (Deep Brownian spectral density 1/f²)">BROWN</button>
                <button class="noise-type-btn" data-noise="pink" type="button" data-tooltip="Select Pink Noise (Balanced 1/f noise floor for acoustic focus)">PINK</button>
                <button class="noise-type-btn" data-noise="white" type="button" data-tooltip="Select White Noise (Uniform equal-energy spectral distribution)">WHITE</button>
                <button class="noise-type-btn" data-noise="none" type="button" data-tooltip="Mute acoustic masking noise floor">MUTE</button>
              </div>
            </div>
            <div class="deck__slider-track-wrap">
              <input
                type="range"
                min="0"
                max="100"
                value={Math.round((initialPreset.noise_blend_ratio || 0.25) * 100)}
                class="slider-brutalist slider-brutalist--noise"
                id="slider-noise"
                data-tooltip="Adjust background masking noise blend ratio (0% silent to 100% full mix)"
              />
            </div>
          </div>
        </div>

        <!-- 2. Compact Ingest & Visualizer Telemetry Strip (Engaged during mic ingest or big visualizer mode) -->
        <div class="deck__telemetry-bar" id="deck-telemetry-strip" style="display: none;">
          <div class="telemetry-bar__left">
            <span class="telemetry-badge" id="telemetry-mode-badge">SRC: LIVE MIC INGEST</span>
            <span class="telemetry-sep">/</span>
            <span class="telemetry-meter" id="telemetry-meter-bar">LEVEL: [░░░░░░░░░░]</span>
            <span class="telemetry-sep">/</span>
            <span class="telemetry-text" id="telemetry-gain-text">GAIN: 1.4X</span>
          </div>
          <div class="telemetry-bar__right">
            <span class="telemetry-note" id="telemetry-note">VISUALIZER ENGAGED // 60 FPS</span>
            <button class="btn-restore-deck" id="btn-restore-deck" type="button" data-tooltip="Exit expanded canvas view and restore full synthesis deck controls">[ ⤓ SHOW CONTROLS ]</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ RIGHT COLUMN: Breath Sync & Provenance (300px) ═══ -->
    <aside class="deck__provenance">
      <!-- ── V1.5 Prominent Breath Synchronization & Meditation Deck ── -->
      <div class="deck__meditation-card" id="meditation-card">
        <div class="deck__med-header">
          <div class="deck__med-header-left">
            <span class="deck__med-title">BREATH SYNCHRONIZER</span>
            <button
              type="button"
              class="deck__med-info-icon"
              id="btn-breath-sync-info"
              aria-label="Breath Synchronization Information"
              data-tooltip="BREATH SYNCHRONIZATION: Guides visual respiration rhythm to modulate Autonomic Nervous System tone and Heart Rate Variability (HRV). Box Breathing (4-4-4-4) resets cortisol and builds focus; 4-7-8 Breathing activates parasympathetic vagal toning to reduce anxiety; Coherent Breathing (5s-5s) balances cardiac-respiratory resonance."
              title="Breath Synchronization: Guides rhythmic breathing (Box 4-4-4-4, 4-7-8, Coherent) to balance HRV, autonomic nervous system tone, and mental focus."
            >ⓘ</button>
          </div>
          <span class="deck__med-badge" id="med-cadence-badge">OFF</span>
        </div>

        <div class="deck__med-body">
          <!-- Row 1: Cadence Dropdown -->
          <div class="deck__med-field">
            <label class="deck__med-label" for="select-cadence">CADENCE PATTERN</label>
            <div class="select-brutalist-wrap">
              <select class="select-brutalist" id="select-cadence" data-tooltip="Select meditation breath synchronizer cadence: Box (4-4-4-4), 4-7-8 Relax, Coherent (5-5), or Off">
                <option value="off" selected>BREATH_SYNC // [ OFF ]</option>
                <option value="box">BREATH_SYNC // [ BOX 4-4-4-4 ]</option>
                <option value="478">BREATH_SYNC // [ 4-7-8 RELAX ]</option>
                <option value="coherent">BREATH_SYNC // [ COHERENT 5-5 ]</option>
              </select>
            </div>
          </div>

          <!-- Row 2: Master Sync Toggle + Chime Toggle -->
          <div class="deck__med-toggles-row">
            <button
              class="cadence-toggle-switch"
              id="btn-cadence-toggle"
              type="button"
              data-tooltip="Directly toggle breath synchronization ON or OFF without opening dropdown"
            >
              <span class="toggle-switch-indicator"></span>
              <span id="cadence-toggle-label">SYNC: OFF</span>
            </button>

            <!-- Tibetan Singing Bowl Cadence Chime Toggle (Off by default) -->
            <button
              class="chime-toggle-btn"
              id="btn-chime-toggle"
              type="button"
              data-tooltip="Toggle Tibetan singing bowl chime and carrier ducking on breath phase transitions (Hotkey: B)"
            >
              <span id="chime-status-label">🔕 CHIMES: OFF</span>
            </button>
          </div>

          <!-- Row 3: Dedicated Timebox Row (Full Width) -->
          <div class="deck__timebox-row">
            <span class="deck__med-label">TIMEBOX DURATION</span>
            <div class="deck__timebox-toggles" id="timebox-toggles">
              <button class="timebox-btn timebox-btn--active" data-mins="10" type="button" data-tooltip="Set meditation session length to 10 minutes">[ 10 MIN ]</button>
              <button class="timebox-btn" data-mins="20" type="button" data-tooltip="Set meditation session length to 20 minutes">[ 20 MIN ]</button>
              <button class="timebox-btn" data-mins="60" type="button" data-tooltip="Set meditation session length to 60 minutes">[ 60 MIN ]</button>
              <button class="timebox-btn" data-mins="infinity" type="button" data-tooltip="Continuous meditation session without automatic timebox limit">[ ∞ CONT ]</button>
            </div>
          </div>

          <!-- Row 4: Prominent Session Start Button -->
          <button class="btn-session" id="btn-session" type="button" data-tooltip="Start or pause guided breath and neuroacoustic meditation session (Hotkey: Space)">
            [ START SESSION ⏵ ]
          </button>
        </div>
      </div>

      <!-- Provenance Spec Card (Reduced Height) -->
      <div class="deck__prov-card">
        <!-- Dark header -->
        <div class="deck__prov-header">
          <span class="deck__prov-title">PROVENANCE // <span id="spec-header-id">{initialPreset.code || "PRE-001"}</span></span>
        </div>

        <!-- Spec rows — alternating bg matching Figma spec card -->
        <div class="deck__prov-specs" id="spec-rows">
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">PRESET_ID</span>
            <span class="deck__spec-val" id="spec-id">{initialPreset.code || "PRE-001"}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--odd">
            <span class="deck__spec-key">NAME</span>
            <span class="deck__spec-val" id="spec-name">{initialPreset.displayName || initialPreset.name}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">CULTURE</span>
            <span class="deck__spec-val" id="spec-era">{initialPreset.era}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--odd">
            <span class="deck__spec-key">TARGET_HZ</span>
            <span class="deck__spec-val deck__spec-val--hz" id="spec-target">{Number(initialPreset.target_hz).toFixed(2)} Hz</span>
          </div>
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">CHLADNI</span>
            <span class="deck__spec-val" id="spec-chladni">n={initialPreset.harmonic_n}, m={initialPreset.harmonic_m}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--odd">
            <span class="deck__spec-key">EVIDENCE</span>
            <span class="deck__spec-val" id="spec-evidence">{initialPreset.evidence_level}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">RATING</span>
            <span class="deck__spec-val" id="spec-rating">[ ★★★★★ ]</span>
          </div>
        </div>

        <!-- Research Abstract block -->
        <div class="deck__prov-abstract" id="spec-abstract">
          <span class="deck__abstract-heading">RESEARCH ABSTRACT:</span>
          <p class="deck__abstract-body" id="spec-abstract-body">
            {initialPreset.therapeutic_use_case}
            <br/><br/>
            {initialPreset.neurological_target}
          </p>
          <p class="deck__abstract-citation" id="spec-citation">
            CITATION: {initialPreset.citation}
          </p>
        </div>

        <!-- Biometric Sync V2 button -->
        <button class="btn-biometric" id="btn-biometric" type="button" data-tooltip="Open Bluetooth LE Biometric Sync monitor and galvanic skin resonance telemetry">
          [ BIOMETRIC SYNC // V2 ]
        </button>

        <!-- Export Active Preset Button (.anahat Profile) -->
        <button class="btn-export-profile" id="btn-export-profile" type="button" data-tooltip="Export current neuroacoustic synthesis specifications as a portable .anahat JSON profile">
          [ EXPORT .ANAHAT PROFILE ]
        </button>
      </div>
    </aside>
  </main>

  <!-- ═══════════════════════════════════════════════════════════
       SCREEN 2: THEATER MODE OVERLAY (1920x1080 CHROMELESS)
       ═══════════════════════════════════════════════════════════ -->
  <div class="theater-overlay" id="theater-overlay">
    <button class="btn-theater-exit" id="btn-theater-exit" data-tooltip="Exit Fullscreen Theater Mode (Hotkey: Esc or T)">
      ✕
    </button>
    <!-- Theater Visualizer Navigator (Centered floating HUD with matrix launcher) -->
    <div class="theater-toolbar" id="theater-toolbar">
      <button class="theater-nav-arrow" id="theater-engine-prev" type="button" data-tooltip="Previous visualizer engine (Hotkey: [)">◀</button>
      <button class="theater-selector-btn" id="theater-engine-menu" type="button" data-tooltip="Open engine matrix picker (Hotkey: M or 1-9)">
        <span class="theater-engine__num" id="theater-display-num">01</span>
        <span class="theater-engine__name" id="theater-display-name">CHLADNI NODES</span>
