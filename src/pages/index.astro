  /* Scale Stepper Widget */
  .deck__scale-widget {
    display: flex;
    align-items: center;
    gap: 3px;
    background: #090A0D;
    border: 1px solid #262830;
    height: 24px;
    padding: 0 4px;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .scale-step-btn {
    appearance: none;
    background: transparent;
    border: none;
    color: #727785;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    width: 14px;
    height: 100%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .scale-step-btn:hover {
    color: #FFF;
  }

  .scale-readout {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    color: #00F0FF;
    min-width: 26px;
    text-align: center;
  }

  /* Widget Buttons (Palette, Detail, Maximize) */
  .deck__widget-btn {
    appearance: none;
    background: #090A0D;
    border: 1px solid #262830;
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    height: 24px;
    padding: 0 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap !important;
    flex-shrink: 0;
    box-sizing: border-box;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .deck__widget-btn:hover {
    background: #181920;
    border-color: #3F4452;
  }

  .deck__widget-btn--active {
    color: var(--color-accent-industrial);
    border-color: var(--color-accent-industrial);
  }

  #btn-engine-random {
    width: 94px;
    min-width: 94px;
    max-width: 94px;
    justify-content: center;
  }

  #btn-palette-cycle {
    width: 90px;
    min-width: 90px;
    max-width: 90px;
    justify-content: center;
  }

  #btn-detail-cycle {
    width: 76px;
    min-width: 76px;
    max-width: 76px;
    justify-content: center;
  }

  #btn-reset-perspective {
    width: 96px;
    min-width: 96px;
    max-width: 96px;
    justify-content: center;
  }

  .style-widget__swatch {
    color: #FF8877;
    font-size: 8px;
  }

  .btn-theater {
    appearance: none;
    border: none;
    background: var(--color-accent-industrial);
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    height: 24px;
    padding: 0 10px;
    cursor: pointer;
    text-transform: uppercase;
    white-space: nowrap !important;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    transition: background 0.15s ease;
  }

  .btn-theater:hover {
    background: #FF5555;
  }
  /* ── Adaptive Collapsible Deck (Doubles Canvas Area) ── */

  .deck__controls--collapsed {
    height: 42px !important;
    min-height: 42px !important;
    padding: 0 14px !important;
  }

  .deck__controls--collapsed .deck__synthesis-controls {
    display: none !important;
  }

  .deck__controls--collapsed .deck__telemetry-bar {
    display: flex !important;
  }

  .deck__synthesis-controls {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
  }

  .deck__telemetry-bar {
    height: 100%;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    gap: 12px;
    white-space: nowrap !important;
    overflow: hidden;
  }

  .telemetry-bar__left,
  .telemetry-bar__right {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap !important;
    flex-shrink: 0;
  }

  .telemetry-badge {
    background: var(--color-accent-industrial);
    color: #FFF;
    padding: 3px 8px;
    font-size: 9px;
    letter-spacing: 0.04em;
    white-space: nowrap !important;
    flex-shrink: 0;
  }

  .telemetry-sep {
    color: #888;
    font-size: 9px;
    flex-shrink: 0;
  }

  .telemetry-meter {
    color: var(--color-accent-industrial);
    letter-spacing: -0.05em;
    white-space: nowrap !important;
    flex-shrink: 0;
  }

  .telemetry-text {
    color: var(--color-text-secondary);
    font-size: 9px;
    white-space: nowrap !important;
    flex-shrink: 0;
  }

  .telemetry-note {
    font-size: 9px;
    color: #666;
    white-space: nowrap !important;
    flex-shrink: 0;
  }

  .btn-restore-deck {
    appearance: none;
    border: 2px solid var(--color-border-heavy);
    background: var(--color-bg-concrete);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    padding: 4px 10px;
    cursor: pointer;
    border-radius: 0 !important;
    white-space: nowrap !important;
    flex-shrink: 0;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .btn-restore-deck:hover {
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
  }

  .theater-hud__source {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #AAA;
    background: #181818;
    padding: 3px 6px;
    border: 1px solid #333;
  }
    border: none;
    background: var(--color-accent-industrial);
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    padding: 4px 10px;
    cursor: pointer;
    text-transform: uppercase;
  }

  .btn-theater:hover {
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
  }

  .deck__canvas {
    flex: 1 1 0;
    width: 100%;
    position: relative;
    background: var(--color-bg-surface-light);
    overflow: hidden;
  }

  .deck__canvas-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border-light) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border-light) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    opacity: 0.45;
  }

  /* Control Deck: STRICTLY LOCKED HEIGHT so sliders never get pushed off */
  .deck__controls {
    flex-shrink: 0;
    height: 308px;
    background: var(--color-bg-surface-light);
    border: 3px solid var(--color-border-heavy);
    box-shadow: var(--shadow-brutalist);
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    gap: 8px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .deck__hz-block {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-shrink: 0;
  }

  /* Overlaid Canvas HUD for Meditation Countdown (Zero layout shifts) */
  .deck__canvas-hud {
    display: none;
    position: absolute;
    top: 50px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    pointer-events: none;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .deck--screen7 .deck__canvas-hud {
    display: flex;
  }

  .hud-countdown {
    font-family: var(--font-display);
    font-size: clamp(60px, 9vw, 96px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 2.5px var(--color-border-heavy);
    text-shadow: 2px 2px 0px rgba(255, 255, 255, 0.95);
  }

  .hud-phase-badge {
    background: var(--color-bg-surface-dark);
    color: var(--color-accent-industrial);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border: 2px solid var(--color-border-heavy);
    box-shadow: 3px 3px 0 0 #000;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
  }

  .hud-dot {
    color: var(--color-accent-industrial);
    font-size: 10px;
  }

  /* Screen 7 Takeover State */
  .deck--screen7 {
    grid-template-columns: 300px 1fr 0px !important;
  }

  .deck--screen7 .deck__provenance {
    display: none !important;
  }

  /* Unmissable Sine Burst Banner */
  .deck__burst-banner {
    display: none;
    position: absolute;
    top: 36px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 30;
    background: var(--color-accent-industrial);
    color: var(--color-bg-surface-light);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 6px 16px;
    border: 2px solid var(--color-border-heavy);
    box-shadow: 4px 4px 0 0 #000;
    align-items: center;
    gap: 8px;
    text-transform: uppercase;
  }

  .deck__burst-banner--active {
    display: flex;
  }

  /* Breath Sync Cadence Guidance Toast (Main Deck) */
  .deck__cadence-toast {
    display: none;
    position: absolute;
    top: 72px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 35;
    background: #0D0E12;
    border: 2px solid #333842;
    box-shadow: 4px 4px 0px #000000;
    padding: 6px 14px;
    align-items: center;
    gap: 10px;
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .deck__cadence-toast--active {
    display: inline-flex !important;
  }

  /* Breath Sync Cadence Guidance Toast (Theater Mode) */
  .theater__cadence-toast {
    display: none;
    position: absolute;
    top: 76px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10002;
    background: rgba(13, 14, 18, 0.94);
    border: 2px solid #333842;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    padding: 8px 18px;
    align-items: center;
    gap: 12px;
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .theater__cadence-toast--active {
    display: inline-flex !important;
  }

  .cadence-toast__badge {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 800;
    padding: 2px 7px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .cadence-toast__badge--inhale {
    background: #00E5FF;
    color: #000000;
  }

  .cadence-toast__badge--hold {
    background: #FFB000;
    color: #000000;
  }

  .cadence-toast__badge--exhale {
    background: var(--color-accent-industrial, #FF1433);
    color: #FFFFFF;
  }

  .cadence-toast__badge--empty {
    background: #4E5566;
    color: #FFFFFF;
  }

  .cadence-toast__text {
    font-family: var(--font-display);
    font-size: 11.5px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .theater__cadence-toast .cadence-toast__text {
    font-size: 13px;
  }

  .cadence-toast--pop {
    animation: cadence-pop 0.25s ease-out;
  }

  @keyframes cadence-pop {
    0% {
      transform: translateX(-50%) scale(0.95);
      opacity: 0.8;
    }
    100% {
      transform: translateX(-50%) scale(1.0);
      opacity: 1;
    }
  }

  .burst-banner__icon {
    color: #FFF;
    font-size: 14px;
  }

  @keyframes breath-decay-glow {
    0% {
      box-shadow: inset 0 0 0 rgba(245, 140, 20, 0), 0 0 0 rgba(245, 140, 20, 0);
      border-color: var(--color-border-heavy);
    }
    14% {
      /* Soft gentle breath rise */
      box-shadow: inset 0 0 14px rgba(245, 140, 20, 0.10), 0 0 16px rgba(245, 140, 20, 0.14);
      border-color: rgba(245, 140, 20, 0.35);
    }
    100% {
      /* Natural soothing exhalation decay */
      box-shadow: inset 0 0 0 rgba(245, 140, 20, 0), 0 0 0 rgba(245, 140, 20, 0);
      border-color: var(--color-border-heavy);
    }
  }

  .deck__canvas-wrap--pulse {
    /* Pulsating animation removed per user request to eliminate distractions */
    animation: none !important;
  }

  /* Prominent Breath Synchronization Card (Right Column) */
  .deck__meditation-card {
    background: var(--color-bg-surface-light);
    border: 3px solid var(--color-border-heavy);
    box-shadow: 4px 4px 0px 0px #000000;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .deck__med-header {
    height: 30px;
    background: var(--color-bg-surface-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    flex-shrink: 0;
  }

  .deck__med-header-left {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .deck__med-title {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-bg-surface-light);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .deck__med-badge {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.15);
    color: var(--color-bg-surface-light);
    padding: 2px 6px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .deck__med-badge--active {
    background: var(--color-accent-industrial) !important;
    color: #FFF !important;
    border-color: var(--color-accent-industrial) !important;
  }

  .deck__med-body {
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--color-bg-concrete);
  }

  .deck__med-field {
    display: flex;
    flex-direction: column;
  }

  .deck__med-subrow {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .deck__med-label-row {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 2px;
  }

  .deck__med-label-row .deck__med-label {
    margin-bottom: 0;
  }

  .deck__med-info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid #777;
    background: transparent;
    color: #888;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    line-height: 1;
    cursor: help;
    padding: 0;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .deck__med-info-icon:hover,
  .deck__med-info-icon:focus-visible {
    color: #FFF;
    border-color: #FFF;
    background: rgba(255, 255, 255, 0.15);
    outline: none;
  }

  .deck__med-label {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #666;
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .deck__cadence-box {
    flex: 1.1;
    min-width: 0;
  }

  .select-brutalist-wrap {
    width: 100%;
  }

  .select-brutalist {
    width: 100%;
    height: 24px;
    background: var(--color-bg-surface-light);
    border: 2px solid var(--color-border-heavy);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    color: var(--color-bg-surface-dark);
    padding: 0 4px;
    text-transform: uppercase;
    outline: none;
    cursor: pointer;
  }

  .select-brutalist:focus {
    border-color: var(--color-accent-industrial);
  }

  .deck__med-toggles-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
  }

  .cadence-toggle-switch {
    appearance: none;
    -webkit-appearance: none;
    flex: 1;
    background: #0D0E12;
    border: 1px solid #333842;
    color: #999999;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    padding: 0 8px;
    height: 28px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .cadence-toggle-switch:hover {
    background: #1C1E26;
    border-color: #555C6D;
    color: #FFFFFF;
  }

  .cadence-toggle-switch--active {
    border-color: var(--color-accent-industrial) !important;
    color: #FFFFFF !important;
    background: rgba(255, 20, 51, 0.15) !important;
  }

  .toggle-switch-indicator {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #555555;
    flex-shrink: 0;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  .cadence-toggle-switch--active .toggle-switch-indicator {
    background: var(--color-accent-industrial);
    box-shadow: 0 0 6px var(--color-accent-industrial);
  }

  .chime-toggle-btn {
    appearance: none;
    -webkit-appearance: none;
    flex: 1;
    background: #0D0E12;
    border: 1px solid #333842;
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    padding: 0 8px;
    height: 28px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .chime-toggle-btn:hover {
    background: #1C1E26;
    border-color: #555C6D;
  }

  .chime-toggle-btn--active {
    border-color: var(--color-accent-industrial) !important;
    color: #FFFFFF !important;
    background: rgba(255, 20, 51, 0.15) !important;
  }

  .deck__timebox-row {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
  }

  .deck__timebox-toggles {
    display: flex;
    gap: 4px;
    width: 100%;
  }

  .timebox-btn {
    appearance: none;
    -webkit-appearance: none;
    flex: 1;
    height: 26px;
    background: var(--color-bg-surface-light);
    border: 1px solid var(--color-border-heavy);
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 700;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-bg-surface-dark);
    text-transform: uppercase;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .timebox-btn:hover {
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
  }

  .timebox-btn--active {
    background: var(--color-accent-industrial) !important;
    color: var(--color-bg-surface-light) !important;
    border-color: var(--color-accent-industrial) !important;
  }

  .btn-session {
    appearance: none;
    -webkit-appearance: none;
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
    border: 2px solid var(--color-border-heavy);
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    letter-spacing: -0.02em;
    cursor: pointer;
    text-transform: uppercase;
    flex-shrink: 0;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-session:hover {
    background: var(--color-accent-industrial);
  }

  .btn-session--active {
    background: var(--color-accent-industrial) !important;
    color: var(--color-bg-surface-light) !important;
  }

  .deck__hz-value {
    font-family: var(--font-display);
    font-size: clamp(52px, 8vw, 86px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: var(--color-bg-surface-dark);
  }

  .deck__hz-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 6px;
  }

  .deck__hz-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent-industrial);
    text-transform: uppercase;
  }

  .deck__hz-waveform {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: #737373;
    text-transform: uppercase;
  }

  /* Slider row — side-by-side boxes */
  .deck__slider-row {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  .deck__slider-box {
    flex: 1;
    background: var(--color-bg-concrete);
    border: 2px solid var(--color-border-heavy);
    padding: 8px 10px 10px;
  }

  .deck__slider-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }

  .deck__slider-track-wrap {
    width: 100%;
  }

  .slider-brutalist {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 4px;
    background: var(--color-border-heavy);
    outline: none;
    cursor: pointer;
    margin: 6px 0;
  }

  .slider-brutalist::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 8px;
    height: 22px;
    background: var(--color-bg-surface-dark);
    border: none;
    cursor: grab;
  }

  .slider-brutalist::-webkit-slider-thumb:active {
    cursor: grabbing;
    background: var(--color-accent-industrial);
  }

  .deck__noise-deck {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--color-bg-concrete);
    border: 2px solid var(--color-border-heavy);
    padding: 6px 10px;
    box-sizing: border-box;
    margin-top: auto;
    flex-shrink: 0;
  }

  .deck__noise-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .deck__noise-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-bg-surface-dark);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .deck__noise-types {
    display: flex;
    gap: 3px;
    flex-shrink: 0;
  }

  .noise-type-btn {
    appearance: none;
    -webkit-appearance: none;
    border: 1px solid var(--color-border-heavy);
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    padding: 2px 5px;
    cursor: pointer;
    text-transform: uppercase;
  }

  .noise-type-btn:hover {
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
  }

  .noise-type-btn--active {
    background: var(--color-bg-surface-dark) !important;
    color: var(--color-accent-industrial) !important;
    border-color: var(--color-border-heavy) !important;
  }

  /* ── RIGHT COLUMN: 300px ── */

  .deck__provenance {
    display: flex;
    flex-direction: column;
    padding: 12px 10px;
    height: 100%;
    box-sizing: border-box;
    overflow: hidden;
    background: var(--color-bg-concrete);
    gap: 10px;
  }

  .deck__prov-card {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 0;
    background: var(--color-bg-surface-light);
    border: 3px solid var(--color-border-heavy);
    box-shadow: 4px 4px 0px 0px #000000;
    overflow: hidden;
    box-sizing: border-box;
  }

  .deck__prov-header {
    height: 28px;
    min-height: 28px;
    display: flex;
    align-items: center;
    padding: 0 10px;
    background: var(--color-bg-surface-dark);
    flex-shrink: 0;
  }

  .deck__prov-title {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-bg-surface-light);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .deck__prov-specs {
    flex-shrink: 0;
  }

  .deck__spec-row {
    display: flex;
    align-items: center;
    height: 19px;
    padding: 0 6px;
    border: 1px solid var(--color-border-heavy);
    margin: 0 8px;
  }

  .deck__spec-row--even {
    background: var(--color-bg-concrete);
  }

  .deck__spec-row--odd {
    background: var(--color-bg-surface-light);
  }

  .deck__spec-key {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    width: 75px;
    flex-shrink: 0;
  }

  .deck__spec-val {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .deck__spec-val--hz {
    color: var(--color-accent-industrial);
  }

  /* Research Abstract */
  .deck__prov-abstract {
    flex: 1 1 0;
    min-height: 38px;
    margin: 6px 8px;
    padding: 6px 8px;
    background: var(--color-bg-concrete);
    border: 1px solid var(--color-border-heavy);
    overflow-y: auto;
  }

  .deck__abstract-heading {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }

  .deck__abstract-body {
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 1.35;
    margin: 0 0 4px;
  }

  .deck__abstract-citation {
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 1.3;
    margin: 0;
    color: #737373;
  }

  /* Biometric button */
  .btn-biometric {
    appearance: none;
    height: 26px;
    margin: 0 8px 4px 8px;
    background: var(--color-bg-surface-dark);
    border: 2px solid var(--color-border-heavy);
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .btn-biometric:hover {
    background: var(--color-accent-industrial);
  }

  /* ── Brutalist Button Atom ── */

  .btn-brutalist {
    appearance: none;
    border: 3px solid var(--color-border-heavy);
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    padding: 12px 16px;
    cursor: pointer;
    box-shadow: var(--shadow-brutalist);
    width: 100%;
    transition: none;
  }

  .btn-brutalist:hover {
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
  }

  .btn-brutalist--sm {
    font-size: 12px;
    padding: 8px 16px;
    width: auto;
  }

  .btn-rec--recording {
    box-shadow: none !important;
    transform: translate(6px, 6px);
    background: var(--color-accent-industrial) !important;
    color: var(--color-bg-surface-light) !important;
  }

  /* ══════════════════════════════════════════════════════════
     BOOT LOADING SPLASH SCREEN
   ══════════════════════════════════════════════════════════ */

  .splash-screen {
    position: fixed;
    inset: 0;
    z-index: 100000;
    background: #080808;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .splash-screen--fade-out {
    opacity: 0;
    transform: scale(1.02);
    pointer-events: none;
  }

  .splash-card {
    width: 440px;
    max-width: calc(100vw - 32px);
    background: #0D0D0D;
    border: 2px solid #222222;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85), 0 0 30px rgba(255, 20, 51, 0.12);
    padding: 36px 32px 28px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: var(--font-mono, "Space Mono", monospace);
    position: relative;
  }

  .splash-logo-container {
    position: relative;
    width: 72px;
    height: 72px;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .splash-logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    z-index: 2;
    filter: drop-shadow(0 0 14px rgba(255, 20, 51, 0.55));
  }

  .splash-glow {
    position: absolute;
    inset: -8px;
    background: radial-gradient(circle, rgba(255, 20, 51, 0.4) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    animation: splashPulse 2.2s infinite alternate ease-in-out;
  }

  @keyframes splashPulse {
    0% { transform: scale(0.92); opacity: 0.5; }
    100% { transform: scale(1.15); opacity: 0.9; }
  }

  .splash-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
  }

  .splash-title {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #FFFFFF;
    margin: 0;
    line-height: 1;
  }

  .splash-subtitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #FF1433;
  }

  .splash-desc {
    font-size: 11px;
    line-height: 1.5;
    color: #888888;
    margin: 0 0 24px 0;
    max-width: 360px;
  }

  .splash-progress-box {
    width: 100%;
    height: 6px;
    background: #181818;
    border: 1px solid #2A2A2A;
    margin-bottom: 12px;
    overflow: hidden;
    position: relative;
  }

  .splash-progress-bar {
    height: 100%;
    width: 12%;
    background: linear-gradient(90deg, #FF1433, #FF4560);
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 8px rgba(255, 20, 51, 0.8);
  }

  .splash-meta-row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    font-weight: 700;
    color: #666666;
    margin-bottom: 24px;
    letter-spacing: 0.08em;
  }

  .splash-status-text {
    color: #999999;
  }

  .splash-percent-text {
    color: #FF1433;
    font-variant-numeric: tabular-nums;
  }

  .splash-credits {
    font-size: 11px;
    font-weight: 600;
    color: #AAAAAA;
    letter-spacing: 0.05em;
    border-top: 1px solid #1C1C1C;
    padding-top: 16px;
    width: 100%;
  }

  .splash-skip-btn {
    appearance: none;
    background: transparent;
    border: 1px solid #2A2A2A;
    color: #777777;
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    font-weight: 700;
    padding: 6px 14px;
    margin-top: 16px;
    cursor: pointer;
    letter-spacing: 0.1em;
    transition: all 0.2s ease;
  }

  .splash-skip-btn:hover {
    border-color: var(--color-accent-industrial, #FF1433);
    color: #FFFFFF;
    background: rgba(255, 20, 51, 0.12);
  }

  /* ══════════════════════════════════════════════════════════
     THEATER MODE OVERLAY (SCREEN 2)
   ══════════════════════════════════════════════════════════ */

  .theater-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: #000000;
    z-index: 10000;
    overflow: hidden;
  }

  .theater-overlay--active {
    display: block;
  }

  .theater-canvas-container {
    width: 100%;
    height: 100%;
  }

  .btn-theater-exit {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 10001;
    width: 50px;
    height: 50px;
    background: #FFFFFF;
    border: 3px solid #000000;
    color: #000000;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-theater-exit:hover {
    background: var(--color-accent-industrial);
    color: #FFFFFF;
  }

  /* Theater Navigator Floating Bar */
  .theater-toolbar {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10001;
    display: flex;
    align-items: center;
    background: rgba(12, 13, 16, 0.94);
    border: 1px solid #333842;
    padding: 3px 6px;
    gap: 6px;
    backdrop-filter: blur(14px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.85);
    white-space: nowrap !important;
  }

  .theater-toolbar--faded {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-10px);
  }

  .theater-nav-arrow {
    appearance: none;
    background: transparent;
    border: 1px solid transparent;
    color: #888;
    font-family: var(--font-mono);
    font-size: 11px;
    width: 26px;
    min-width: 26px;
    max-width: 26px;
    height: 26px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .theater-nav-arrow:hover {
    color: #FFF;
    background: #222;
    border-color: #444;
  }

  /* Fixed 184px rigidly locked engine selector in Theater Mode (ZERO shift) */
  .theater-selector-btn {
    appearance: none;
    background: #090A0D;
    border: 1px solid #282A33;
    color: #FFF;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    height: 26px;
    width: 184px;
    min-width: 184px;
    max-width: 184px;
    padding: 0 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .theater-selector-btn:hover {
    background: #1C1E26;
    border-color: #3F4452;
  }

  .theater-engine__num {
    color: var(--color-accent-industrial);
    font-weight: 700;
    font-size: 10px;
    min-width: 18px;
    flex-shrink: 0;
  }

  .theater-engine__name {
    color: #FFF;
    letter-spacing: 0.05em;
    font-size: 10px;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: left;
  }

  .theater-engine__icon {
    color: #727785;
    font-size: 8px;
    margin-left: 2px;
    flex-shrink: 0;
  }

  /* Theater Control Buttons with LOCKED fixed widths (ZERO shift) */
  .theater-ctrl-btn {
    appearance: none;
    background: #090A0D;
    border: 1px solid #282A33;
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    height: 26px;
    padding: 0 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .theater-ctrl-btn:hover {
    background: #1C1E26;
    border-color: #3F4452;
    color: #FFFFFF;
  }

  #theater-btn-random {
    width: 94px;
    min-width: 94px;
    max-width: 94px;
  }

  #theater-btn-palette {
    width: 90px;
    min-width: 90px;
    max-width: 90px;
  }

  #theater-btn-detail {
    width: 76px;
    min-width: 76px;
    max-width: 76px;
  }

  #theater-btn-reset-view {
    width: 76px;
    min-width: 76px;
    max-width: 76px;
  }

  /* Engine Matrix Modal Styles */
  .modal-box--engines {
    width: 820px;
    max-width: 94vw;
    max-height: 86vh;
    border: 3px solid #000;
    box-shadow: 8px 8px 0px 0px #000;
  }

  .modal-body--engines {
    padding: 16px;
    background: #0E0E0E;
    overflow-y: auto;
  }

  .engine-matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 12px;
  }

  .engine-tile {
    appearance: none;
    text-align: left;
    background: #181818;
    border: 1px solid #2E2E2E;
    padding: 12px 14px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.08s ease;
  }

  .engine-tile:hover {
    border-color: var(--color-accent-industrial);
    background: #222222;
  }

  .engine-tile--active {
    border: 2px solid var(--color-accent-industrial) !important;
    background: #241212 !important;
    box-shadow: 0 0 10px rgba(255, 51, 51, 0.25);
  }

  .engine-tile__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .engine-tile__num {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    color: var(--color-accent-industrial);
    letter-spacing: 0.05em;
  }

  .engine-tile__cat {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    color: #888;
    background: #101010;
    padding: 2px 4px;
    border: 1px solid #333;
    letter-spacing: 0.04em;
  }

  .engine-tile__title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #FFF;
    margin-bottom: 4px;
    letter-spacing: 0.03em;
  }

  .engine-tile__desc {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.45;
    color: #888;
  }

  .engine-matrix-footer-bar {
    padding: 8px 12px;
    background: #141414;
    border: 1px solid #282828;
    font-family: var(--font-mono);
    font-size: 9px;
    color: #777;
    text-align: center;
    letter-spacing: 0.04em;
  }

  .theater-hud {
    position: absolute;
    bottom: 24px;
    left: 24px;
    z-index: 10001;
    display: flex;
    gap: 16px;
    align-items: baseline;
    font-family: var(--font-mono);
  }

  .theater-hud__label {
    font-size: 11px;
    color: #666;
    letter-spacing: 0.08em;
  }

  .theater-hud__code {
    font-size: 14px;
    font-weight: 700;
    color: #FFF;
  }

  .theater-hud__hz {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-accent-industrial);
  }

  .theater-hud__phase {
    font-size: 12px;
    font-weight: 700;
    color: #AAA;
    letter-spacing: 0.05em;
  }

  /* ══════════════════════════════════════════════════════════
     MODALS (SCREENS 4 & 6)
   ══════════════════════════════════════════════════════════ */

  .modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .modal-backdrop--active {
    display: flex;
  }

  .modal-box {
    background: var(--color-bg-surface-light);
    border: 4px solid var(--color-border-heavy);
    box-shadow: var(--shadow-brutalist);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .modal-box--routing {
    width: 760px;
    max-width: 90vw;
    height: 520px;
  }

  .modal-box--bio {
    width: 500px;
    max-width: 90vw;
    height: 380px;
  }

  .modal-box--info {
    width: 840px;
    max-width: 92vw;
    height: 640px;
    max-height: 88vh;
  }

  .modal-box--hotkeys {
    width: 880px;
    max-width: 94vw;
    max-height: 88vh;
    box-shadow: 8px 8px 0px 0px #000000;
  }

  .modal-body--hotkeys {
    padding: 18px;
    overflow-y: auto;
  }

  .hotkeys-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  @media (max-width: 800px) {
    .hotkeys-grid {
      grid-template-columns: 1fr;
    }
  }

  .hotkeys-category {
    background: #141414;
    border: 1px solid #2A2A2A;
    padding: 14px 14px 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hotkeys-cat-title {
    font-size: 11px;
    font-weight: 800;
    color: var(--color-accent-industrial, #FF1433);
    letter-spacing: 0.1em;
    margin-bottom: 2px;
    border-bottom: 1px solid #222222;
    padding-bottom: 6px;
  }

  .hotkey-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
  }

  .hotkey-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 22px;
    padding: 0 6px;
    background: #242424;
    border: 1px solid #444444;
    color: #FFFFFF;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    letter-spacing: 0.05em;
    flex-shrink: 0;
    box-shadow: 1px 1px 0px #000000;
  }

  .hotkey-desc {
    color: #BBBBBB;
    font-size: 11px;
    line-height: 1.35;
  }

  .modal-box--preset-creator {
    width: 780px;
    max-width: 92vw;
    max-height: 88vh;
    box-shadow: 8px 8px 0px 0px #000000;
  }

  .modal-preset-body {
    padding: 16px;
    overflow-y: auto;
  }

  .preset-form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .preset-form-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .preset-form-field--full {
    grid-column: 1 / -1;
  }

  .preset-form-label {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    color: var(--color-text-secondary);
    letter-spacing: 0.05em;
  }

  .preset-form-input,
  .preset-form-select,
  .preset-form-textarea {
    border: 2px solid var(--color-border-heavy);
    background: var(--color-bg-concrete);
