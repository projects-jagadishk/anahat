<header data-tauri-drag-region class="titlebar">
  <!-- Brand identity on left with logo -->
  <div class="titlebar__brand" data-tauri-drag-region>
    <img src="/logo.svg" alt="ANAHAT Emblem" class="titlebar__logo" />
    <span class="titlebar__label" data-tauri-drag-region>
      ANAHAT // made with 🫨 ☕ ❤️ 🤖 by Jagadish, Kasi.
    </span>
  </div>

  <div class="titlebar__flex" data-tauri-drag-region></div>

  <!-- Hotkeys button in titlebar -->
  <button
    class="titlebar__route-btn titlebar__info-btn"
    id="btn-hotkeys"
    title="Keyboard Shortcuts & Operational Matrix (Hotkey: ? or H)"
    data-tooltip="View complete keyboard shortcuts & operational matrix (Hotkey: ? or H)"
  >
    [ ⌨ HOTKEYS ]
  </button>

  <!-- Info button in titlebar -->
  <button
    class="titlebar__route-btn titlebar__info-btn"
    id="btn-info"
    title="System Specification & Clinical Disclaimers"
    data-tooltip="System architecture, clinical protocol, and medical safety disclaimers"
  >
    [ INFO ]
  </button>

  <!-- Route Audio button in titlebar -->
  <button
    class="titlebar__route-btn"
    id="btn-route-audio"
    title="Hardware Audio Routing Matrix & DAC Selection"
    data-tooltip="Hardware Audio Patch Bay: select external USB DACs, headphones, or soundcards (Hotkey: O)"
  >
    <span id="titlebar-route-label">[ ROUTE AUDIO ]</span>
  </button>

  <!-- Window controls (Windows/Linux — hidden on macOS) -->
  <div class="titlebar__controls" id="window-controls">
    <button class="titlebar__btn" id="btn-minimize" aria-label="Minimize"
      >—</button
    >
    <button class="titlebar__btn" id="btn-maximize" aria-label="Maximize"
      >◻</button
    >
    <button
      class="titlebar__btn titlebar__btn--close"
      id="btn-close"
      aria-label="Close">✕</button
    >
  </div>
</header>

<style>
  .titlebar {
    display: flex;
    align-items: center;
    height: var(--titlebar-height);
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 0;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
  }

  .titlebar__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 14px;
    height: 100%;
    cursor: default;
    user-select: none;
    flex-shrink: 0;
  }

  .titlebar__logo {
    width: 20px;
    height: 20px;
    object-fit: contain;
    filter: drop-shadow(0 0 6px rgba(255, 20, 51, 0.65));
    pointer-events: none;
    flex-shrink: 0;
  }

  .titlebar__label {
    white-space: nowrap;
    letter-spacing: 0.08em;
    font-size: 11px;
    cursor: default;
  }

  .titlebar__flex {
    flex: 1;
  }

  .titlebar__route-btn {
    appearance: none;
    border: 1px solid var(--color-bg-surface-light);
    background: #1e1e1e;
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    padding: 4px 14px;
    margin-right: 8px;
    cursor: pointer;
    text-transform: uppercase;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .titlebar__info-btn {
    border-color: #666;
  }

  .titlebar__info-btn:hover {
    border-color: var(--color-bg-surface-light);
  }

  .titlebar__route-btn:hover {
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
  }

  .titlebar__route-btn--active {
    background: var(--color-accent-industrial) !important;
    color: #ffffff !important;
    border-color: var(--color-accent-industrial) !important;
  }

  .titlebar__controls {
    display: flex;
    height: 100%;
  }

  .titlebar__btn {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    width: 36px;
    height: 100%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: none;
  }

  .titlebar__btn:hover {
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
  }

  .titlebar__btn--close:hover {
    background: var(--color-accent-industrial);
    color: var(--color-bg-surface-light);
  }
</style>

<script>
  import { getCurrentWindow } from "@tauri-apps/api/window";

  const appWindow = getCurrentWindow();

  // Detect macOS — hide custom window controls (traffic lights are native)
  const isMacOS = navigator.userAgent.includes("Macintosh");
  const controlsEl = document.getElementById("window-controls");
  if (isMacOS && controlsEl) {
    controlsEl.style.display = "none";
  }

  document.getElementById("btn-minimize")?.addEventListener("click", () => {
    appWindow.minimize();
  });

  document
    .getElementById("btn-maximize")
    ?.addEventListener("click", async () => {
      const isMaximized = await appWindow.isMaximized();
      if (isMaximized) {
        appWindow.unmaximize();
      } else {
        appWindow.maximize();
      }
    });

  document.getElementById("btn-close")?.addEventListener("click", () => {
    appWindow.hide();
  });
</script>
