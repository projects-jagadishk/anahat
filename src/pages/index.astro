---
/**
 * index.astro — The Main Deck (Screen 1)
 * 1200×800 — Matches Figma Screen-1-Main-Deck specifications.
 * Fixed columns: Left 300px | Center 600px | Right 300px
 * Static rendering of presets via Astro for instant SSR, no FOUC, and perfect style scoping.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TitleBar from "../components/ui/TitleBar.astro";
import SpriteMetronome from "../components/ui/SpriteMetronome.astro";
import presetsData from "../data/presets.json";

const ERA_DISPLAY_TITLES: Record<string, string> = {
  "Ancient & Vedic": "--- [ VEDIC ] ---",
  "Sacred Solfeggio": "--- [ SOLFEGGIO ] ---",
  "Pythagorean Tuning": "--- [ PYTHAGOREAN ] ---",
  "Modern Clinical": "--- [ CLINICAL ] ---",
  "Classical Physics": "--- [ CLASSICAL PHYSICS ] ---",
};

const ERA_SORT_ORDER = [
  "Ancient & Vedic",
  "Sacred Solfeggio",
  "Pythagorean Tuning",
  "Modern Clinical",
  "Classical Physics",
];

// Group presets by era in strict order
const groupedPresets = ERA_SORT_ORDER.map((era) => ({
  era,
  title: ERA_DISPLAY_TITLES[era] || `--- [ ${era.toUpperCase()} ] ---`,
  items: presetsData.filter((p) => p.era === era),
})).filter((g) => g.items.length > 0);

// Default preset is PRE-001 (Anahata Heart)
const initialPreset = presetsData.find((p) => p.code === "PRE-001") || presetsData[0];
---

<BaseLayout title="ANAHAT // NEUROACOUSTIC DECK">
  <TitleBar />

  <main class="deck" id="main-deck">
    <!-- ═══ LEFT COLUMN: Preset Navigator (300×760) ═══ -->
    <aside class="deck__presets">
      <!-- Dark header bar -->
      <div class="deck__presets-header">
        <span class="deck__presets-title">ANAHAT V1.0 // PRESETS</span>
        <span class="deck__presets-badge">30 TONES</span>
      </div>

      <!-- Preset list: statically rendered so all styles bind directly -->
      <div class="deck__presets-list" id="preset-list">
        <!-- User Custom Specifications Section (Dynamically hydrated from localStorage) -->
        <div class="preset-group" id="user-presets-group" style="display: none;">
          <div class="preset-category">--- [ USER SPECIFICATIONS ] ---</div>
          <div id="user-presets-container"></div>
        </div>

        {groupedPresets.map((group) => (
          <div class="preset-group">
            <div class="preset-category">{group.title}</div>
            {group.items.map((preset) => {
              const isDefault = preset.code === "PRE-001" || preset.id === initialPreset.id;
              return (
                <button
                  class={`preset-item ${isDefault ? "preset-item--active" : ""}`}
                  data-preset-id={preset.id}
                  data-preset-json={JSON.stringify(preset)}
                  type="button"
                >
                  <div class="preset-item__meta">
                    <span class="preset-item__code">[{preset.code || preset.id.toUpperCase()}]</span>
                    <span class="preset-item__name">{preset.displayName || preset.name}</span>
                    <span class="preset-item__cursor terminal-blink">█</span>
                  </div>
                  <span class="preset-item__hz">{Number(preset.target_hz).toFixed(1)} Hz</span>
                </button>
              );
            })}
          </div>
        ))}
      </div>

      <!-- Action buttons & Chunky REC button at bottom -->
      <div class="deck__presets-footer">
        <div class="deck__preset-mgmt-row">
          <button class="btn-preset-mgmt" id="btn-new-preset" type="button" title="Create Custom Neuroacoustic Preset (Hotkey: P)">
            [ + NEW PRESET ]
          </button>
          <button class="btn-preset-mgmt" id="btn-import-preset" type="button" title="Import .anahat Profile">
            [ IMPORT ]
          </button>
          <input type="file" id="input-import-preset" accept=".anahat,.json" style="display: none;" />
        </div>
        <button class="btn-brutalist btn-rec" id="btn-rec" type="button">
          [ REC SESSION ]
        </button>
      </div>
    </aside>

    <!-- ═══ CENTER COLUMN (600×760) ═══ -->
    <section class="deck__center">
      <!-- WebGL Canvas (Flexible remaining height, min 240px, never pushes controls) -->
      <div class="deck__canvas-wrap" id="canvas-card">
        <!-- Recording timecode badge (Screen 5 active state) -->
        <div class="deck__rec-badge" id="rec-badge">
          <span class="deck__rec-dot terminal-blink">●</span>
          <span id="rec-timecode">REC 00:00:00:00</span>
        </div>

        <!-- Overlaid Session HUD on the Visualizer (Zero Layout Shifts in Controls) -->
        <div class="deck__canvas-hud" id="canvas-hud">
          <div class="hud-countdown" id="hud-countdown">10:00</div>
          <div class="hud-phase-badge" id="hud-phase-badge">
            <span class="hud-dot terminal-blink">●</span>
            <span id="hud-phase-label">PHASE: INHALE [ 4S ]</span>
          </div>
        </div>

        <!-- Unmissable Sine Burst Notification Banner -->
        <div class="deck__burst-banner" id="burst-banner">
          <span class="burst-banner__icon terminal-blink">⚡</span>
          <span class="burst-banner__text">INTERVAL CHIME // 528 HZ SINE BURST</span>
        </div>

        <!-- 1-Bit Sprite Container Molecule (Docked on Canvas, toggleable) -->
        <div class="deck__sprite-dock" id="sprite-dock">
          <SpriteMetronome id="metronome-cat" />
        </div>

        <!-- Dark toolbar inside canvas -->
        <div class="deck__canvas-bar">
          <div class="deck__canvas-toggles">
            <!-- Visualizer Navigator -->
            <div class="engine-navigator" id="engine-navigator">
              <button class="engine-nav-arrow" id="btn-engine-prev" type="button" title="Previous Visualizer Engine (Hotkey: [)">◀</button>
              <button class="engine-selector-btn" id="btn-engine-menu" type="button" title="Open Visualizer Engine Matrix (Hotkey: M or 1-9)">
                <span class="engine-selector__num" id="engine-display-num">01</span>
                <span class="engine-selector__name" id="engine-display-name">CHLADNI NODES</span>
                <span class="engine-selector__cat" id="engine-display-cat">[PHYSICS]</span>
                <span class="engine-selector__icon">▾</span>
              </button>
              <button class="engine-nav-arrow" id="btn-engine-next" type="button" title="Next Visualizer Engine (Hotkey: ])">▶</button>
            </div>

            <span class="deck__toggle-sep">|</span>

            <button class="deck__toggle deck__toggle--active" id="toggle-companion" type="button" title="Toggle 1-Bit Metronome Companion">
              [X] COMPANION
            </button>

            <span class="deck__toggle-sep">|</span>

            <!-- Audio Ingest Source Monitor & Meter -->
            <div class="deck__source-pill" id="deck-source-pill">
              <button class="deck__toggle" id="btn-canvas-source" type="button" title="Switch Input Source: Internal Algorithmic DSP vs External Microphone">
                <span class="source-dot" id="canvas-source-dot">●</span>
                <span id="canvas-source-label">SRC: DSP</span>
              </button>
              <div class="deck__mic-meter" id="deck-mic-meter" style="display: none;">
                <span class="meter-bar" id="mic-meter-bar">[░░░░░░░░░░]</span>
                <button class="btn-gain-step" id="btn-gain-step" type="button" title="Cycle Mic Sensitivity Gain">1.4X</button>
              </div>
            </div>

            <span class="deck__toggle-sep">|</span>

            <!-- Visualizer Style Tuning (Palette & Density Deck) -->
            <button class="deck__toggle" id="btn-palette-toggle" type="button" title="Cycle Visualizer Color Palette (Hotkey: C)">
              <span id="canvas-palette-label">PAL: [ PASTEL ]</span>
            </button>
            <button class="deck__toggle" id="btn-density-toggle" type="button" title="Cycle Geometry Density (Hotkey: D)">
              <span id="canvas-density-label">DET: [ HIGH ]</span>
            </button>
          </div>

          <button class="btn-theater" id="btn-theater" type="button">
            [ THEATER ⤢ ]
          </button>
        </div>

        <!-- Canvas render area with coordinate grid background -->
        <div class="deck__canvas" id="webgl-canvas">
          <div class="deck__canvas-grid"></div>
        </div>
      </div>

      <!-- Bottom Control Deck (Fixed height, ALWAYS 100% visible, ZERO layout shifts) -->
      <div class="deck__controls">
        <!-- Hz Display — Extreme Scale Contrast (Rock-solid static display) -->
        <div class="deck__hz-block">
          <span class="deck__hz-value" id="hz-readout">{Number(initialPreset.target_hz).toFixed(1)}</span>
          <div class="deck__hz-meta">
            <span class="deck__hz-label">HZ // MASTER RESONANCE</span>
            <span class="deck__hz-waveform" id="waveform-label">
              WAVEFORM: {(initialPreset.waveform || "sine").toUpperCase()} SINE
            </span>
          </div>
        </div>

        <!-- Harmonic Sliders row -->
        <div class="deck__slider-row">
          <div class="deck__slider-box">
            <label class="deck__slider-label" for="slider-n">
              HARMONIC N: <span id="val-n">{initialPreset.harmonic_n}</span>
            </label>
            <div class="deck__slider-track-wrap">
              <input
                type="range"
                min="1"
                max="10"
                value={initialPreset.harmonic_n}
                class="slider-brutalist"
                id="slider-n"
              />
            </div>
          </div>
          <div class="deck__slider-box">
            <label class="deck__slider-label" for="slider-m">
              HARMONIC M: <span id="val-m">{initialPreset.harmonic_m}</span>
            </label>
            <div class="deck__slider-track-wrap">
              <input
                type="range"
                min="1"
                max="10"
                value={initialPreset.harmonic_m}
                class="slider-brutalist"
                id="slider-m"
              />
            </div>
          </div>
        </div>

        <!-- V1.5 Meditation Controls: Cadence Dropdown & Timebox Selector -->
        <div class="deck__meditation-row">
          <!-- Cadence Dropdown (Atom) -->
          <div class="deck__cadence-box">
            <label class="deck__med-label" for="select-cadence">BREATH_SYNC</label>
            <div class="select-brutalist-wrap">
              <select class="select-brutalist" id="select-cadence">
                <option value="box">BREATH_SYNC // [ BOX ]</option>
                <option value="478">BREATH_SYNC // [ 4-7-8 ]</option>
                <option value="coherent">BREATH_SYNC // [ COHERENT ]</option>
                <option value="off">BREATH_SYNC // [ OFF ]</option>
              </select>
            </div>
          </div>

          <!-- Timebox Selector (Atom) -->
          <div class="deck__timebox-box">
            <span class="deck__med-label">TIMEBOX</span>
            <div class="deck__timebox-toggles" id="timebox-toggles">
              <button class="timebox-btn timebox-btn--active" data-mins="10" type="button">[ 10M ]</button>
              <button class="timebox-btn" data-mins="20" type="button">[ 20M ]</button>
              <button class="timebox-btn" data-mins="60" type="button">[ 60M ]</button>
              <button class="timebox-btn" data-mins="infinity" type="button">[ ∞ ]</button>
            </div>
          </div>

          <!-- Session Takeover Trigger Button -->
          <button class="btn-session" id="btn-session" type="button">
            [ START SESSION ⏵ ]
          </button>
        </div>

        <!-- Noise Blend Interactive Control Deck -->
        <div class="deck__noise-deck">
          <div class="deck__noise-header">
            <span class="deck__noise-label" id="noise-label">
              NOISE BLEND: {(initialPreset.noise_masking_type || "brown").toUpperCase()} // ████████░░░░ {Math.round((initialPreset.noise_blend_ratio || 0.25) * 100)}%
            </span>
            <div class="deck__noise-types" id="noise-types">
              <button class="noise-type-btn noise-type-btn--active" data-noise="brown" type="button">BROWN</button>
              <button class="noise-type-btn" data-noise="pink" type="button">PINK</button>
              <button class="noise-type-btn" data-noise="white" type="button">WHITE</button>
              <button class="noise-type-btn" data-noise="none" type="button">MUTE</button>
            </div>
          </div>
          <div class="deck__slider-track-wrap">
            <input
              type="range"
              min="0"
              max="100"
              value={Math.round((initialPreset.noise_blend_ratio || 0.25) * 100)}
              class="slider-brutalist slider-brutalist--noise"
              id="slider-noise"
              title="Noise Blend Ratio"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ RIGHT COLUMN: Provenance Spec Card (300×760) ═══ -->
    <aside class="deck__provenance">
      <div class="deck__prov-card">
        <!-- Dark header -->
        <div class="deck__prov-header">
          <span class="deck__prov-title">PROVENANCE // <span id="spec-header-id">{initialPreset.code || "PRE-001"}</span></span>
        </div>

        <!-- Spec rows — alternating bg matching Figma spec card -->
        <div class="deck__prov-specs" id="spec-rows">
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">PRESET_ID</span>
            <span class="deck__spec-val" id="spec-id">{initialPreset.code || "PRE-001"}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--odd">
            <span class="deck__spec-key">NAME</span>
            <span class="deck__spec-val" id="spec-name">{initialPreset.displayName || initialPreset.name}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">CULTURE</span>
            <span class="deck__spec-val" id="spec-era">{initialPreset.era}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--odd">
            <span class="deck__spec-key">TARGET_HZ</span>
            <span class="deck__spec-val deck__spec-val--hz" id="spec-target">{Number(initialPreset.target_hz).toFixed(2)} Hz</span>
          </div>
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">CHLADNI</span>
            <span class="deck__spec-val" id="spec-chladni">n={initialPreset.harmonic_n}, m={initialPreset.harmonic_m}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--odd">
            <span class="deck__spec-key">EVIDENCE</span>
            <span class="deck__spec-val" id="spec-evidence">{initialPreset.evidence_level}</span>
          </div>
          <div class="deck__spec-row deck__spec-row--even">
            <span class="deck__spec-key">RATING</span>
            <span class="deck__spec-val" id="spec-rating">[ ★★★★★ ]</span>
          </div>
        </div>

        <!-- Research Abstract block -->
        <div class="deck__prov-abstract" id="spec-abstract">
          <span class="deck__abstract-heading">RESEARCH ABSTRACT:</span>
          <p class="deck__abstract-body" id="spec-abstract-body">
            {initialPreset.therapeutic_use_case}
            <br/><br/>
            {initialPreset.neurological_target}
          </p>
          <p class="deck__abstract-citation" id="spec-citation">
            CITATION: {initialPreset.citation}
          </p>
        </div>

        <!-- Biometric Sync V2 button -->
        <button class="btn-biometric" id="btn-biometric" type="button">
          [ BIOMETRIC SYNC // V2 ]
        </button>

        <!-- Export Active Preset Button (.anahat Profile) -->
        <button class="btn-export-profile" id="btn-export-profile" type="button" title="Export Active Neuroacoustic Specification as .anahat Profile">
          [ EXPORT .ANAHAT PROFILE ]
        </button>
      </div>
    </aside>
  </main>

  <!-- ═══════════════════════════════════════════════════════════
       SCREEN 2: THEATER MODE OVERLAY (1920x1080 CHROMELESS)
       ═══════════════════════════════════════════════════════════ -->
  <div class="theater-overlay" id="theater-overlay">
    <button class="btn-theater-exit" id="btn-theater-exit" title="Exit Theater Mode">
      ✕
    </button>
    <!-- Theater Visualizer Navigator (Centered floating HUD with matrix launcher) -->
    <div class="theater-toolbar" id="theater-toolbar">
      <button class="theater-nav-arrow" id="theater-engine-prev" type="button" title="Previous Engine (Hotkey: [)">◀</button>
      <button class="theater-selector-btn" id="theater-engine-menu" type="button" title="Open Engine Matrix (Hotkey: M or 1-9)">
        <span class="theater-engine__num" id="theater-display-num">01</span>
        <span class="theater-engine__name" id="theater-display-name">CHLADNI NODES</span>
        <span class="theater-engine__cat" id="theater-display-cat">[PHYSICS]</span>
        <span class="theater-engine__icon">▾</span>
      </button>
      <button class="theater-nav-arrow" id="theater-engine-next" type="button" title="Next Engine (Hotkey: ])">▶</button>
      <button class="theater-nav-arrow" id="theater-btn-palette" type="button" title="Cycle Palette (Hotkey: C)" style="margin-left: 8px; width: auto; padding: 0 10px; font-size: 10px; font-weight: 700;">PAL: PASTEL</button>
      <button class="theater-nav-arrow" id="theater-btn-detail" type="button" title="Cycle Detail (Hotkey: D)" style="width: auto; padding: 0 10px; font-size: 10px; font-weight: 700;">DET: HIGH</button>
    </div>
    <div class="theater-canvas-container" id="theater-canvas"></div>
    <div class="theater-hud">
      <span class="theater-hud__label">ANAHAT // THEATER PROJECTION</span>
      <span class="theater-hud__code" id="theater-code">{initialPreset.code || "PRE-001"}</span>
      <span class="theater-hud__hz" id="theater-hz">{Number(initialPreset.target_hz).toFixed(1)} HZ</span>
      <span class="theater-hud__phase" id="theater-phase">CADENCE: IDLE</span>
      <span class="theater-hud__source" id="theater-source">SRC: DSP</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       SCREEN: CUSTOM PRESET SPEC-BUILDER (.ANAHAT SPECIFICATION)
       ═══════════════════════════════════════════════════════════ -->
  <div class="modal-backdrop" id="modal-new-preset">
    <div class="modal-box modal-box--preset-creator">
      <div class="modal-header">
        <span>CUSTOM NEUROACOUSTIC PRESET // SPEC-BUILDER</span>
        <button class="modal-close-btn" id="btn-close-new-preset">✕</button>
      </div>
      <div class="modal-body modal-preset-body">
        <div class="preset-form-grid">
          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-code">PRESET CODE</label>
            <input class="preset-form-input" id="inp-preset-code" type="text" value="USR-001" placeholder="USR-001" />
          </div>
          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-name">PRESET TITLE / CLINICAL NAME</label>
            <input class="preset-form-input" id="inp-preset-name" type="text" placeholder="Deep Alpha Coherence" />
          </div>

          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-target">TARGET BEAT HZ</label>
            <input class="preset-form-input" id="inp-preset-target" type="number" step="0.1" value="10.0" />
          </div>
          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-carrier">CARRIER HZ</label>
            <input class="preset-form-input" id="inp-preset-carrier" type="number" step="0.5" value="216.0" />
          </div>
          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-offset">BINAURAL OFFSET HZ</label>
            <input class="preset-form-input" id="inp-preset-offset" type="number" step="0.1" value="10.0" />
          </div>

          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-waveform">WAVEFORM ARCHITECTURE</label>
            <select class="preset-form-select" id="inp-preset-waveform">
              <option value="binaural">Binaural Phase Shift</option>
              <option value="sine">Pure Monophonic Sine</option>
              <option value="isochronic">Isochronic Pulse</option>
            </select>
          </div>

          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-n">CHLADNI HARMONIC N (1-12)</label>
            <input class="preset-form-input" id="inp-preset-n" type="number" min="1" max="12" value="3" />
          </div>
          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-m">CHLADNI HARMONIC M (1-12)</label>
            <input class="preset-form-input" id="inp-preset-m" type="number" min="1" max="12" value="4" />
          </div>

          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-noise">STOCHASTIC NOISE MASKING</label>
            <select class="preset-form-select" id="inp-preset-noise">
              <option value="brown">Brown Noise (1/f² 6dB/oct Leaky)</option>
              <option value="pink">Pink Noise (1/f Voss-McCartney)</option>
              <option value="white">White Noise (Flat Spectral Density)</option>
              <option value="none">Muted / Disabled</option>
            </select>
          </div>
          <div class="preset-form-field">
            <label class="preset-form-label" for="inp-preset-noise-ratio">NOISE BLEND RATIO (0-100%)</label>
            <input class="preset-form-input" id="inp-preset-noise-ratio" type="number" min="0" max="100" value="25" />
          </div>

          <div class="preset-form-field preset-form-field--full">
            <label class="preset-form-label" for="inp-preset-abstract">RESEARCH ABSTRACT & CLINICAL INTENT</label>
            <textarea class="preset-form-textarea" id="inp-preset-abstract" rows="2" placeholder="Sensory gating and parietal alpha entrainment protocol for deep restorative focus."></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer modal-footer--flex">
        <button class="btn-brutalist btn-brutalist--sm" id="btn-save-preset">
          [ SAVE & ACTIVATE ]
        </button>
        <button class="btn-brutalist btn-brutalist--sm" id="btn-export-from-modal">
          [ EXPORT .ANAHAT ]
        </button>
        <button class="btn-brutalist btn-brutalist--sm" id="btn-cancel-new-preset">
          [ CANCEL ]
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       SCREEN 4: AUDIO ROUTING MATRIX MODAL (800x600 OVERLAY)
       ═══════════════════════════════════════════════════════════ -->
  <div class="modal-backdrop" id="modal-routing">
    <div class="modal-box modal-box--routing">
      <div class="modal-header">
        <span>AUDIO ROUTING MATRIX // HARDWARE I/O</span>
        <button class="modal-close-btn" id="btn-close-routing">✕</button>
      </div>
      <div class="modal-body modal-grid-2">
        <div class="modal-col">
          <span class="modal-subheading">PHYSICAL AUDIO OUTPUT:</span>
          <div class="brutalist-select-box" id="routing-output-devices">
            <div class="brutalist-select-item brutalist-select-item--active">[X] DEFAULT SYSTEM OUTPUT (DAC)</div>
          </div>
          <div class="modal-spec-text" id="routing-output-status" style="margin-top: 6px; color: var(--color-red, #ff3333); font-weight: 700; letter-spacing: 0.05em;">
            ACTIVE SINK: DEFAULT SYSTEM OUTPUT (DAC)
          </div>

          <span class="modal-subheading" style="margin-top: 16px;">ACOUSTIC INGEST SOURCE:</span>
          <div class="brutalist-select-box" id="routing-source-select">
            <div class="brutalist-select-item brutalist-select-item--active" id="routing-src-dsp" data-src="internal_dsp">[X] INTERNAL ALGORITHMIC DSP</div>
