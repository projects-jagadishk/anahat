  // ═══════════════════════════════════════════════════════════
  // V1.5 MEDITATION: TIMEBOX, CADENCE & SCREEN 7 TAKEOVER
  // ═══════════════════════════════════════════════════════════

  function formatCountdown(sec: number): string {
    if (sec === Infinity) return "∞ // FLOW";
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
  }

  function wireMeditationSession() {
    const mainDeck = document.getElementById("main-deck");
    const btnSession = document.getElementById("btn-session");
    const selectCadence = document.getElementById("select-cadence") as HTMLSelectElement;
    const btnCadenceToggle = document.getElementById("btn-cadence-toggle");
    const cadenceToggleLabel = document.getElementById("cadence-toggle-label");
    const btnChimeToggle = document.getElementById("btn-chime-toggle");
    const chimeStatusLabel = document.getElementById("chime-status-label");
    const medCadenceBadge = document.getElementById("med-cadence-badge");
    const timeboxButtons = document.querySelectorAll<HTMLButtonElement>(".timebox-btn");
    const hudCountdown = document.getElementById("hud-countdown");
    const hudPhaseLabel = document.getElementById("hud-phase-label");
    const canvasCard = document.getElementById("canvas-card");

    // Breath Cadence Guidance Toast DOM references (Main Deck + Theater Mode)
    const cadenceToast = document.getElementById("cadence-toast");
    const cadenceToastPhase = document.getElementById("cadence-toast-phase");
    const cadenceToastText = document.getElementById("cadence-toast-text");

    const theaterCadenceToast = document.getElementById("theater-cadence-toast");
    const theaterToastPhase = document.getElementById("theater-toast-phase");
    const theaterToastText = document.getElementById("theater-toast-text");

    function updateCadenceToast(phase: string, durationSec: number) {
      if (!isAppVisible) return; // Prevent layout thrashing & forced reflows when backgrounded
      if (activeCadence === "off" || phase === "idle") {
        cadenceToast?.classList.remove("deck__cadence-toast--active");
        theaterCadenceToast?.classList.remove("theater__cadence-toast--active");
        return;
      }

      cadenceToast?.classList.add("deck__cadence-toast--active");
      theaterCadenceToast?.classList.add("theater__cadence-toast--active");

      // Trigger pop transition
      cadenceToast?.classList.remove("cadence-toast--pop");
      theaterCadenceToast?.classList.remove("cadence-toast--pop");
      void cadenceToast?.offsetWidth;
      void theaterCadenceToast?.offsetWidth;
      cadenceToast?.classList.add("cadence-toast--pop");
      theaterCadenceToast?.classList.add("cadence-toast--pop");

      let badgeLabel = phase.toUpperCase();
      let badgeModifier = "cadence-toast__badge--inhale";
      let message = `BREATHE IN // ${durationSec}S`;

      if (activeCadence === "box") {
        switch (phase) {
          case "inhale":
            badgeLabel = "INHALE";
            badgeModifier = "cadence-toast__badge--inhale";
            message = `BREATHE IN // ${durationSec}S`;
            break;
          case "hold-in":
            badgeLabel = "HOLD FULL";
            badgeModifier = "cadence-toast__badge--hold";
            message = `HOLD BREATH // ${durationSec}S`;
            break;
          case "exhale":
            badgeLabel = "EXHALE";
            badgeModifier = "cadence-toast__badge--exhale";
            message = `BREATHE OUT // ${durationSec}S`;
            break;
          case "hold-out":
            badgeLabel = "HOLD EMPTY";
            badgeModifier = "cadence-toast__badge--empty";
            message = `HOLD EMPTY // ${durationSec}S`;
            break;
        }
      } else if (activeCadence === "478") {
        switch (phase) {
          case "inhale":
            badgeLabel = "INHALE";
            badgeModifier = "cadence-toast__badge--inhale";
            message = `INHALE NOSE // ${durationSec}S`;
            break;
          case "hold-in":
            badgeLabel = "HOLD";
            badgeModifier = "cadence-toast__badge--hold";
            message = `HOLD GENTLY // ${durationSec}S`;
            break;
          case "exhale":
            badgeLabel = "EXHALE";
            badgeModifier = "cadence-toast__badge--exhale";
            message = `EXHALE MOUTH // ${durationSec}S`;
            break;
        }
      } else if (activeCadence === "coherent") {
        switch (phase) {
          case "inhale":
            badgeLabel = "INHALE";
            badgeModifier = "cadence-toast__badge--inhale";
            message = `SLOW INHALE // ${durationSec}S`;
            break;
          case "exhale":
            badgeLabel = "EXHALE";
            badgeModifier = "cadence-toast__badge--exhale";
            message = `SLOW EXHALE // ${durationSec}S`;
            break;
        }
      } else {
        if (phase === "inhale") {
          badgeLabel = "INHALE";
          badgeModifier = "cadence-toast__badge--inhale";
          message = `BREATHE IN // ${durationSec}S`;
        } else if (phase === "hold-in") {
          badgeLabel = "HOLD FULL";
          badgeModifier = "cadence-toast__badge--hold";
          message = `HOLD BREATH // ${durationSec}S`;
        } else if (phase === "exhale") {
          badgeLabel = "EXHALE";
          badgeModifier = "cadence-toast__badge--exhale";
          message = `BREATHE OUT // ${durationSec}S`;
        } else if (phase === "hold-out") {
          badgeLabel = "HOLD EMPTY";
          badgeModifier = "cadence-toast__badge--empty";
          message = `HOLD EMPTY // ${durationSec}S`;
        }
      }

      const allBadges = [
        "cadence-toast__badge--inhale",
        "cadence-toast__badge--hold",
        "cadence-toast__badge--exhale",
        "cadence-toast__badge--empty",
      ];

      if (cadenceToastPhase) {
        cadenceToastPhase.classList.remove(...allBadges);
        cadenceToastPhase.classList.add(badgeModifier);
        cadenceToastPhase.textContent = badgeLabel;
      }
      if (theaterToastPhase) {
        theaterToastPhase.classList.remove(...allBadges);
        theaterToastPhase.classList.add(badgeModifier);
        theaterToastPhase.textContent = badgeLabel;
      }
      if (cadenceToastText) {
        cadenceToastText.textContent = message;
      }
      if (theaterToastText) {
        theaterToastText.textContent = message;
      }
    }

    function syncChimeToggleUI() {
      const enabled = audioEngine.isChimesEnabled();
      if (btnChimeToggle) {
        btnChimeToggle.classList.toggle("chime-toggle-btn--active", enabled);
      }
      if (chimeStatusLabel) {
        chimeStatusLabel.textContent = enabled ? "🔔 CHIMES: ON" : "🔕 CHIMES: OFF";
      }
    }

    function syncCadenceBadge() {
      if (!medCadenceBadge) return;
      if (activeCadence === "off") {
        medCadenceBadge.textContent = "OFF";
        medCadenceBadge.classList.remove("deck__med-badge--active");
      } else {
        const labels: Record<string, string> = {
          box: "BOX [4-4-4-4]",
          "478": "4-7-8 RELAX",
          coherent: "COHERENT [5-5]",
        };
        medCadenceBadge.textContent = labels[activeCadence] || activeCadence.toUpperCase();
        medCadenceBadge.classList.add("deck__med-badge--active");
      }
    }

    function syncCadenceUI() {
      const isOff = activeCadence === "off";
      if (btnCadenceToggle) {
        btnCadenceToggle.classList.toggle("cadence-toggle-switch--active", !isOff);
      }
      if (cadenceToggleLabel) {
        cadenceToggleLabel.textContent = isOff ? "SYNC: OFF" : "SYNC: ON";
      }
      if (selectCadence) {
        selectCadence.value = activeCadence;
      }
      syncCadenceBadge();
      if (isOff) {
        updateCadenceToast("idle", 0);
      }
    }

    // Direct Breath Sync Toggle Switch click handler
    btnCadenceToggle?.addEventListener("click", () => {
      if (activeCadence === "off") {
        activeCadence = lastActiveCadence || "box";
      } else {
        lastActiveCadence = activeCadence;
        activeCadence = "off";
      }
      cadenceController.applyCadence(activeCadence);
      syncCadenceUI();
      if (hudPhaseLabel) {
        hudPhaseLabel.textContent = activeCadence === "off" ? "PHASE: OFF" : "PHASE: IDLE";
      }
      const theaterPhase = document.getElementById("theater-phase");
      if (theaterPhase) {
        theaterPhase.textContent = activeCadence === "off" ? "CADENCE: OFF" : "CADENCE: IDLE";
      }
      if (activeCadence === "off") {
        updateCadenceToast("idle", 0);
      }
    });

    btnChimeToggle?.addEventListener("click", () => {
      const isNowOn = audioEngine.toggleChimes();
      syncChimeToggleUI();
      if (isNowOn) {
        audioEngine.playCadenceChime("inhale");
      }
    });

    syncChimeToggleUI();
    syncCadenceUI();

    // Init Breath Cadence Controller (Synchronizes visualizer breathing and session intervals)
    cadenceController.init();

    // Connect Breath Phase callback to Visualizer & Interval Chimes (no pulsating circular animation)
    cadenceController.setPhaseCallback((phase, durationSec) => {
      visualizer?.setBreathPhase(phase, durationSec);
      theaterVisualizer?.setBreathPhase(phase, durationSec);

      if (hudPhaseLabel) {
        hudPhaseLabel.textContent = activeCadence === "off" ? "PHASE: OFF" : `PHASE: ${phase.toUpperCase()} [ ${durationSec}S ]`;
      }
      const theaterPhase = document.getElementById("theater-phase");
      if (theaterPhase) {
        theaterPhase.textContent = activeCadence === "off" ? "CADENCE: OFF" : `CADENCE: ${phase.toUpperCase()} [ ${durationSec}S ]`;
      }

      // Interval Chime on breath phase shift
      if (activeCadence !== "off") {
        audioEngine.playCadenceChime(phase);
        updateCadenceToast(phase, durationSec);
      } else {
        updateCadenceToast("idle", 0);
      }
    });

    // Audio Engine chime listener (pure audio, zero circular pulsation)
    audioEngine.onChime(() => {
      // Audio chime plays cleanly without visual pulsation
    });

    // Cadence Select dropdown
    selectCadence?.addEventListener("change", () => {
      activeCadence = selectCadence.value as CadenceType;
      if (activeCadence !== "off") {
        lastActiveCadence = activeCadence;
      }
      cadenceController.applyCadence(activeCadence);
      syncCadenceUI();
      if (hudPhaseLabel) {
        hudPhaseLabel.textContent = activeCadence === "off" ? "PHASE: OFF" : "PHASE: IDLE";
      }
      const theaterPhase = document.getElementById("theater-phase");
      if (theaterPhase) {
        theaterPhase.textContent = activeCadence === "off" ? "CADENCE: OFF" : "CADENCE: IDLE";
      }
      if (activeCadence === "off") {
        updateCadenceToast("idle", 0);
      }
    });

    // Timebox Toggles
    timeboxButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        timeboxButtons.forEach((b) => b.classList.remove("timebox-btn--active"));
        btn.classList.add("timebox-btn--active");

        const mins = btn.dataset.mins;
        if (mins === "infinity") {
          sessionMinutes = Infinity;
          sessionSecondsRemaining = Infinity;
        } else {
          sessionMinutes = parseInt(mins || "10", 10);
          sessionSecondsRemaining = sessionMinutes * 60;
        }

        if (hudCountdown) {
          hudCountdown.textContent = formatCountdown(sessionSecondsRemaining);
        }
      });
    });

    function endSession() {
      isSessionActive = false;
      mainDeck?.classList.remove("deck--screen7");
      if (btnSession) {
        btnSession.textContent = "[ START SESSION ⏵ ]";
        btnSession.classList.remove("btn-session--active");
      }
      if (sessionInterval) {
        clearInterval(sessionInterval);
        sessionInterval = null;
      }
      visualizer?.setBreathPhase("idle");
      theaterVisualizer?.setBreathPhase("idle");
      const theaterPhase = document.getElementById("theater-phase");
      if (theaterPhase) {
        theaterPhase.textContent = "CADENCE: IDLE";
      }
      updateCadenceToast("idle", 0);

      setTimeout(() => {
        (visualizer as any)?.handleResize?.();
      }, 50);
    }

    // Session Start / End Button (Screen 7 Takeover)
    btnSession?.addEventListener("click", () => {
      isSessionActive = !isSessionActive;

      if (isSessionActive) {
        // Activate Screen 7
        mainDeck?.classList.add("deck--screen7");
        btnSession.textContent = "[ END SESSION ⏹ ]";
        btnSession.classList.add("btn-session--active");

        // Set initial countdown
        if (sessionMinutes === Infinity) {
          sessionSecondsRemaining = Infinity;
        } else {
          sessionSecondsRemaining = sessionMinutes * 60;
        }
        if (hudCountdown) {
          hudCountdown.textContent = formatCountdown(sessionSecondsRemaining);
        }

        // Trigger rich sine chime on start
        audioEngine.playIntervalChime(528);

        // Start countdown timer
        sessionInterval = setInterval(() => {
          if (sessionSecondsRemaining !== Infinity) {
            sessionSecondsRemaining--;
            if (hudCountdown) {
              hudCountdown.textContent = formatCountdown(sessionSecondsRemaining);
            }

            if (sessionSecondsRemaining <= 0) {
              clearInterval(sessionInterval);
              sessionInterval = null;
              audioEngine.playIntervalChime(528);
              endSession();
            }
          }
        }, 1000);

        // Force visualizer to adapt to expanded canvas
        setTimeout(() => {
          (visualizer as any)?.handleResize?.();
        }, 50);
      } else {
        endSession();
      }
    });
  }

  // ═══════════════════════════════════════════════════════════
  // ACOUSTIC INGEST (MIC INGEST / INTERNAL DSP SWITCHER)
  // ═══════════════════════════════════════════════════════════

  function wireInputSource() {
    const btnSrcDsp = document.getElementById("btn-src-dsp");
    const btnSrcMic = document.getElementById("btn-src-mic");
    const theaterSource = document.getElementById("theater-source");

    const routingSrcDsp = document.getElementById("routing-src-dsp");
    const routingSrcMic = document.getElementById("routing-src-mic");

    const btnToggleCanvasExpand = document.getElementById("btn-toggle-canvas-expand");
    const btnRestoreDeck = document.getElementById("btn-restore-deck");
    const telemetryMeterBar = document.getElementById("telemetry-meter-bar");

    const syncSourceUI = (mode: AudioSourceMode) => {
      const isMic = mode === "mic_ingest";

      // Segmented Source Switcher (Zero layout shift, directly above visualizer)
      if (btnSrcDsp && btnSrcMic) {
        if (isMic) {
          btnSrcDsp.classList.remove("source-seg-btn--active");
          btnSrcMic.classList.add("source-seg-btn--active", "source-seg-btn--mic-active");
        } else {
          btnSrcDsp.classList.add("source-seg-btn--active");
          btnSrcMic.classList.remove("source-seg-btn--active", "source-seg-btn--mic-active");
        }
      }

      // Adaptive deck layout: mic ingest automatically collapses bottom controls to maximize canvas real estate
      // When returning to internal DSP, un-collapse unless user explicitly maximized
      if (isMic) {
        setCanvasMaximized(true);
      } else {
        setCanvasMaximized(false);
      }

      // Theater HUD indicator
      if (theaterSource) {
        theaterSource.textContent = isMic ? "SRC: MIC INGEST [LIVE]" : "SRC: INTERNAL DSP";
        theaterSource.style.color = isMic ? "var(--color-accent-industrial)" : "#AAA";
      }

      // Routing Modal
      if (routingSrcDsp && routingSrcMic) {
        if (isMic) {
          routingSrcDsp.textContent = "[ ] INTERNAL ALGORITHMIC DSP";
          routingSrcDsp.classList.remove("brutalist-select-item--active");
          routingSrcMic.textContent = "[X] LIVE MICROPHONE / SYSTEM INGEST";
          routingSrcMic.classList.add("brutalist-select-item--active");
        } else {
          routingSrcDsp.textContent = "[X] INTERNAL ALGORITHMIC DSP";
          routingSrcDsp.classList.add("brutalist-select-item--active");
          routingSrcMic.textContent = "[ ] LIVE MICROPHONE / SYSTEM INGEST";
          routingSrcMic.classList.remove("brutalist-select-item--active");
        }
      }
    };

    btnSrcDsp?.addEventListener("click", () => {
      if (audioEngine.getSourceMode() !== "internal_dsp") {
        audioEngine.disableMicIngest();
        syncSourceUI("internal_dsp");
      }
    });

    btnSrcMic?.addEventListener("click", async () => {
      if (audioEngine.getSourceMode() !== "mic_ingest") {
        const ok = await audioEngine.enableMicIngest();
        syncSourceUI(ok ? "mic_ingest" : "internal_dsp");
      }
    });

    routingSrcDsp?.addEventListener("click", () => {
      if (audioEngine.getSourceMode() !== "internal_dsp") {
        audioEngine.disableMicIngest();
        syncSourceUI("internal_dsp");
      }
    });

    routingSrcMic?.addEventListener("click", async () => {
      if (audioEngine.getSourceMode() !== "mic_ingest") {
        const ok = await audioEngine.enableMicIngest();
        syncSourceUI(ok ? "mic_ingest" : "internal_dsp");
      }
    });

    // Expand / collapse deck buttons
    btnToggleCanvasExpand?.addEventListener("click", toggleCanvasMaximize);
    btnRestoreDeck?.addEventListener("click", () => setCanvasMaximized(false));

    // Audio Engine state listener
    audioEngine.onSourceModeChange(syncSourceUI);

    // Initial state sync
    syncSourceUI(audioEngine.getSourceMode());

    // Managed Input Level Meter RAF Loop (throttles when backgrounded)
    scheduleMeterUpdate();
  }

  // ═══════════════════════════════════════════════════════════
  // HARDWARE OUTPUT ROUTING (DAC / Device Switcher)
  // ═══════════════════════════════════════════════════════════

  function wireAudioRouting() {
    const routingContainer = document.getElementById("routing-output-devices");
    const routingStatus = document.getElementById("routing-output-status");
    const titlebarRouteLabel = document.getElementById("titlebar-route-label");
    const btnRoute = document.getElementById("btn-route-audio");

    let isRefreshing = false;

    const refreshOutputDevices = async () => {
      if (!routingContainer || isRefreshing) return;
      isRefreshing = true;

      try {
        const devices = await audioEngine.listOutputDevices();
        const currentActive = audioEngine.getActiveOutputDevice();

        routingContainer.innerHTML = "";
        devices.forEach((dev) => {
          const item = document.createElement("div");
          const isActive = dev.name === currentActive || (currentActive === "Default System Output" && dev.is_default);
          item.className = `brutalist-select-item ${isActive ? "brutalist-select-item--active" : ""}`;
          item.textContent = `[${isActive ? "X" : " "}] ${dev.name.toUpperCase()}`;
          item.dataset.deviceName = dev.name;

          item.addEventListener("click", async () => {
            if (routingStatus) {
              routingStatus.textContent = `SWITCHING TO: ${dev.name.toUpperCase()}...`;
            }
            // Update selection immediately in UI
            routingContainer.querySelectorAll(".brutalist-select-item").forEach((el) => {
              el.classList.remove("brutalist-select-item--active");
              const text = el.textContent || "";
              el.textContent = text.replace("[X]", "[ ]");
            });
            item.classList.add("brutalist-select-item--active");
            item.textContent = `[X] ${dev.name.toUpperCase()}`;

            await audioEngine.setOutputDevice(dev.name);
            await refreshOutputDevices();
          });

          routingContainer.appendChild(item);
        });

        if (routingStatus) {
          routingStatus.textContent = `ACTIVE SINK: ${currentActive.toUpperCase()}`;
        }

        if (titlebarRouteLabel) {
          const shortName = currentActive.length > 15 ? currentActive.substring(0, 13) + ".." : currentActive;
          titlebarRouteLabel.textContent = `OUT: [ ${shortName.toUpperCase()} ]`;
        }
      } catch (err) {
        console.warn("[wireAudioRouting] Failed to refresh audio output devices:", err);
      } finally {
        isRefreshing = false;
      }
    };

    btnRoute?.addEventListener("click", () => {
      refreshOutputDevices();
    });

    audioEngine.onOutputDeviceChange((devName) => {
      if (routingStatus) {
        routingStatus.textContent = `ACTIVE SINK: ${devName.toUpperCase()}`;
      }
      if (titlebarRouteLabel) {
        const shortName = devName.length > 15 ? devName.substring(0, 13) + ".." : devName;
        titlebarRouteLabel.textContent = `OUT: [ ${shortName.toUpperCase()} ]`;
      }
    });

    // Populate initial device list
    refreshOutputDevices();
  }

  // ═══════════════════════════════════════════════════════════
  // USER PRESETS & .ANAHAT PROFILE SYSTEM (Option 3)
  // ═══════════════════════════════════════════════════════════

  const STORAGE_KEY = "anahat_user_presets";
  let userPresets: any[] = [];

  function loadUserPresets(): any[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) return parsed.slice(0, 50);
      }
    } catch (e) {
      console.warn("[UserPresets] Failed to load presets:", e);
    }
    return [];
  }

  function saveUserPresets(presets: any[]): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(presets.slice(0, 50)));
    } catch (e) {
      console.error("[UserPresets] Failed to save presets:", e);
    }
  }

  function exportPresetAsAnahat(preset: any): void {
    if (!preset) return;
    const payload = {
      anahat_signature: "ANAHAT_NEUROACOUSTIC_PROFILE_V1",
      exported_at: new Date().toISOString(),
      preset: preset,
    };
    const jsonStr = JSON.stringify(payload, null, 2);
    const blob = new Blob([jsonStr], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    const codeSlug = (preset.code || "PRESET").toLowerCase().replace(/[^a-z0-9]/g, "_");
    const nameSlug = (preset.displayName || preset.name || "custom").toLowerCase().replace(/[^a-z0-9]/g, "_");
    a.href = url;
    a.download = `${codeSlug}_${nameSlug}.anahat`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function renderUserPresets(): void {
    const groupEl = document.getElementById("user-presets-group");
    const container = document.getElementById("user-presets-container");
    if (!groupEl || !container) return;

    if (userPresets.length === 0) {
      groupEl.style.display = "none";
      container.innerHTML = "";
      return;
    }

    groupEl.style.display = "flex";
    container.innerHTML = "";

    userPresets.forEach((preset, index) => {
      const btn = document.createElement("button");
      const isCurrentActive = currentPreset && (currentPreset.id === preset.id || currentPreset.code === preset.code);
      btn.className = `preset-item ${isCurrentActive ? "preset-item--active" : ""}`;
      btn.type = "button";
      btn.dataset.presetId = preset.id;
      btn.dataset.presetJson = JSON.stringify(preset);

      // DOM-constructed elements with textContent to eliminate Stored XSS
      const metaDiv = document.createElement("div");
      metaDiv.className = "preset-item__meta";

      const codeSpan = document.createElement("span");
      codeSpan.className = "preset-item__code";
      codeSpan.textContent = `[${preset.code || `USR-${index + 1}`}]`;

      const nameSpan = document.createElement("span");
      nameSpan.className = "preset-item__name";
      nameSpan.textContent = preset.displayName || preset.name || "Custom Preset";

      const cursorSpan = document.createElement("span");
      cursorSpan.className = "preset-item__cursor terminal-blink";
      cursorSpan.textContent = "█";

      metaDiv.appendChild(codeSpan);
      metaDiv.appendChild(nameSpan);
      metaDiv.appendChild(cursorSpan);

      const hzSpan = document.createElement("span");
      hzSpan.className = "preset-item__hz";
      hzSpan.textContent = `${Number(preset.target_hz || 0).toFixed(1)} Hz`;

      const actionsDiv = document.createElement("div");
      actionsDiv.className = "user-preset-actions";
      actionsDiv.addEventListener("click", (e) => e.stopPropagation());

      const expBtn = document.createElement("button");
      expBtn.className = "user-preset-btn";
      expBtn.title = "Export .anahat profile";
      expBtn.type = "button";
      expBtn.textContent = "EXP";
      expBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        exportPresetAsAnahat(preset);
      });

      const delBtn = document.createElement("button");
      delBtn.className = "user-preset-btn";
      delBtn.title = "Delete preset";
      delBtn.type = "button";
      delBtn.textContent = "✕";
      delBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (confirm(`Delete custom preset "${preset.displayName || preset.name}"?`)) {
          userPresets.splice(index, 1);
          saveUserPresets(userPresets);
          renderUserPresets();
        }
      });

      actionsDiv.appendChild(expBtn);
      actionsDiv.appendChild(delBtn);

      btn.appendChild(metaDiv);
      btn.appendChild(hzSpan);
      btn.appendChild(actionsDiv);

      btn.addEventListener("click", () => {
        selectPreset(preset, btn);
      });

      container.appendChild(btn);
    });
  }

  function openNewPresetModal(prefill?: any): void {
    if (userPresets.length >= 50) {
      alert("Maximum custom preset limit (50) reached. Delete some custom presets before creating new ones.");
      return;
    }
    const modal = document.getElementById("modal-new-preset");
    if (!modal) return;

    const inpCode = document.getElementById("inp-preset-code") as HTMLInputElement;
    const inpName = document.getElementById("inp-preset-name") as HTMLInputElement;
    const inpTarget = document.getElementById("inp-preset-target") as HTMLInputElement;
    const inpCarrier = document.getElementById("inp-preset-carrier") as HTMLInputElement;
    const inpOffset = document.getElementById("inp-preset-offset") as HTMLInputElement;
    const inpWf = document.getElementById("inp-preset-waveform") as HTMLSelectElement;
    const inpN = document.getElementById("inp-preset-n") as HTMLInputElement;
    const inpM = document.getElementById("inp-preset-m") as HTMLInputElement;
    const inpNoise = document.getElementById("inp-preset-noise") as HTMLSelectElement;
    const inpNoiseRatio = document.getElementById("inp-preset-noise-ratio") as HTMLInputElement;
    const inpAbstract = document.getElementById("inp-preset-abstract") as HTMLTextAreaElement;

    const nextCode = `USR-${String(userPresets.length + 1).padStart(3, "0")}`;
    if (inpCode) inpCode.value = prefill?.code || nextCode;
    if (inpName) inpName.value = prefill?.displayName || prefill?.name || "";
    if (inpTarget) inpTarget.value = String(prefill?.target_hz ?? 10.0);
    if (inpCarrier) inpCarrier.value = String(prefill?.carrier_hz ?? 216.0);
    if (inpOffset) inpOffset.value = String(prefill?.offset_hz ?? 10.0);
    if (inpWf) inpWf.value = prefill?.waveform || "binaural";
    if (inpN) inpN.value = String(prefill?.harmonic_n ?? 3);
    if (inpM) inpM.value = String(prefill?.harmonic_m ?? 4);
    if (inpNoise) inpNoise.value = prefill?.noise_masking_type || "brown";
    if (inpNoiseRatio) inpNoiseRatio.value = String(Math.round((prefill?.noise_blend_ratio ?? 0.25) * 100));
    if (inpAbstract) inpAbstract.value = prefill?.therapeutic_use_case || "";

    modal.classList.add("modal-backdrop--active");
  }

  function closeNewPresetModal(): void {
    document.getElementById("modal-new-preset")?.classList.remove("modal-backdrop--active");
  }

  function buildPresetFromInputs(): any {
    const inpCode = (document.getElementById("inp-preset-code") as HTMLInputElement)?.value.trim() || `USR-${userPresets.length + 1}`;
    const inpName = (document.getElementById("inp-preset-name") as HTMLInputElement)?.value.trim() || "Untitled Custom Protocol";
    const targetHz = parseFloat((document.getElementById("inp-preset-target") as HTMLInputElement)?.value || "10.0");
    const carrierHz = parseFloat((document.getElementById("inp-preset-carrier") as HTMLInputElement)?.value || "216.0");
    const offsetHz = parseFloat((document.getElementById("inp-preset-offset") as HTMLInputElement)?.value || "10.0");
    const waveform = (document.getElementById("inp-preset-waveform") as HTMLSelectElement)?.value || "binaural";
    const n = parseInt((document.getElementById("inp-preset-n") as HTMLInputElement)?.value || "3", 10);
    const m = parseInt((document.getElementById("inp-preset-m") as HTMLInputElement)?.value || "4", 10);
    const noise = (document.getElementById("inp-preset-noise") as HTMLSelectElement)?.value || "brown";
    const noiseRatio = parseInt((document.getElementById("inp-preset-noise-ratio") as HTMLInputElement)?.value || "25", 10) / 100.0;
    const abstract = (document.getElementById("inp-preset-abstract") as HTMLTextAreaElement)?.value.trim() || "User authored neuroacoustic protocol.";

    return {
      id: `usr-${Date.now()}`,
      code: inpCode,
      name: inpName,
      displayName: inpName,
      era: "User Custom",
      target_hz: targetHz,
      carrier_hz: carrierHz,
      offset_hz: offsetHz,
      harmonic_n: n,
      harmonic_m: m,
      waveform: waveform,
      noise_masking_type: noise,
      noise_blend_ratio: noiseRatio,
      neurological_target: `Acoustic frequency modulation: ${targetHz.toFixed(1)} Hz beat`,
      therapeutic_use_case: abstract,
      evidence_level: "Custom Clinical Protocol",
      evidence_rating: 5,
      citation: "User Authored Protocol // Anahat V1.0",
      doi: `LOCAL/${inpCode}`,
    };
  }

  function wirePresetCreator(): void {
    userPresets = loadUserPresets();
    renderUserPresets();

    const btnNew = document.getElementById("btn-new-preset");
    const btnImport = document.getElementById("btn-import-preset");
    const inputImport = document.getElementById("input-import-preset") as HTMLInputElement;
    const btnSave = document.getElementById("btn-save-preset");
    const btnExportModal = document.getElementById("btn-export-from-modal");
    const btnExportProv = document.getElementById("btn-export-profile");
    const dragOverlay = document.getElementById("drag-drop-overlay");

    btnNew?.addEventListener("click", () => openNewPresetModal());

    async function handleImportFile(file: File): Promise<void> {
      try {
        if (userPresets.length >= 50) {
          alert("Maximum custom preset limit (50) reached. Delete some presets before importing more.");
          return;
        }

        const text = await file.text();
        // File size guard (max 100KB for a preset profile)
        if (text.length > 102400) {
          alert("File size exceeds 100KB limit for an .anahat profile.");
          return;
        }

        const data = JSON.parse(text);
        const rawPreset = data.preset || data;
        if (!rawPreset || typeof rawPreset !== "object") {
          alert("Invalid .anahat profile file: expected a JSON object.");
          return;
        }

        const targetHz = Number(rawPreset.target_hz);
        if (!targetHz || isNaN(targetHz) || targetHz <= 0 || !rawPreset.name) {
          alert("Invalid .anahat profile file: missing valid target_hz or name.");
          return;
        }

        // Strictly typed and sanitized preset reconstruction (guards against prototype pollution & XSS)
        const codeSuffix = String(userPresets.length + 1).padStart(3, "0");
        const safeCode = rawPreset.code && typeof rawPreset.code === "string" && !userPresets.some((p) => p.code === rawPreset.code)
          ? rawPreset.code.replace(/[^a-zA-Z0-9_-]/g, "").slice(0, 16)
          : `USR-${codeSuffix}`;

        const safePreset: any = {
          id: typeof rawPreset.id === "string" ? rawPreset.id.replace(/[^a-zA-Z0-9_-]/g, "").slice(0, 64) : `custom-${Date.now()}`,
          name: String(rawPreset.name || "Custom").slice(0, 64),
          displayName: String(rawPreset.displayName || rawPreset.name || "Custom").slice(0, 64),
          code: safeCode,
          target_hz: Math.max(0.1, Math.min(22000, targetHz)),
          carrier_hz: Math.max(20, Math.min(20000, Number(rawPreset.carrier_hz) || 200)),
          offset_hz: Math.max(0, Math.min(100, Number(rawPreset.offset_hz) || 10)),
          amplitude: Math.max(0, Math.min(1.0, Number(rawPreset.amplitude) || 0.7)),
          harmonic_n: Math.max(1, Math.min(16, Math.round(Number(rawPreset.harmonic_n) || 3))),
          harmonic_m: Math.max(1, Math.min(16, Math.round(Number(rawPreset.harmonic_m) || 4))),
          waveform: ["Binaural", "Isochronic", "Monaural", "Sine"].includes(rawPreset.waveform) ? rawPreset.waveform : "Binaural",
          noise_type: ["Pink", "Brown", "White", "None"].includes(rawPreset.noise_type) ? rawPreset.noise_type : "Pink",
          noise_blend_ratio: Math.max(0, Math.min(1.0, Number(rawPreset.noise_blend_ratio) || 0.15)),
          era: "User Custom",
        };

        userPresets.push(safePreset);
        saveUserPresets(userPresets);
        renderUserPresets();

        // Select imported preset
        const container = document.getElementById("user-presets-container");
        const newlyAdded = container?.lastElementChild as HTMLElement;
        if (newlyAdded) {
          selectPreset(safePreset, newlyAdded);
        }

        const banner = document.getElementById("burst-banner");
        if (banner) {
          banner.textContent = `[ 📥 PROFILE IMPORTED: ${safePreset.displayName || safePreset.name} // ${Number(safePreset.target_hz).toFixed(1)} HZ ]`;
          banner.classList.add("deck__burst-banner--active");
          setTimeout(() => banner.classList.remove("deck__burst-banner--active"), 2200);
        }
      } catch (err) {
        console.error("Failed to parse .anahat file:", err);
        alert("Could not load file. Make sure it is a valid .anahat JSON file.");
      } finally {
        if (inputImport) inputImport.value = "";
      }
    }

    btnImport?.addEventListener("click", () => inputImport?.click());

    inputImport?.addEventListener("change", (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) handleImportFile(file);
    });

    // Window Drag-and-Drop for .anahat / .json profiles
    let dragCounter = 0;
    window.addEventListener("dragenter", (e) => {
      e.preventDefault();
      dragCounter++;
      if (dragOverlay) dragOverlay.classList.add("drag-drop-overlay--active");
    });

    window.addEventListener("dragleave", (e) => {
      e.preventDefault();
      dragCounter--;
      if (dragCounter <= 0) {
        dragCounter = 0;
        if (dragOverlay) dragOverlay.classList.remove("drag-drop-overlay--active");
      }
    });

    window.addEventListener("dragover", (e) => {
      e.preventDefault();
    });

    window.addEventListener("drop", (e) => {
      e.preventDefault();
      dragCounter = 0;
      if (dragOverlay) dragOverlay.classList.remove("drag-drop-overlay--active");
      const file = e.dataTransfer?.files?.[0];
      if (file) {
        handleImportFile(file);
      }
    });

    btnSave?.addEventListener("click", () => {
      if (userPresets.length >= 50) {
        alert("Maximum custom preset limit (50) reached. Delete some custom presets before creating new ones.");
        return;
      }
      const newPreset = buildPresetFromInputs();
      userPresets.push(newPreset);
      saveUserPresets(userPresets);
      renderUserPresets();
      closeNewPresetModal();

      const container = document.getElementById("user-presets-container");
      const newlyAdded = container?.lastElementChild as HTMLElement;
      if (newlyAdded) {
        selectPreset(newPreset, newlyAdded);
      }
    });

    btnExportModal?.addEventListener("click", () => {
      const preset = buildPresetFromInputs();
      exportPresetAsAnahat(preset);
    });

    btnExportProv?.addEventListener("click", () => {
      if (currentPreset) {
        exportPresetAsAnahat(currentPreset);
      }
    });
  }

  function resetCameraViewUI(): void {
    visualizer?.resetPerspective();
    theaterVisualizer?.resetPerspective();
  }

  function wireVisualizerStyleTuning(): void {
    const btnScaleDown = document.getElementById("btn-scale-down");
    const btnScaleUp = document.getElementById("btn-scale-up");
    const btnPaletteCycle = document.getElementById("btn-palette-cycle");
    const btnDetailCycle = document.getElementById("btn-detail-cycle");
    const btnResetPerspective = document.getElementById("btn-reset-perspective");

    const theaterBtnPalette = document.getElementById("theater-btn-palette");
    const theaterBtnDetail = document.getElementById("theater-btn-detail");
    const theaterBtnResetView = document.getElementById("theater-btn-reset-view");

    btnScaleDown?.addEventListener("click", () => setScaleIndex(currentScaleIdx - 1));
    btnScaleUp?.addEventListener("click", () => setScaleIndex(currentScaleIdx + 1));

    btnPaletteCycle?.addEventListener("click", cyclePaletteUI);
    btnDetailCycle?.addEventListener("click", cycleDetailUI);
    btnResetPerspective?.addEventListener("click", resetCameraViewUI);

    theaterBtnPalette?.addEventListener("click", cyclePaletteUI);
    theaterBtnDetail?.addEventListener("click", cycleDetailUI);
    theaterBtnResetView?.addEventListener("click", resetCameraViewUI);

    // Initial sync
    setScaleIndex(currentScaleIdx);
    syncPaletteUI("pastel");
    syncDetailUI("high");
  }

  // ═══════════════════════════════════════════════════════════
  // BRUTALIST TOOLTIP ENGINE (3-SECOND HOVER DELAY)
  // ═══════════════════════════════════════════════════════════

  function initTooltips(): void {
    const tooltipEl = document.getElementById("brutalist-tooltip");
    if (!tooltipEl) return;

    // Convert any remaining title attributes across the document to data-tooltip
    // and remove title to prevent double / conflicting browser-native OS tooltips
    document.querySelectorAll("[title]").forEach((el) => {
      const titleVal = el.getAttribute("title");
      if (titleVal && !el.getAttribute("data-tooltip")) {
        el.setAttribute("data-tooltip", titleVal);
      }
      el.removeAttribute("title");
    });

    let hoverTimer: number | null = null;
    let activeTarget: HTMLElement | null = null;

    function hideTooltip(): void {
      if (hoverTimer !== null) {
        window.clearTimeout(hoverTimer);
        hoverTimer = null;
      }
      activeTarget = null;
      if (tooltipEl) {
        tooltipEl.classList.remove("brutalist-tooltip--visible");
        tooltipEl.setAttribute("aria-hidden", "true");
      }
    }

    function showTooltip(el: HTMLElement): void {
      if (!tooltipEl) return;
      const text = el.getAttribute("data-tooltip");
      if (!text) return;

      tooltipEl.textContent = text;
      tooltipEl.setAttribute("aria-hidden", "false");
      tooltipEl.classList.add("brutalist-tooltip--visible");

      // Compute positioned coordinates relative to target element
      const rect = el.getBoundingClientRect();
      const tipWidth = tooltipEl.offsetWidth || 220;
      const tipHeight = tooltipEl.offsetHeight || 34;

      let top = rect.bottom + 6;
      let left = rect.left;

      // Invert to top if overflowing bottom edge
      if (top + tipHeight > window.innerHeight - 8) {
        top = Math.max(8, rect.top - tipHeight - 6);
      }

      // Clamp horizontally within viewport
      if (left + tipWidth > window.innerWidth - 8) {
        left = Math.max(8, window.innerWidth - tipWidth - 8);
      }
      if (left < 8) left = 8;

      tooltipEl.style.top = `${Math.round(top)}px`;
      tooltipEl.style.left = `${Math.round(left)}px`;
    }

    document.addEventListener("pointerover", (e: PointerEvent) => {
      const target = (e.target as HTMLElement | null)?.closest("[data-tooltip]") as HTMLElement | null;
      if (!target) {
        hideTooltip();
        return;
      }

      if (target !== activeTarget) {
        hideTooltip();
        activeTarget = target;
        // User directive: show tooltip when cursor hovers for more than 3 seconds (3000ms)
        hoverTimer = window.setTimeout(() => {
          if (activeTarget === target) {
            showTooltip(target);
          }
        }, 3000);
      }
    }, { passive: true });

    document.addEventListener("pointerout", (e: PointerEvent) => {
      const related = e.relatedTarget as HTMLElement | null;
      if (activeTarget && (!related || !activeTarget.contains(related))) {
        hideTooltip();
      }
    }, { passive: true });

    document.addEventListener("click", (e: MouseEvent) => {
      const infoTarget = (e.target as HTMLElement | null)?.closest(".deck__med-info-icon") as HTMLElement | null;
      if (infoTarget) {
        e.stopPropagation();
        activeTarget = infoTarget;
        showTooltip(infoTarget);
      }
    });

    document.addEventListener("pointerdown", (e: PointerEvent) => {
      if ((e.target as HTMLElement | null)?.closest(".deck__med-info-icon")) return;
      hideTooltip();
    }, { passive: true });
    document.addEventListener("keydown", hideTooltip, { passive: true });
    window.addEventListener("scroll", hideTooltip, { passive: true });
  }

  // ═══════════════════════════════════════════════════════════
  // SPLASH SCREEN BOOT SEQUENCE (SILENT UNTIL LOADED)
  // ═══════════════════════════════════════════════════════════

  function runSplashBootSequence(): void {
    const splashScreen = document.getElementById("splash-screen");
    const progressBar = document.getElementById("splash-progress-bar");
    const statusText = document.getElementById("splash-status-text");
    const percentText = document.getElementById("splash-percent-text");
    const skipBtn = document.getElementById("btn-skip-splash");

    if (!splashScreen) {
      audioEngine.play();
      return;
    }

    let isDismissed = false;
    const timerIds: any[] = [];

    const dismissSplash = () => {
      if (isDismissed) return;
      isDismissed = true;
      timerIds.forEach(clearTimeout);
      splashScreen.classList.add("splash-screen--fade-out");
      // App is loaded: un-mute audio and start sound synthesis now
      audioEngine.play();
      setTimeout(() => {
        splashScreen.style.display = "none";
      }, 500);
    };

    skipBtn?.addEventListener("click", dismissSplash);

    // Allow Space or Enter to skip if desired
    const handleKeySkip = (e: KeyboardEvent) => {
      if (e.key === " " || e.key === "Enter" || e.key === "Escape") {
        window.removeEventListener("keydown", handleKeySkip);
        dismissSplash();
      }
    };
    window.addEventListener("keydown", handleKeySkip);

    // 15-second multi-stage precision calibration sequence
    const stages = [
      { ms: 1200, pct: 15, text: "[01/06] ALLOCATING 48 KHZ 32-BIT DSP CIRCULAR BUFFERS..." },
      { ms: 3800, pct: 32, text: "[02/06] CALIBRATING STEREO OSCILLATOR HARMONIC SINK..." },
      { ms: 6800, pct: 50, text: "[03/06] MAPPING SACRED SOLFEGGIO & CHLADNI HARMONICS..." },
      { ms: 9800, pct: 70, text: "[04/06] COMPILING HIGH-PRECISION WEBGL CYMATIC SHADERS..." },
      { ms: 12400, pct: 88, text: "[05/06] CALIBRATING BINAURAL STEREO PHASE SEPARATION..." },
      { ms: 14200, pct: 100, text: "[06/06] SYSTEM SYNCHRONIZED // ENGAGING ACOUSTIC CANVAS" },
    ];

    stages.forEach((stage) => {
      const id = setTimeout(() => {
        if (isDismissed) return;
        if (progressBar) progressBar.style.width = `${stage.pct}%`;
        if (percentText) percentText.textContent = `${stage.pct}%`;
        if (statusText) statusText.textContent = stage.text;
      }, stage.ms);
      timerIds.push(id);
    });

    // Default duration: 15.0 seconds (15,000ms)
    const finalId = setTimeout(() => {
      window.removeEventListener("keydown", handleKeySkip);
      dismissSplash();
    }, 15000);
    timerIds.push(finalId);
  }

  // ═══════════════════════════════════════════════════════════
  // BOOT
  // ═══════════════════════════════════════════════════════════

  initVisualizer();
  wirePresetClicks();
  wireToggles();
  wireSliders();
  wireRecording();
  wireTheaterMode();
  wireModals();
  wireTrayEvents();
  wireMeditationSession();
  wireInputSource();
  wireAudioRouting();
  wirePresetCreator();
  wireVisualizerStyleTuning();
  initTooltips();
  runSplashBootSequence();
</script>
