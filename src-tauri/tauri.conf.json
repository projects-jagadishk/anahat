{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anahat",
  "version": "1.0.0",
  "identifier": "com.anahat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QUFFQ0JGQjhFNEYzQUEKUldTcTgrUzR2K3lxcU9qM2FmSFNmeHVRNEtHQzRKdElOM0JseXFmSmNLUVUvR0ZnVUV4VVFUVGsK",
      "endpoints": [
        "https://github.com/projects-jagadishk/anahat/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Anahat",
        "width": 1400,
        "height": 880,
        "minWidth": 1400,
        "minHeight": 880,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": true,
        "resizable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: https://asset.localhost; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Anahat — Neuroacoustic Deck"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
