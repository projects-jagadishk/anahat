<style>
  /* ══════════════════════════════════════════════════════════
     THE MAIN DECK — Fixed 1200×800 Figma-matched Layout
     Columns: 300px | 600px | 300px
     Layout height is constrained to 100vh - 40px (titlebar).
   ══════════════════════════════════════════════════════════ */

  .deck {
    display: grid;
    grid-template-columns: 300px 1fr 300px;
    height: calc(100vh - var(--titlebar-height));
    margin-top: var(--titlebar-height);
    background: var(--color-bg-concrete);
    overflow: hidden;
    box-sizing: border-box;
  }

  /* ── LEFT COLUMN: 300px ── */

  .deck__presets {
    display: flex;
    flex-direction: column;
    border-right: 3px solid var(--color-border-heavy);
    background: var(--color-bg-concrete);
    height: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .deck__presets-header {
    height: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    background: var(--color-bg-surface-dark);
    flex-shrink: 0;
  }

  .deck__presets-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-bg-surface-light);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .deck__presets-badge {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent-industrial);
  }

  .deck__presets-list {
    flex: 1 1 0;
    overflow-y: auto;
    padding: 10px 12px;
    min-height: 0;
  }

  .deck__presets-footer {
    padding: 12px;
    flex-shrink: 0;
    background: var(--color-bg-concrete);
  }

  /* ── PRESET LIST ITEMS (Figma Molecule: default / hover / playing blink) ── */

  .preset-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 6px;
  }

  .preset-category {
    padding: 10px 2px 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #737373;
    text-transform: uppercase;
    user-select: none;
  }

  .preset-group:first-child .preset-category {
    padding-top: 2px;
  }

  /* Base item: clean laboratory button */
  .preset-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 38px;
    min-height: 38px;
    padding: 0 10px;
    margin-bottom: 6px;
    border: 1px solid var(--color-border-heavy);
    background: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
    color: var(--color-bg-surface-dark);
    box-sizing: border-box;
    transition: none; /* Brutalist 0ms instant cuts */
    user-select: none;
    -webkit-user-select: none;
    appearance: none;
    -webkit-appearance: none;
    outline: none;
  }

  .preset-item__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-right: 8px;
    min-width: 0;
  }

  .preset-item__code {
    font-weight: 700;
    flex-shrink: 0;
  }

  .preset-item__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Blinking cursor is strictly hidden on non-active items */
  .preset-item__cursor {
    display: none !important;
    color: var(--color-accent-industrial);
    font-size: 10px;
    line-height: 1;
    margin-left: 2px;
    flex-shrink: 0;
  }

  .preset-item__hz {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    color: #737373;
    flex-shrink: 0;
  }

  /* Hover State (Figma preset-item/hover) */
  .preset-item:hover {
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
    border: 2px solid var(--color-border-heavy);
  }

  .preset-item:hover .preset-item__hz {
    color: var(--color-bg-surface-light);
  }

  /* Active / Playing State (Figma preset-item/playing) */
  .preset-item--active {
    background: var(--color-bg-surface-dark) !important;
    border: 2px solid var(--color-border-heavy) !important;
    color: var(--color-accent-industrial) !important;
  }

  .preset-item--active .preset-item__cursor {
    display: inline-block !important;
  }

  .preset-item--active .preset-item__hz {
    color: var(--color-bg-surface-light) !important;
  }

  /* Pressed tactile click */
  .preset-item:active {
    transform: translate(1px, 1px);
  }

  /* ── CENTER COLUMN: 600px ── */

  .deck__center {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 16px 20px;
    gap: 16px;
    border-right: 3px solid var(--color-border-heavy);
    box-sizing: border-box;
    overflow: hidden;
