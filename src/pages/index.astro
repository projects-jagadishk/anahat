    align-items: center;
    gap: 6px;
    border: 1px solid var(--color-accent-industrial);
  }

  .deck__rec-badge--active {
    display: flex;
  }

  .deck__rec-dot {
    color: var(--color-accent-industrial);
    font-size: 10px;
  }

  .deck__canvas-bar {
    height: 30px;
    min-height: 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    background: var(--color-bg-surface-dark);
    flex-shrink: 0;
    z-index: 5;
  }

  .deck__canvas-toggles {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Engine Navigator Widget */
  .engine-navigator {
    display: flex;
    align-items: center;
    background: #141414;
    border: 1px solid #333333;
    height: 22px;
  }

  .engine-nav-arrow {
    appearance: none;
    background: transparent;
    border: none;
    color: #888;
    font-family: var(--font-mono);
    font-size: 9px;
    width: 20px;
    height: 100%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .engine-nav-arrow:hover {
    color: #FFF;
    background: #262626;
  }

  .engine-selector-btn {
    appearance: none;
    background: transparent;
    border: none;
    border-left: 1px solid #282828;
    border-right: 1px solid #282828;
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    height: 100%;
    padding: 0 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s ease;
  }

  .engine-selector-btn:hover {
    background: #242424;
  }

  .engine-selector__num {
    color: var(--color-accent-industrial);
    font-weight: 700;
  }

  .engine-selector__name {
    color: #FFF;
    letter-spacing: 0.04em;
  }

  .engine-selector__cat {
    color: #777;
    font-size: 8px;
  }

  .engine-selector__icon {
    font-size: 8px;
    color: #888;
    margin-left: 2px;
  }

  .deck__toggle {
    appearance: none;
    border: none;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-bg-surface-light);
    cursor: pointer;
    padding: 2px 4px;
    text-transform: uppercase;
  }

  .deck__toggle:hover {
    color: var(--color-accent-industrial);
  }

  .deck__toggle--active {
    color: var(--color-accent-industrial) !important;
  }

  .deck__toggle-sep {
    color: #555;
    font-size: 9px;
  }

  .deck__source-pill {
    display: flex;
    align-items: center;
    gap: 4px;
    background: #141414;
    border: 1px solid #333333;
    height: 22px;
    padding: 0 6px;
  }

  .source-dot {
    color: #44CC44;
    font-size: 8px;
    margin-right: 3px;
  }

  .source-dot--mic {
    color: var(--color-accent-industrial) !important;
  }

  .deck__mic-meter {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .meter-bar {
    color: var(--color-accent-industrial);
    letter-spacing: -0.05em;
    font-weight: 700;
  }

  .btn-gain-step {
    appearance: none;
    border: 1px solid #444;
    background: #222;
    color: #FFF;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    padding: 1px 4px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .btn-gain-step:hover {
    border-color: var(--color-accent-industrial);
    color: var(--color-accent-industrial);
    background: #2a1515;
  }

  .theater-hud__source {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #AAA;
    background: #181818;
    padding: 3px 6px;
    border: 1px solid #333;
  }

  .btn-theater {
    appearance: none;
    border: none;
    background: var(--color-accent-industrial);
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    padding: 4px 10px;
    cursor: pointer;
    text-transform: uppercase;
  }

  .btn-theater:hover {
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
  }

  .deck__canvas {
    flex: 1 1 0;
    width: 100%;
    position: relative;
    background: var(--color-bg-surface-light);
    overflow: hidden;
  }

  .deck__canvas-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border-light) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border-light) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    opacity: 0.45;
  }

  /* Control Deck: STRICTLY LOCKED HEIGHT so sliders never get pushed off */
  .deck__controls {
    flex-shrink: 0;
    height: 308px;
    background: var(--color-bg-surface-light);
    border: 3px solid var(--color-border-heavy);
    box-shadow: var(--shadow-brutalist);
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    gap: 8px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .deck__hz-block {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-shrink: 0;
  }

  /* Overlaid Canvas HUD for Meditation Countdown (Zero layout shifts) */
  .deck__canvas-hud {
    display: none;
    position: absolute;
    top: 50px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    pointer-events: none;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .deck--screen7 .deck__canvas-hud {
    display: flex;
  }

  .hud-countdown {
    font-family: var(--font-display);
    font-size: clamp(60px, 9vw, 96px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 2.5px var(--color-border-heavy);
    text-shadow: 2px 2px 0px rgba(255, 255, 255, 0.95);
  }

  .hud-phase-badge {
    background: var(--color-bg-surface-dark);
    color: var(--color-accent-industrial);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border: 2px solid var(--color-border-heavy);
    box-shadow: 3px 3px 0 0 #000;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
  }

  .hud-dot {
    color: var(--color-accent-industrial);
    font-size: 10px;
  }

  /* Screen 7 Takeover State */
  .deck--screen7 {
    grid-template-columns: 300px 1fr 0px !important;
  }

  .deck--screen7 .deck__provenance {
    display: none !important;
  }

  /* 1-Bit Sprite Metronome Container (Docked on Canvas, toggleable) */
  .deck__sprite-dock {
    display: flex;
    position: absolute;
    top: 40px;
    left: 12px;
    z-index: 25;
  }

  .deck__sprite-dock--hidden {
    display: none !important;
  }

  /* Unmissable Sine Burst Banner */
  .deck__burst-banner {
    display: none;
    position: absolute;
    top: 36px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 30;
    background: var(--color-accent-industrial);
    color: var(--color-bg-surface-light);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 6px 16px;
    border: 2px solid var(--color-border-heavy);
    box-shadow: 4px 4px 0 0 #000;
    align-items: center;
    gap: 8px;
    text-transform: uppercase;
  }

  .deck__burst-banner--active {
    display: flex;
  }

  .burst-banner__icon {
    color: #FFF;
    font-size: 14px;
  }

  .deck__canvas-wrap--pulse {
    border-color: var(--color-accent-industrial) !important;
    box-shadow: inset 0 0 0 3px var(--color-accent-industrial), 0 0 16px rgba(255, 51, 51, 0.4);
  }

  /* Meditation Row (V1.5 Meditation) */
  .deck__meditation-row {
    display: flex;
    gap: 8px;
    align-items: center;
    background: var(--color-bg-concrete);
    border: 2px solid var(--color-border-heavy);
    padding: 5px 8px;
    flex-shrink: 0;
  }

  .deck__med-label {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #666;
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .deck__cadence-box {
    flex: 1.1;
    min-width: 0;
  }

  .select-brutalist-wrap {
    width: 100%;
  }

  .select-brutalist {
    width: 100%;
    height: 24px;
    background: var(--color-bg-surface-light);
    border: 2px solid var(--color-border-heavy);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    color: var(--color-bg-surface-dark);
    padding: 0 4px;
    text-transform: uppercase;
    outline: none;
    cursor: pointer;
  }

  .select-brutalist:focus {
    border-color: var(--color-accent-industrial);
  }

  .deck__timebox-box {
    flex: 1.3;
    min-width: 0;
  }

  .deck__timebox-toggles {
    display: flex;
    gap: 2px;
  }

  .timebox-btn {
    appearance: none;
    -webkit-appearance: none;
    background: var(--color-bg-surface-light);
    border: 1px solid var(--color-border-heavy);
    font-family: var(--font-mono);
    font-size: 7.5px;
    font-weight: 700;
    padding: 2px 4px;
    cursor: pointer;
    color: var(--color-bg-surface-dark);
    text-transform: uppercase;
  }

  .timebox-btn:hover {
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
  }

  .timebox-btn--active {
    background: var(--color-accent-industrial) !important;
    color: var(--color-bg-surface-light) !important;
    border-color: var(--color-accent-industrial) !important;
  }

  .btn-session {
    appearance: none;
    -webkit-appearance: none;
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
    border: 2px solid var(--color-border-heavy);
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    letter-spacing: -0.02em;
    cursor: pointer;
    text-transform: uppercase;
    flex-shrink: 0;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-session:hover {
    background: var(--color-accent-industrial);
  }

  .btn-session--active {
    background: var(--color-accent-industrial) !important;
    color: var(--color-bg-surface-light) !important;
  }

  .deck__hz-value {
    font-family: var(--font-display);
    font-size: clamp(52px, 8vw, 86px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: var(--color-bg-surface-dark);
  }

  .deck__hz-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 6px;
  }

  .deck__hz-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent-industrial);
    text-transform: uppercase;
  }

  .deck__hz-waveform {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: #737373;
    text-transform: uppercase;
  }

  /* Slider row — side-by-side boxes */
  .deck__slider-row {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  .deck__slider-box {
    flex: 1;
    background: var(--color-bg-concrete);
    border: 2px solid var(--color-border-heavy);
    padding: 8px 10px 10px;
  }

  .deck__slider-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }

  .deck__slider-track-wrap {
    width: 100%;
  }

  .slider-brutalist {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 4px;
    background: var(--color-border-heavy);
    outline: none;
    cursor: pointer;
    margin: 6px 0;
  }

  .slider-brutalist::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 8px;
    height: 22px;
    background: var(--color-bg-surface-dark);
    border: none;
    cursor: grab;
  }

  .slider-brutalist::-webkit-slider-thumb:active {
    cursor: grabbing;
    background: var(--color-accent-industrial);
  }

  .deck__noise-deck {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--color-bg-concrete);
    border: 2px solid var(--color-border-heavy);
    padding: 6px 10px;
    box-sizing: border-box;
    margin-top: auto;
    flex-shrink: 0;
  }

  .deck__noise-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .deck__noise-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-bg-surface-dark);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .deck__noise-types {
    display: flex;
    gap: 3px;
    flex-shrink: 0;
  }

  .noise-type-btn {
    appearance: none;
    -webkit-appearance: none;
    border: 1px solid var(--color-border-heavy);
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    padding: 2px 5px;
    cursor: pointer;
    text-transform: uppercase;
  }

  .noise-type-btn:hover {
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
  }

  .noise-type-btn--active {
    background: var(--color-bg-surface-dark) !important;
    color: var(--color-accent-industrial) !important;
    border-color: var(--color-border-heavy) !important;
  }

  /* ── RIGHT COLUMN: 300px ── */

  .deck__provenance {
    display: flex;
    flex-direction: column;
    padding: 16px 12px;
    height: 100%;
    box-sizing: border-box;
    overflow: hidden;
    background: var(--color-bg-concrete);
  }

  .deck__prov-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-bg-surface-light);
    border: 3px solid var(--color-border-heavy);
    box-shadow: var(--shadow-brutalist);
    overflow: hidden;
    box-sizing: border-box;
  }

  .deck__prov-header {
    height: 38px;
    min-height: 38px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    background: var(--color-bg-surface-dark);
    flex-shrink: 0;
  }

  .deck__prov-title {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-bg-surface-light);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .deck__prov-specs {
    flex-shrink: 0;
  }

  .deck__spec-row {
    display: flex;
    align-items: center;
    height: 24px;
    padding: 0 8px;
    border: 1px solid var(--color-border-heavy);
    margin: 0 10px;
  }

  .deck__spec-row--even {
    background: var(--color-bg-concrete);
  }

  .deck__spec-row--odd {
    background: var(--color-bg-surface-light);
  }

  .deck__spec-key {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    width: 90px;
    flex-shrink: 0;
  }

  .deck__spec-val {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .deck__spec-val--hz {
    color: var(--color-accent-industrial);
  }

  /* Research Abstract */
  .deck__prov-abstract {
    flex: 1 1 0;
    min-height: 0;
    margin: 10px;
    padding: 8px 10px;
    background: var(--color-bg-concrete);
    border: 2px solid var(--color-border-heavy);
    overflow-y: auto;
  }

  .deck__abstract-heading {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }

  .deck__abstract-body {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.45;
    margin: 0 0 8px;
  }

  .deck__abstract-citation {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.4;
    margin: 0;
    color: #737373;
  }

  /* Biometric button */
  .btn-biometric {
    appearance: none;
    height: 38px;
    margin: 10px;
    margin-top: 0;
    background: var(--color-bg-surface-dark);
    border: 2px solid var(--color-border-heavy);
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .btn-biometric:hover {
    background: var(--color-accent-industrial);
  }

  /* ── Brutalist Button Atom ── */

  .btn-brutalist {
    appearance: none;
    border: 3px solid var(--color-border-heavy);
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    padding: 12px 16px;
    cursor: pointer;
    box-shadow: var(--shadow-brutalist);
    width: 100%;
    transition: none;
  }

  .btn-brutalist:hover {
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
  }

  .btn-brutalist--sm {
    font-size: 12px;
    padding: 8px 16px;
    width: auto;
  }

  .btn-rec--recording {
    box-shadow: none !important;
    transform: translate(6px, 6px);
    background: var(--color-accent-industrial) !important;
    color: var(--color-bg-surface-light) !important;
  }

  /* ══════════════════════════════════════════════════════════
     THEATER MODE OVERLAY (SCREEN 2)
   ══════════════════════════════════════════════════════════ */

  .theater-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: #000000;
    z-index: 10000;
    overflow: hidden;
  }

  .theater-overlay--active {
    display: block;
  }

  .theater-canvas-container {
    width: 100%;
    height: 100%;
  }

  .btn-theater-exit {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 10001;
    width: 50px;
    height: 50px;
    background: #FFFFFF;
    border: 3px solid #000000;
    color: #000000;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-theater-exit:hover {
    background: var(--color-accent-industrial);
    color: #FFFFFF;
  }

  /* Theater Navigator Floating Bar */
  .theater-toolbar {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10001;
    display: flex;
    align-items: center;
    background: rgba(18, 18, 18, 0.88);
    border: 1px solid #444;
    padding: 2px;
    backdrop-filter: blur(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .theater-toolbar--faded {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-10px);
  }

  .theater-nav-arrow {
    appearance: none;
    background: transparent;
    border: none;
    color: #888;
    font-family: var(--font-mono);
    font-size: 11px;
    width: 28px;
    height: 32px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .theater-nav-arrow:hover {
    color: #FFF;
    background: #2a2a2a;
  }

  .theater-selector-btn {
    appearance: none;
    background: transparent;
    border: none;
    border-left: 1px solid #333;
    border-right: 1px solid #333;
    color: #FFF;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    height: 32px;
    padding: 0 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.15s ease;
  }

  .theater-selector-btn:hover {
    background: #262626;
  }

  .theater-engine__num {
    color: var(--color-accent-industrial);
    font-weight: 700;
  }

  .theater-engine__name {
    color: #FFF;
    letter-spacing: 0.05em;
  }

  .theater-engine__cat {
    color: #888;
    font-size: 9px;
  }

  .theater-engine__icon {
