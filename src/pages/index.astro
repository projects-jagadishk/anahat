</style>

<script>
  import {
    ChladniCanvas,
    VISUALIZER_ENGINES,
    type VisualizerMode,
    type VisualPalette,
    type GeometryDetail,
  } from "../components/logic/ChladniCanvas";
  import { audioEngine, type AudioSourceMode } from "../components/logic/AudioEngine";
  import { cadenceController, type CadenceType } from "../components/logic/CadenceController";
  import { listen } from "@tauri-apps/api/event";
  import { getCurrentWindow } from "@tauri-apps/api/window";

  const appWindow = getCurrentWindow();

  // ═══════════════════════════════════════════════════════════
  // STATE & VISUALIZER ENGINE
  // ═══════════════════════════════════════════════════════════

  let visualizer: ChladniCanvas | null = null;
  let theaterVisualizer: ChladniCanvas | null = null;
  let isRecording = false;
  let recSeconds = 0;
  let recInterval: any = null;
  let currentPreset: any = null;
  let currentNoiseType = "brown";
  let currentNoiseRatio = 0.25;

  // Lifecycle & Performance State
  let isAppVisible = true;
  let meterRafId: number | null = null;
  const unlistenFns: Array<() => void> = [];

  function pauseAllVisualizers() {
    visualizer?.pause();
    theaterVisualizer?.pause();
    if (meterRafId !== null) {
      cancelAnimationFrame(meterRafId);
      meterRafId = null;
    }
    if (!audioEngine.getIsPlaying()) {
      audioEngine.suspendAudioContext();
    }
  }

  function resumeActiveVisualizer() {
    if (!isAppVisible) return;
    if (audioEngine.getIsPlaying()) {
      audioEngine.resumeAudioContext();
    }
    const theaterOverlay = document.getElementById("theater-overlay");
    const isTheaterActive = theaterOverlay?.classList.contains("theater-overlay--active");
    if (isTheaterActive) {
      theaterVisualizer?.resume();
    } else {
      visualizer?.resume();
    }
    scheduleMeterUpdate();
  }

  function scheduleMeterUpdate() {
    if (meterRafId !== null || !isAppVisible) return;
    const telemetryMeterBar = document.getElementById("telemetry-meter-bar");
    const updateMeter = () => {
      if (!isAppVisible) {
        meterRafId = null;
        return;
      }
      if (telemetryMeterBar) {
        const isMic = audioEngine.getSourceMode() === "mic_ingest";
        const rms = isMic ? audioEngine.getRMSLevel() : (audioEngine.isPlaying() ? 0.35 : 0.0);
        const segments = 10;
        const filled = Math.min(segments, Math.max(0, Math.round(rms * 16)));
        telemetryMeterBar.textContent = `LEVEL: [${"█".repeat(filled)}${"░".repeat(segments - filled)}]`;
      }
      meterRafId = requestAnimationFrame(updateMeter);
    };
    meterRafId = requestAnimationFrame(updateMeter);
  }

  // V1.5 Meditation Session State
  let isSessionActive = false;
  let sessionMinutes = 10;
  let sessionSecondsRemaining = 600;
  let sessionInterval: any = null;
  let activeCadence: CadenceType = "off";
  let lastActiveCadence: CadenceType = "box";

  // Initialize WebGL Visualizer
  function initVisualizer() {
    const container = document.getElementById("webgl-canvas");
    if (!container) return;

    visualizer = new ChladniCanvas();
    visualizer.mount(container);
    visualizer.setAudioProvider(() => audioEngine.getRealtimeAmplitude());
    visualizer.setWaveProvider((buf) => audioEngine.getWaveformData(buf));
    visualizer.setFreqProvider((buf) => audioEngine.getFrequencyData(buf));
  }

  // ═══════════════════════════════════════════════════════════
  // PRESET SELECTION HANDLERS
  // ═══════════════════════════════════════════════════════════

  function updateNoiseDisplay() {
    const noiseEl = document.getElementById("noise-label");
    const sliderNoise = document.getElementById("slider-noise") as HTMLInputElement;

    const pct = Math.round(currentNoiseRatio * 100);
    const filled = Math.min(12, Math.max(0, Math.round(pct / 8.33)));
    const empty = 12 - filled;
    const typeLabel = currentNoiseType === "none" ? "MUTED" : currentNoiseType.toUpperCase();

    if (noiseEl) {
      noiseEl.textContent = `NOISE BLEND: ${typeLabel} // ${"█".repeat(filled)}${"░".repeat(empty)} ${pct}%`;
    }
    if (sliderNoise && sliderNoise.value !== String(pct)) {
      sliderNoise.value = String(pct);
    }

    // Update active noise type button
    document.querySelectorAll(".noise-type-btn").forEach((btn: any) => {
      if (btn.dataset.noise === currentNoiseType) {
        btn.classList.add("noise-type-btn--active");
      } else {
        btn.classList.remove("noise-type-btn--active");
      }
    });
  }

  function selectPreset(preset: any, clickedEl: HTMLElement) {
    currentPreset = preset;

    // Deselect previous & highlight current
    document.querySelectorAll(".preset-item--active").forEach((el) => {
      el.classList.remove("preset-item--active");
    });
    clickedEl.classList.add("preset-item--active");

    // Scroll active item smoothly into view if needed
    clickedEl.scrollIntoView({ block: "nearest", behavior: "auto" });

    // Sync Audio Engine (Native Rust DSP + Web Audio API Analyser)
    audioEngine.setPreset(preset);

    // Hz readout
    const hzEl = document.getElementById("hz-readout");
    if (hzEl) hzEl.textContent = Number(preset.target_hz).toFixed(1);

    const theaterHzEl = document.getElementById("theater-hz");
    if (theaterHzEl) theaterHzEl.textContent = `${Number(preset.target_hz).toFixed(1)} HZ`;
    const theaterCodeEl = document.getElementById("theater-code");
    if (theaterCodeEl) theaterCodeEl.textContent = preset.code || preset.id?.toUpperCase() || "PRE-001";

    // Waveform label
    const wfEl = document.getElementById("waveform-label");
    if (wfEl) {
      const wf = (preset.waveform || "sine").toUpperCase();
      wfEl.textContent = `WAVEFORM: ${wf}${wf === "BINAURAL" ? " SINE" : ""}`;
    }

    // Sliders
    const sliderN = document.getElementById("slider-n") as HTMLInputElement;
    const sliderM = document.getElementById("slider-m") as HTMLInputElement;
    if (sliderN) sliderN.value = String(preset.harmonic_n);
    if (sliderM) sliderM.value = String(preset.harmonic_m);
    const valN = document.getElementById("val-n");
    const valM = document.getElementById("val-m");
    if (valN) valN.textContent = String(preset.harmonic_n);
    if (valM) valM.textContent = String(preset.harmonic_m);

    // Update WebGL uniforms live
    visualizer?.updateUniforms({
      n: preset.harmonic_n,
      m: preset.harmonic_m,
    });
    theaterVisualizer?.updateUniforms({
      n: preset.harmonic_n,
      m: preset.harmonic_m,
    });

    // Sync noise state
    currentNoiseType = preset.noise_masking_type || "brown";
    currentNoiseRatio = preset.noise_blend_ratio !== undefined ? preset.noise_blend_ratio : 0.25;
    updateNoiseDisplay();

    // Provenance spec card fields
    const setField = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    const code = preset.code || preset.id.toUpperCase();
    const title = preset.displayName || preset.name;

    setField("spec-header-id", code);
    setField("spec-id", code);
    setField("spec-name", title);
    setField("spec-era", preset.era);
    setField("spec-target", `${Number(preset.target_hz).toFixed(2)} Hz`);
    setField("spec-chladni", `n=${preset.harmonic_n}, m=${preset.harmonic_m}`);
    setField("spec-evidence", preset.evidence_level || "Level 1A (RCT)");

    // Star rating
    const stars = Math.round(preset.evidence_rating || 5);
    setField("spec-rating", `[ ${"★".repeat(stars)}${"☆".repeat(Math.max(0, 5 - stars))} ]`);

    // Abstract & Citation
    setField(
      "spec-abstract-body",
      `${preset.therapeutic_use_case}\n\n${preset.neurological_target}`
    );
    setField("spec-citation", `CITATION: ${preset.citation || "Clinically Documented."}`);
  }

  function wirePresetClicks() {
    const items = document.querySelectorAll<HTMLButtonElement>(".preset-item");
    items.forEach((item) => {
      item.addEventListener("click", () => {
        const jsonStr = item.dataset.presetJson;
        if (!jsonStr) return;
        try {
          const preset = JSON.parse(jsonStr);
          selectPreset(preset, item);
        } catch (e) {
          console.error("Failed to parse preset JSON:", e);
        }
      });
    });
  }

  // ═══════════════════════════════════════════════════════════
  // VISUALIZER ENGINE SWITCHER & MATRIX (9 ENGINES)
  // ═══════════════════════════════════════════════════════════

  let currentEngineIndex = 0;

  function setModeUI(mode: VisualizerMode) {
    const meta = VISUALIZER_ENGINES.find((e) => e.id === mode) || VISUALIZER_ENGINES[0];
    currentEngineIndex = VISUALIZER_ENGINES.indexOf(meta);

    visualizer?.setMode(meta.id);
    theaterVisualizer?.setMode(meta.id);

    // Update Main Deck Navigator
    const displayNum = document.getElementById("engine-display-num");
    const displayName = document.getElementById("engine-display-name");
    const displayCat = document.getElementById("engine-display-cat");
    if (displayNum) displayNum.textContent = meta.num;
    if (displayName) displayName.textContent = meta.name;
    if (displayCat) displayCat.textContent = `[${meta.category}]`;

    // Update Theater Deck Navigator
    const theaterNum = document.getElementById("theater-display-num");
    const theaterName = document.getElementById("theater-display-name");
    const theaterCat = document.getElementById("theater-display-cat");
    if (theaterNum) theaterNum.textContent = meta.num;
    if (theaterName) theaterName.textContent = meta.name;
    if (theaterCat) theaterCat.textContent = `[${meta.category}]`;

    // Highlight active tile in Matrix modal
    document.querySelectorAll(".engine-tile").forEach((tile: any) => {
      tile.classList.toggle("engine-tile--active", tile.dataset.engine === meta.id);
    });
  }

  let isCanvasMaximized = false;

  function setCanvasMaximized(maximized: boolean) {
    isCanvasMaximized = maximized;
    const bottomDeck = document.getElementById("bottom-controls-deck");
    const expandBtnLabel = document.getElementById("expand-btn-label");
    const btnToggleExpand = document.getElementById("btn-toggle-canvas-expand");
    const telemetryModeBadge = document.getElementById("telemetry-mode-badge");

    if (bottomDeck) {
      bottomDeck.classList.toggle("deck__controls--collapsed", maximized);
    }

    if (expandBtnLabel) {
      expandBtnLabel.textContent = maximized ? "[ ⤓ SHOW CONTROLS ]" : "[ ⤢ EXPAND CANVAS ]";
    }

    if (btnToggleExpand) {
      btnToggleExpand.classList.toggle("deck__widget-btn--active", maximized);
      btnToggleExpand.setAttribute(
        "data-tooltip",
        maximized
          ? "Restore bottom synthesis control deck (Hotkey: Z)"
          : "Expand visualizer canvas and collapse bottom controls (Hotkey: Z)"
      );
    }

    if (telemetryModeBadge) {
      const isMic = audioEngine.getSourceMode() === "mic_ingest";
      telemetryModeBadge.textContent = isMic ? "SRC: LIVE MIC INGEST" : "SRC: INTERNAL DSP [MAX VISUAL]";
      telemetryModeBadge.classList.toggle("telemetry-badge--mic", isMic);
    }
  }

  function toggleCanvasMaximize() {
    setCanvasMaximized(!isCanvasMaximized);
  }

  // ═══════════════════════════════════════════════════════════
  // VISUALIZER STYLE TUNING: PALETTES, DENSITY & SCALE CONTROLS
  // ═══════════════════════════════════════════════════════════

  const PALETTE_SWATCH_COLORS: Record<VisualPalette, string> = {
    pastel: "#F561B8",
    stark: "#FF1433",
    monochrome: "#EEEEEE",
    amber_crt: "#FFB000",
    green_crt: "#33FF33",
    cyber_blue: "#00F0FF",
  };

  const SCALE_STEPS = [0.5, 0.8, 1.0, 1.4, 2.0, 3.0];
  let currentScaleIdx = 3; // 1.4X

  function setScaleIndex(idx: number) {
    currentScaleIdx = Math.max(0, Math.min(SCALE_STEPS.length - 1, idx));
    const scale = SCALE_STEPS[currentScaleIdx];
    visualizer?.setVisualGain(scale);
    theaterVisualizer?.setVisualGain(scale);
    audioEngine.setMicSensitivity(scale);

    const scaleReadout = document.getElementById("scale-readout");
    if (scaleReadout) scaleReadout.textContent = `${scale.toFixed(1)}X`;

    const telemetryGainText = document.getElementById("telemetry-gain-text");
    if (telemetryGainText) telemetryGainText.textContent = `SCALE: ${scale.toFixed(1)}X`;
  }

  function cyclePaletteUI(): void {
    if (!visualizer) return;
    const nextPalette = visualizer.cyclePalette();
    theaterVisualizer?.setPalette(nextPalette);
    syncPaletteUI(nextPalette);
  }

  function syncPaletteUI(pal: VisualPalette): void {
    const swatchDot = document.getElementById("style-swatch-dot");
    if (swatchDot) {
      swatchDot.style.color = PALETTE_SWATCH_COLORS[pal] || "#FFF";
    }

    const paletteBtnLabel = document.getElementById("palette-btn-label");
    const theaterBtnPalette = document.getElementById("theater-btn-palette");
    const nameMap: Record<VisualPalette, string> = {
      pastel: "PASTEL",
      stark: "STARK",
      monochrome: "MONO",
      amber_crt: "AMBER",
      green_crt: "GREEN",
      cyber_blue: "CYBER",
    };
    const disp = nameMap[pal] || pal.toUpperCase();
    if (paletteBtnLabel) paletteBtnLabel.textContent = `PAL: ${disp}`;
    if (theaterBtnPalette) theaterBtnPalette.textContent = `PAL: ${disp}`;
  }

  // ═══════════════════════════════════════════════════════════
  // RANDOM VISUALIZER CYCLE MODE
  // ═══════════════════════════════════════════════════════════

  const RANDOM_INTERVALS = [0, 15000, 30000, 60000];
  const RANDOM_LABELS = ["OFF", "15S", "30S", "60S"];
  let randomIntervalIdx = 0;
  let randomCycleTimer: any = null;

  function cycleRandomModeUI(): void {
    randomIntervalIdx = (randomIntervalIdx + 1) % RANDOM_INTERVALS.length;
    syncRandomModeUI();
  }

  function syncRandomModeUI(): void {
    if (randomCycleTimer) {
      clearInterval(randomCycleTimer);
      randomCycleTimer = null;
    }

    const intervalMs = RANDOM_INTERVALS[randomIntervalIdx];
    const label = `⚄ RND: ${RANDOM_LABELS[randomIntervalIdx]}`;

    const randomBtnLabel = document.getElementById("random-btn-label");
    const theaterBtnRandom = document.getElementById("theater-btn-random");
    const btnEngineRandom = document.getElementById("btn-engine-random");

    if (randomBtnLabel) randomBtnLabel.textContent = label;
    if (theaterBtnRandom) theaterBtnRandom.textContent = label;

    if (btnEngineRandom) {
      btnEngineRandom.classList.toggle("deck__widget-btn--active", intervalMs > 0);
    }
    if (theaterBtnRandom) {
      theaterBtnRandom.style.color = intervalMs > 0 ? "var(--color-accent-industrial, #FF1433)" : "";
    }

    if (intervalMs > 0) {
      randomCycleTimer = setInterval(() => {
        const available = VISUALIZER_ENGINES.filter((e) => e.id !== VISUALIZER_ENGINES[currentEngineIndex].id);
        const next = available[Math.floor(Math.random() * available.length)];
        if (next) {
          setModeUI(next.id);
        }
      }, intervalMs);
    }
  }

  function cycleDetailUI(): void {
    if (!visualizer) return;
    const nextDetail = visualizer.cycleDetail();
    theaterVisualizer?.setDetail(nextDetail);
    syncDetailUI(nextDetail);
  }

  function syncDetailUI(det: GeometryDetail): void {
    const detailBtnLabel = document.getElementById("detail-btn-label");
    const theaterBtnDetail = document.getElementById("theater-btn-detail");
    const disp = det.toUpperCase();
    if (detailBtnLabel) detailBtnLabel.textContent = `DET: ${disp}`;
    if (theaterBtnDetail) theaterBtnDetail.textContent = `DET: ${disp}`;
  }

  function cycleEngine(direction: 1 | -1) {
    const nextIdx = (currentEngineIndex + direction + VISUALIZER_ENGINES.length) % VISUALIZER_ENGINES.length;
    setModeUI(VISUALIZER_ENGINES[nextIdx].id);
  }

  function wireToggles() {
    // Prev / Next arrow buttons & Random cycle
    document.getElementById("btn-engine-prev")?.addEventListener("click", () => cycleEngine(-1));
    document.getElementById("btn-engine-next")?.addEventListener("click", () => cycleEngine(1));
    document.getElementById("btn-engine-random")?.addEventListener("click", cycleRandomModeUI);
    document.getElementById("theater-engine-prev")?.addEventListener("click", () => cycleEngine(-1));
    document.getElementById("theater-engine-next")?.addEventListener("click", () => cycleEngine(1));
    document.getElementById("theater-btn-random")?.addEventListener("click", cycleRandomModeUI);

    // Matrix launcher
    const modalEngines = document.getElementById("modal-engines");
    const btnOpenEngines = document.getElementById("btn-engine-menu");
    const btnTheaterOpenEngines = document.getElementById("theater-engine-menu");
    const btnCloseEngines = document.getElementById("btn-close-engines");

    const openEngineMatrix = () => {
      modalEngines?.classList.add("modal-backdrop--active");
    };

    const closeEngineMatrix = () => {
      modalEngines?.classList.remove("modal-backdrop--active");
    };

    btnOpenEngines?.addEventListener("click", openEngineMatrix);
    btnTheaterOpenEngines?.addEventListener("click", openEngineMatrix);
    btnCloseEngines?.addEventListener("click", closeEngineMatrix);

    modalEngines?.addEventListener("click", (e) => {
      if (e.target === modalEngines) closeEngineMatrix();
    });

    // Engine tiles inside matrix
    document.querySelectorAll(".engine-tile").forEach((tile: any) => {
      tile.addEventListener("click", () => {
        const engineId = tile.dataset.engine as VisualizerMode;
        if (engineId) {
          setModeUI(engineId);
          closeEngineMatrix();
        }
      });
    });

    // Global keyboard hotkeys
    window.addEventListener("keydown", (e) => {
      // Don't intercept when user is typing in an input
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

      // Direct visualizer engine selection via hotkeys (1-9, 0, E)
      const directKeyMap: Record<string, number> = {
        "1": 0, "2": 1, "3": 2, "4": 3, "5": 4, "6": 5, "7": 6, "8": 7, "9": 8, "0": 9,
        "e": 10, "E": 10,
      };
      if (directKeyMap[e.key] !== undefined) {
        e.preventDefault();
        const targetEngine = VISUALIZER_ENGINES[directKeyMap[e.key]];
        if (targetEngine) {
          setModeUI(targetEngine.id);
          closeEngineMatrix();
        }
        return;
      }

      // [ and ] for prev / next
      if (e.key === "[") {
        e.preventDefault();
        cycleEngine(-1);
      } else if (e.key === "]") {
        e.preventDefault();
        cycleEngine(1);
      } else if (e.key.toLowerCase() === "m" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        if (modalEngines?.classList.contains("modal-backdrop--active")) {
          closeEngineMatrix();
        } else {
          openEngineMatrix();
        }
      } else if ((e.key === "?" || e.key.toLowerCase() === "h") && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        const modalHotkeys = document.getElementById("modal-hotkeys");
        modalHotkeys?.classList.toggle("modal-backdrop--active");
      } else if (e.key === "Escape") {
        const theaterOverlay = document.getElementById("theater-overlay");
        if (theaterOverlay?.classList.contains("theater-overlay--active")) {
          exitTheaterMode();
        }
        closeEngineMatrix();
        document.querySelectorAll(".modal-backdrop--active").forEach((m) => m.classList.remove("modal-backdrop--active"));
      } else if (e.key.toLowerCase() === "t" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        const theaterOverlay = document.getElementById("theater-overlay");
        if (theaterOverlay?.classList.contains("theater-overlay--active")) {
          exitTheaterMode();
        } else {
          enterTheaterMode();
        }
      } else if (e.key.toLowerCase() === "i" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        audioEngine.toggleInputSource();
      } else if (e.key.toLowerCase() === "o" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        const modalRouting = document.getElementById("modal-routing");
        modalRouting?.classList.toggle("modal-backdrop--active");
        if (modalRouting?.classList.contains("modal-backdrop--active")) {
          document.getElementById("btn-route-audio")?.dispatchEvent(new Event("click"));
        }
      } else if (e.key.toLowerCase() === "c" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        cyclePaletteUI();
      } else if (e.key.toLowerCase() === "s" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        cycleRandomModeUI();
      } else if (e.key.toLowerCase() === "d" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        cycleDetailUI();
      } else if ((e.key === "+" || e.key === "=") && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        setScaleIndex(currentScaleIdx + 1);
      } else if ((e.key === "-" || e.key === "_") && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        setScaleIndex(currentScaleIdx - 1);
      } else if (e.key.toLowerCase() === "z" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        toggleCanvasMaximize();
      } else if (e.key.toLowerCase() === "r" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        resetCameraViewUI();
      } else if (e.key.toLowerCase() === "p" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        openNewPresetModal();
      } else if (e.key.toLowerCase() === "b" && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        document.getElementById("btn-chime-toggle")?.dispatchEvent(new Event("click"));
      }
    });
  }

  // ═══════════════════════════════════════════════════════════
  // SLIDER & NOISE LIVE-UPDATE (Audio Engine + WebGL Sync)
  // ═══════════════════════════════════════════════════════════

  function wireSliders() {
    const sliderN = document.getElementById("slider-n") as HTMLInputElement;
    const sliderM = document.getElementById("slider-m") as HTMLInputElement;
    const valN = document.getElementById("val-n");
    const valM = document.getElementById("val-m");
    const sliderNoise = document.getElementById("slider-noise") as HTMLInputElement;

    sliderN?.addEventListener("input", () => {
      const n = parseInt(sliderN.value, 10);
      const m = parseInt(sliderM?.value || "4", 10);
      if (valN) valN.textContent = String(n);
      visualizer?.updateUniforms({ n, m });
      theaterVisualizer?.updateUniforms({ n, m });
      audioEngine.setHarmonics(n, m);
    });

    sliderM?.addEventListener("input", () => {
      const m = parseInt(sliderM.value, 10);
      const n = parseInt(sliderN?.value || "3", 10);
      if (valM) valM.textContent = String(m);
      visualizer?.updateUniforms({ n, m });
      theaterVisualizer?.updateUniforms({ n, m });
      audioEngine.setHarmonics(n, m);
    });

    sliderNoise?.addEventListener("input", () => {
      currentNoiseRatio = parseInt(sliderNoise.value, 10) / 100.0;
      updateNoiseDisplay();
      audioEngine.setNoise(currentNoiseType, currentNoiseRatio);
    });

    // Noise type selectors ([ BROWN ], [ PINK ], [ WHITE ], [ MUTE ])
    document.querySelectorAll(".noise-type-btn").forEach((btn: any) => {
      btn.addEventListener("click", () => {
        currentNoiseType = btn.dataset.noise || "brown";
        updateNoiseDisplay();
        audioEngine.setNoise(currentNoiseType, currentNoiseRatio);
      });
    });
  }

  // ═══════════════════════════════════════════════════════════
  // RECORDING STATE (SCREEN 5) — WAV EXPORT
  // ═══════════════════════════════════════════════════════════

  function wireRecording() {
    const btnRec = document.getElementById("btn-rec");
    const canvasCard = document.getElementById("canvas-card");
    const badge = document.getElementById("rec-badge");
    const timecode = document.getElementById("rec-timecode");

    btnRec?.addEventListener("click", async () => {
      isRecording = !isRecording;

      if (isRecording) {
        btnRec.textContent = "[ RECORDING... ]";
        btnRec.classList.add("btn-rec--recording");
        canvasCard?.classList.add("deck__canvas-wrap--recording");
        badge?.classList.add("deck__rec-badge--active");

        // Start native DSP recording buffer
        await audioEngine.startRecording();

        recSeconds = 0;
        recInterval = setInterval(() => {
          recSeconds++;
          const mins = String(Math.floor(recSeconds / 60)).padStart(2, "0");
          const secs = String(recSeconds % 60).padStart(2, "0");
          const frames = String((recSeconds * 30) % 30).padStart(2, "0");
          if (timecode) {
            timecode.textContent = `REC 00:${mins}:${secs}:${frames}`;
          }
        }, 1000);
      } else {
        btnRec.textContent = "[ REC SESSION ]";
        btnRec.classList.remove("btn-rec--recording");
        canvasCard?.classList.remove("deck__canvas-wrap--recording");
        badge?.classList.remove("deck__rec-badge--active");

        if (recInterval) {
          clearInterval(recInterval);
          recInterval = null;
        }

        const defaultName = `anahat-${(currentPreset?.code || "session").toLowerCase()}-${Date.now()}.wav`;
        const savedPath = await audioEngine.stopAndSaveRecording(defaultName);
        if (savedPath) {
          console.log(`[AudioEngine] Saved session to: ${savedPath}`);
        }
      }
    });
  }

  // ═══════════════════════════════════════════════════════════
  // TRAY IPC LISTENER
  // ═══════════════════════════════════════════════════════════

  function wireTrayEvents() {
    (async () => {
      try {
        const unlistenTray = await listen<boolean>("tray-playback-changed", (event) => {
          const isPlaying = event.payload;
          if (isPlaying) {
            audioEngine.play();
          } else {
            audioEngine.pause();
          }
        });
        unlistenFns.push(unlistenTray);

        const unlistenHide = await listen("window-hidden", () => {
          isAppVisible = false;
          pauseAllVisualizers();
        });
        unlistenFns.push(unlistenHide);

        const unlistenShow = await listen("window-shown", () => {
          isAppVisible = true;
          resumeActiveVisualizer();
        });
        unlistenFns.push(unlistenShow);
      } catch (_) {}
    })();

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        isAppVisible = false;
        pauseAllVisualizers();
      } else {
        isAppVisible = true;
        resumeActiveVisualizer();
      }
    });

    window.addEventListener("beforeunload", () => {
      unlistenFns.forEach((unlisten) => {
        try { unlisten(); } catch (_) {}
      });
      unlistenFns.length = 0;
      audioEngine.disableMicIngest();
      if (recInterval) clearInterval(recInterval);
      if (sessionInterval) clearInterval(sessionInterval);
      if (randomCycleTimer) clearInterval(randomCycleTimer);
      cadenceController.destroy();
      visualizer?.dispose();
      theaterVisualizer?.dispose();
    });
  }

  // ═══════════════════════════════════════════════════════════
  // THEATER MODE (SCREEN 2) — FULLSCREEN DISPLAY
  // ═══════════════════════════════════════════════════════════

  async function enterTheaterMode() {
    const theaterOverlay = document.getElementById("theater-overlay");
    const theaterCanvasContainer = document.getElementById("theater-canvas");

    theaterOverlay?.classList.add("theater-overlay--active");

    // Suspend main deck visualizer to prevent double rendering & GPU waste
    visualizer?.pause();

    // Mount theater visualizer if not created yet
    if (!theaterVisualizer && theaterCanvasContainer) {
      theaterVisualizer = new ChladniCanvas();
      theaterVisualizer.mount(theaterCanvasContainer);
      theaterVisualizer.setClearColor(0x000000, 1.0);
      theaterVisualizer.setAudioProvider(() => audioEngine.getRealtimeAmplitude());
      theaterVisualizer.setWaveProvider((buf) => audioEngine.getWaveformData(buf));
      theaterVisualizer.setFreqProvider((buf) => audioEngine.getFrequencyData(buf));
    }

    if (theaterVisualizer && visualizer) {
      const currentMode = visualizer.getMode();
      setModeUI(currentMode);
      if (currentPreset) {
        theaterVisualizer.updateUniforms({
          n: currentPreset.harmonic_n || 3,
          m: currentPreset.harmonic_m || 4,
        });
      }
      theaterVisualizer.setPalette(visualizer.getPalette());
      theaterVisualizer.setDetail(visualizer.getDetail());
      theaterVisualizer.setThickness(visualizer.getThickness());
      theaterVisualizer.setCameraSpeed(visualizer.getCameraSpeed());
      theaterVisualizer.setCameraPreset(visualizer.getCameraPreset());
      theaterVisualizer.setVisualGain(visualizer.getVisualGain());
      theaterVisualizer.resume();
    }

    // Sync Theater HUD
    const theaterCode = document.getElementById("theater-code");
    const theaterHz = document.getElementById("theater-hz");
    const theaterPhase = document.getElementById("theater-phase");
    const hudPhaseLabel = document.getElementById("hud-phase-label");

    if (theaterCode && currentPreset) {
      theaterCode.textContent = currentPreset.code || currentPreset.id?.toUpperCase() || "PRE-001";
    }
    if (theaterHz && currentPreset) {
      theaterHz.textContent = `${Number(currentPreset.target_hz).toFixed(1)} HZ`;
    }
    if (theaterPhase) {
      theaterPhase.textContent = hudPhaseLabel?.textContent ? `CADENCE: ${hudPhaseLabel.textContent.replace("PHASE: ", "")}` : "CADENCE: IDLE";
    }

    // FILL THE VISUALISATION IN THE COMPLETE SCREEN (Native OS Fullscreen)
    try {
      await appWindow.setFullscreen(true);
    } catch (err) {
      console.warn("[Theater] Tauri setFullscreen failed, trying HTML5 Fullscreen:", err);
      try {
        if (document.documentElement.requestFullscreen) {
          await document.documentElement.requestFullscreen();
        }
      } catch (_) {}
    }
  }

  async function exitTheaterMode() {
    const theaterOverlay = document.getElementById("theater-overlay");
    theaterOverlay?.classList.remove("theater-overlay--active");
    theaterVisualizer?.pause();

    // Resume main deck visualizer if app is visible
    if (isAppVisible) {
      visualizer?.resume();
    }

    // Restore normal native window bounds
    try {
      await appWindow.setFullscreen(false);
    } catch (err) {
      console.warn("[Theater] Tauri exit fullscreen failed:", err);
      try {
        if (document.fullscreenElement && document.exitFullscreen) {
          await document.exitFullscreen();
        }
      } catch (_) {}
    }
  }

  function wireTheaterMode() {
    const btnTheater = document.getElementById("btn-theater");
    const theaterOverlay = document.getElementById("theater-overlay");
    const btnExit = document.getElementById("btn-theater-exit");

    btnTheater?.addEventListener("click", enterTheaterMode);
    btnExit?.addEventListener("click", exitTheaterMode);

    // Auto-fade theater toolbar on mouse inactivity
    let theaterFadeTimer: any = null;
    const theaterToolbar = document.getElementById("theater-toolbar");

    theaterOverlay?.addEventListener("mousemove", () => {
      theaterToolbar?.classList.remove("theater-toolbar--faded");
      if (theaterFadeTimer) clearTimeout(theaterFadeTimer);
      theaterFadeTimer = setTimeout(() => {
        theaterToolbar?.classList.add("theater-toolbar--faded");
      }, 2500);
    });
  }

