  }
</style>

<script>
  import { ChladniCanvas } from "../components/logic/ChladniCanvas";

  // ═══════════════════════════════════════════════════════════
  // STATE & VISUALIZER ENGINE
  // ═══════════════════════════════════════════════════════════

  let visualizer: ChladniCanvas | null = null;
  let theaterVisualizer: ChladniCanvas | null = null;
  let isRecording = false;
  let recSeconds = 0;
  let recInterval: any = null;

  // Initialize WebGL Visualizer
  function initVisualizer() {
    const container = document.getElementById("webgl-canvas");
    if (!container) return;

    visualizer = new ChladniCanvas();
    visualizer.mount(container);
  }

  // ═══════════════════════════════════════════════════════════
  // PRESET SELECTION HANDLERS
  // ═══════════════════════════════════════════════════════════

  function selectPreset(preset: any, clickedEl: HTMLElement) {
    // Deselect previous & highlight current
    document.querySelectorAll(".preset-item--active").forEach((el) => {
      el.classList.remove("preset-item--active");
    });
    clickedEl.classList.add("preset-item--active");

    // Scroll active item smoothly into view if needed
    clickedEl.scrollIntoView({ block: "nearest", behavior: "auto" });

    // Hz readout
    const hzEl = document.getElementById("hz-readout");
    if (hzEl) hzEl.textContent = Number(preset.target_hz).toFixed(1);

    const theaterHzEl = document.getElementById("theater-hz");
    if (theaterHzEl) theaterHzEl.textContent = `${Number(preset.target_hz).toFixed(1)} HZ`;

    // Waveform label
    const wfEl = document.getElementById("waveform-label");
    if (wfEl) {
      const wf = (preset.waveform || "sine").toUpperCase();
      wfEl.textContent = `WAVEFORM: ${wf}${wf === "BINAURAL" ? " SINE" : ""}`;
    }

    // Sliders
    const sliderN = document.getElementById("slider-n") as HTMLInputElement;
    const sliderM = document.getElementById("slider-m") as HTMLInputElement;
    if (sliderN) sliderN.value = String(preset.harmonic_n);
    if (sliderM) sliderM.value = String(preset.harmonic_m);
    const valN = document.getElementById("val-n");
    const valM = document.getElementById("val-m");
    if (valN) valN.textContent = String(preset.harmonic_n);
    if (valM) valM.textContent = String(preset.harmonic_m);

    // Update WebGL uniforms live
    visualizer?.updateUniforms({
      n: preset.harmonic_n,
      m: preset.harmonic_m,
    });
    theaterVisualizer?.updateUniforms({
      n: preset.harmonic_n,
      m: preset.harmonic_m,
    });

    // Noise label
    const noiseEl = document.getElementById("noise-label");
    if (noiseEl) {
      const pct = Math.round((preset.noise_blend_ratio || 0.3) * 100);
      const filled = Math.min(12, Math.max(0, Math.round(pct / 8.33)));
      const empty = 12 - filled;
      const noiseType = (preset.noise_masking_type || "brown").toUpperCase();
      noiseEl.textContent = `NOISE BLEND: ${noiseType} NOISE // ${"█".repeat(filled)}${"░".repeat(empty)} ${pct}%`;
    }

    // Provenance spec card fields
    const setField = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    const code = preset.code || preset.id.toUpperCase();
    const title = preset.displayName || preset.name;

    setField("spec-header-id", code);
    setField("spec-id", code);
    setField("spec-name", title);
    setField("spec-era", preset.era);
    setField("spec-target", `${Number(preset.target_hz).toFixed(2)} Hz`);
    setField("spec-chladni", `n=${preset.harmonic_n}, m=${preset.harmonic_m}`);
    setField("spec-evidence", preset.evidence_level || "Level 1A (RCT)");

    // Star rating
    const stars = Math.round(preset.evidence_rating || 5);
    setField("spec-rating", `[ ${"★".repeat(stars)}${"☆".repeat(Math.max(0, 5 - stars))} ]`);

    // Abstract & Citation
    setField(
      "spec-abstract-body",
      `${preset.therapeutic_use_case}\n\n${preset.neurological_target}`
    );
    setField("spec-citation", `CITATION: ${preset.citation || "Clinically Documented."}`);
  }

  function wirePresetClicks() {
    const items = document.querySelectorAll<HTMLButtonElement>(".preset-item");
    items.forEach((item) => {
      item.addEventListener("click", () => {
        const jsonStr = item.dataset.presetJson;
        if (!jsonStr) return;
        try {
          const preset = JSON.parse(jsonStr);
          selectPreset(preset, item);
        } catch (e) {
          console.error("Failed to parse preset JSON:", e);
        }
      });
    });
  }

  // ═══════════════════════════════════════════════════════════
  // VISUALIZER TOGGLE (CHLADNI PARTICLES <-> FARADAY FLUID)
  // ═══════════════════════════════════════════════════════════

  function wireToggles() {
    const btnParticles = document.getElementById("toggle-particles");
    const btnFluid = document.getElementById("toggle-fluid");

    btnParticles?.addEventListener("click", () => {
      visualizer?.setMode("particles");
      theaterVisualizer?.setMode("particles");

      btnParticles.textContent = "[X] CHLADNI PARTICLES";
      btnParticles.classList.add("deck__toggle--active");

      if (btnFluid) {
        btnFluid.textContent = "[ ] FARADAY FLUID";
        btnFluid.classList.remove("deck__toggle--active");
      }
    });

    btnFluid?.addEventListener("click", () => {
      visualizer?.setMode("fluid");
      theaterVisualizer?.setMode("fluid");

      btnFluid.textContent = "[X] FARADAY FLUID";
      btnFluid.classList.add("deck__toggle--active");

      if (btnParticles) {
        btnParticles.textContent = "[ ] CHLADNI PARTICLES";
        btnParticles.classList.remove("deck__toggle--active");
      }
    });
  }

  // ═══════════════════════════════════════════════════════════
  // SLIDER LIVE-UPDATE
  // ═══════════════════════════════════════════════════════════

  function wireSliders() {
    const sliderN = document.getElementById("slider-n") as HTMLInputElement;
    const sliderM = document.getElementById("slider-m") as HTMLInputElement;
    const valN = document.getElementById("val-n");
    const valM = document.getElementById("val-m");

    sliderN?.addEventListener("input", () => {
      const n = parseInt(sliderN.value, 10);
      if (valN) valN.textContent = String(n);
      visualizer?.updateUniforms({ n });
      theaterVisualizer?.updateUniforms({ n });
    });

    sliderM?.addEventListener("input", () => {
      const m = parseInt(sliderM.value, 10);
      if (valM) valM.textContent = String(m);
      visualizer?.updateUniforms({ m });
      theaterVisualizer?.updateUniforms({ m });
    });
  }

  // ═══════════════════════════════════════════════════════════
  // RECORDING STATE (SCREEN 5)
  // ═══════════════════════════════════════════════════════════

  function wireRecording() {
    const btnRec = document.getElementById("btn-rec");
    const canvasCard = document.getElementById("canvas-card");
    const badge = document.getElementById("rec-badge");
    const timecode = document.getElementById("rec-timecode");

    btnRec?.addEventListener("click", () => {
      isRecording = !isRecording;

      if (isRecording) {
        btnRec.textContent = "[ RECORDING... ]";
        btnRec.classList.add("btn-rec--recording");
        canvasCard?.classList.add("deck__canvas-wrap--recording");
        badge?.classList.add("deck__rec-badge--active");

        recSeconds = 0;
        recInterval = setInterval(() => {
          recSeconds++;
          const mins = String(Math.floor(recSeconds / 60)).padStart(2, "0");
          const secs = String(recSeconds % 60).padStart(2, "0");
          const frames = String((recSeconds * 30) % 30).padStart(2, "0");
          if (timecode) {
            timecode.textContent = `REC 00:${mins}:${secs}:${frames}`;
          }
        }, 1000);
      } else {
        btnRec.textContent = "[ REC SESSION ]";
        btnRec.classList.remove("btn-rec--recording");
        canvasCard?.classList.remove("deck__canvas-wrap--recording");
        badge?.classList.remove("deck__rec-badge--active");

        if (recInterval) {
          clearInterval(recInterval);
          recInterval = null;
        }
      }
    });
  }

  // ═══════════════════════════════════════════════════════════
  // THEATER MODE (SCREEN 2)
  // ═══════════════════════════════════════════════════════════

  function wireTheaterMode() {
    const btnTheater = document.getElementById("btn-theater");
    const theaterOverlay = document.getElementById("theater-overlay");
    const btnExit = document.getElementById("btn-theater-exit");
    const theaterCanvasContainer = document.getElementById("theater-canvas");

    btnTheater?.addEventListener("click", () => {
      theaterOverlay?.classList.add("theater-overlay--active");

      // Mount theater visualizer if not created yet
      if (!theaterVisualizer && theaterCanvasContainer) {
        theaterVisualizer = new ChladniCanvas();
        theaterVisualizer.mount(theaterCanvasContainer);
        theaterVisualizer.setClearColor(0x000000, 1.0);
      }

      if (theaterVisualizer && visualizer) {
        theaterVisualizer.setMode(visualizer.getMode());
        theaterVisualizer.resume();
      }
    });

    btnExit?.addEventListener("click", () => {
      theaterOverlay?.classList.remove("theater-overlay--active");
      theaterVisualizer?.pause();
    });
  }

  // ═══════════════════════════════════════════════════════════
  // MODALS (AUDIO ROUTING SCREEN 4 & BIOMETRIC SYNC SCREEN 6)
  // ═══════════════════════════════════════════════════════════

  function wireModals() {
    // Route Audio
    const btnRoute = document.getElementById("btn-route-audio");
    const modalRoute = document.getElementById("modal-routing");
    const btnCloseRoute = document.getElementById("btn-close-routing");
    const btnApplyRoute = document.getElementById("btn-apply-routing");

    btnRoute?.addEventListener("click", () => {
      modalRoute?.classList.add("modal-backdrop--active");
    });

    [btnCloseRoute, btnApplyRoute].forEach((el) => {
      el?.addEventListener("click", () => {
        modalRoute?.classList.remove("modal-backdrop--active");
      });
    });

    // Biometric Sync
    const btnBio = document.getElementById("btn-biometric");
    const modalBio = document.getElementById("modal-biometric");
    const btnCloseBio = document.getElementById("btn-close-bio");
    const btnDoneBio = document.getElementById("btn-done-bio");

    btnBio?.addEventListener("click", () => {
      modalBio?.classList.add("modal-backdrop--active");
    });

    [btnCloseBio, btnDoneBio].forEach((el) => {
      el?.addEventListener("click", () => {
        modalBio?.classList.remove("modal-backdrop--active");
      });
    });
  }

  // ═══════════════════════════════════════════════════════════
  // BOOT
  // ═══════════════════════════════════════════════════════════

  initVisualizer();
  wirePresetClicks();
  wireToggles();
  wireSliders();
  wireRecording();
  wireTheaterMode();
  wireModals();
</script>
