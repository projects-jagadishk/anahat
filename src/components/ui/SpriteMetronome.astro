---
/**
 * SpriteMetronome.astro
 * 1-Bit Digital Companion & Rhythmic Metronome (V1.5 Meditation)
 * 
 * Spec:
 * - 160×160px stark square with 4px border-heavy (#000000)
 * - Pure high-contrast monochrome (1-bit black & white)
 * - High-contrast black indie / grey striped tabby cat sprite
 * - GSAP-driven frame rendering synchronized to the active meditation cadence
 * - Label: COMPANION_ID: TABBY_01 in IBM Plex Mono 8px
 */
interface Props {
  id?: string;
  class?: string;
}

const { id = "sprite-metronome", class: className = "" } = Astro.props;
---

<div class={`sprite-card ${className}`} id={id}>
  <div class="sprite-canvas-box">
    <!-- Crisp 2D Canvas for pixel-perfect 60 FPS GSAP sprite animation -->
    <canvas
      id="tabby-canvas"
      class="tabby-canvas"
      width="128"
      height="128"
    ></canvas>

    <!-- Breath phase terminal indicator inside sprite box -->
    <div class="sprite-cadence-badge" id="sprite-cadence-label">
      IDLE // 0.0S
    </div>
  </div>

  <!-- Design Brief required label -->
  <div class="sprite-footer">
    <span class="sprite-id">COMPANION_ID: TABBY_01</span>
    <span class="sprite-status" id="sprite-sync-status">SYNC: 60FPS</span>
  </div>
</div>

<style>
  .sprite-card {
    width: 160px;
    height: 160px;
    background: var(--color-bg-surface-light, #FFFFFF);
    border: 4px solid var(--color-border-heavy, #000000);
    box-shadow: var(--shadow-brutalist, 6px 6px 0px 0px #000000);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    flex-shrink: 0;
  }

  .sprite-canvas-box {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0;
    background: #FFFFFF;
    overflow: hidden;
  }

  .tabby-canvas {
    width: 128px;
    height: 128px;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .sprite-cadence-badge {
    position: absolute;
    bottom: 2px;
    left: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 8px;
    font-weight: 700;
    color: var(--color-accent-industrial, #FF3333);
    letter-spacing: 0.06em;
    background: #000000;
    padding: 1px 4px;
  }

  .sprite-footer {
    height: 22px;
    min-height: 22px;
    background: var(--color-bg-surface-dark, #000000);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
    border-top: 2px solid var(--color-border-heavy, #000000);
    flex-shrink: 0;
  }

  .sprite-id {
    font-family: var(--font-mono, monospace);
    font-size: 8px;
    font-weight: 700;
    color: var(--color-bg-surface-light, #FFFFFF);
    letter-spacing: 0.05em;
  }

  .sprite-status {
    font-family: var(--font-mono, monospace);
    font-size: 7.5px;
    font-weight: 700;
    color: var(--color-accent-industrial, #FF3333);
    letter-spacing: 0.04em;
  }
</style>
