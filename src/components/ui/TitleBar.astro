---
/**
 * TitleBar.astro — Matches Figma Screen-1 titlebar exactly.
 * 1200×40, bg-surface-dark. Includes [ ROUTE AUDIO ] button.
 * Uses data-tauri-drag-region for native window dragging.
 * macOS traffic lights get 78px left padding.
 */
---

<header
  data-tauri-drag-region
  class="titlebar"
>
  <!-- macOS traffic light spacer -->
  <div class="titlebar__traffic-spacer"></div>

  <!-- Drag region label — centered per Figma -->
  <span class="titlebar__label" data-tauri-drag-region>
    [ DATA-TAURI-DRAG-REGION ] // ANAHAT ACOUSTIC DECK V1.0
  </span>

  <div class="titlebar__flex" data-tauri-drag-region></div>

  <!-- Route Audio button in titlebar -->
  <button class="titlebar__route-btn" id="btn-route-audio">
    [ ROUTE AUDIO ]
  </button>

  <!-- Window controls (Windows/Linux — hidden on macOS) -->
  <div class="titlebar__controls" id="window-controls">
    <button class="titlebar__btn" id="btn-minimize" aria-label="Minimize">—</button>
    <button class="titlebar__btn" id="btn-maximize" aria-label="Maximize">◻</button>
    <button class="titlebar__btn titlebar__btn--close" id="btn-close" aria-label="Close">✕</button>
  </div>
</header>

<style>
  .titlebar {
    display: flex;
    align-items: center;
    height: var(--titlebar-height);
    background: var(--color-bg-surface-dark);
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 0;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
  }

  .titlebar__traffic-spacer {
    width: 78px;
    flex-shrink: 0;
  }

  .titlebar__label {
    white-space: nowrap;
    letter-spacing: 0.08em;
    font-size: 11px;
    cursor: default;
  }

  .titlebar__flex {
    flex: 1;
  }

  .titlebar__route-btn {
    appearance: none;
    border: 1px solid var(--color-bg-surface-light);
    background: #1e1e1e;
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    padding: 4px 16px;
    margin-right: 12px;
    cursor: pointer;
    text-transform: uppercase;
  }

  .titlebar__route-btn:hover {
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
  }

  .titlebar__controls {
    display: flex;
    height: 100%;
  }

  .titlebar__btn {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--color-bg-surface-light);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    width: 36px;
    height: 100%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: none;
  }

  .titlebar__btn:hover {
    background: var(--color-bg-surface-light);
    color: var(--color-bg-surface-dark);
  }

  .titlebar__btn--close:hover {
    background: var(--color-accent-industrial);
    color: var(--color-bg-surface-light);
  }
</style>

<script>
  import { getCurrentWindow } from "@tauri-apps/api/window";

  const appWindow = getCurrentWindow();

  // Detect macOS — hide custom window controls (traffic lights are native)
  const isMacOS = navigator.userAgent.includes("Macintosh");
  const controlsEl = document.getElementById("window-controls");
  if (isMacOS && controlsEl) {
    controlsEl.style.display = "none";
  }

  document.getElementById("btn-minimize")?.addEventListener("click", () => {
    appWindow.minimize();
  });

  document.getElementById("btn-maximize")?.addEventListener("click", async () => {
    const isMaximized = await appWindow.isMaximized();
    if (isMaximized) {
      appWindow.unmaximize();
    } else {
      appWindow.maximize();
    }
  });

  document.getElementById("btn-close")?.addEventListener("click", () => {
    appWindow.hide();
  });
</script>
